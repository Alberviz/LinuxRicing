#!/usr/bin/env python3
"""
agent-notify: Notificador y gestor de foco contextual para agentes de IA en Hyprland / Caelestia.
Captura el espacio de trabajo, dirección de ventana Hyprland, repositorio y estado de ejecución,
registrando el estado del agente en Quickshell e IPC y enviando la notificación de escritorio enriquecida.

Estados:
  running   -> agente procesando un prompt / tarea (pulso en el pip del workspace)
  completed -> tarea finalizada, pendiente de ver (halo sólido + badge de sin ver)

Vías de disparo:
  - Hooks de Claude Code:  `agent-notify hook prompt` / `agent-notify hook stop` (leen JSON por stdin)
  - Explícito:             `agent-notify start ...` / `agent-notify finish ...`
  - Envoltorio:            `agent-notify run -n Claude -- claude`
  - Directo al terminar:   `agent-notify notify ...`  (lo usa la interceptación de Antigravity)
"""

import sys
import os
import json
import subprocess
import argparse
import time
from pathlib import Path


STATE_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "agent-notify"
AGENTS_CONFIG = Path.home() / ".config" / "caelestia" / "agents-config.json"


def get_hyprland_window(target_pid=None, agent_name="Agente"):
    """Obtiene la información de la ventana en Hyprland que aloja al agente."""
    try:
        clients_out = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True)
        if clients_out.returncode == 0 and clients_out.stdout.strip():
            clients = json.loads(clients_out.stdout)
            client_pids = {c["pid"]: c for c in clients if "pid" in c}

            # 1. Rastrear padres en /proc/<pid>/stat para target_pid y ppid
            candidate_pids = []
            if target_pid:
                try:
                    candidate_pids.append(int(target_pid))
                except (ValueError, TypeError):
                    pass
            candidate_pids.append(os.getppid())

            for start_pid in candidate_pids:
                p = start_pid
                while p > 1:
                    if p in client_pids:
                        c = client_pids[p]
                        return {
                            "address": c.get("address", ""),
                            "ws_id": c.get("workspace", {}).get("id", 1),
                            "ws_name": c.get("workspace", {}).get("name", "1"),
                            "class": c.get("class", "Terminal"),
                            "title": c.get("title", ""),
                            "pid": c.get("pid", start_pid)
                        }
                    try:
                        with open(f"/proc/{p}/stat") as f:
                            p = int(f.read().split()[3])
                    except Exception:
                        break

            # 2. Buscar procesos activos del agente si fue llamado externamente (ej. por Quickshell)
            name_lower = (agent_name or "").lower()
            terms = ["agy", "antigravity"] if any(k in name_lower for k in ["anti", "agy", "gemini"]) else ["claude"] if "claude" in name_lower else []
            matches = []
            for term in terms:
                try:
                    pids = subprocess.check_output(["pgrep", "-f", term], text=True).split()
                    for p_str in pids:
                        pid = int(p_str)
                        curr = pid
                        while curr > 1:
                            if curr in client_pids:
                                c = client_pids[curr]
                                try:
                                    mtime = os.stat(f"/proc/{pid}").st_mtime
                                except Exception:
                                    mtime = 0
                                matches.append((mtime, pid, c))
                                break
                            try:
                                with open(f"/proc/{curr}/stat") as f:
                                    curr = int(f.read().split()[3])
                            except Exception:
                                break
                except Exception:
                    pass

            if matches:
                matches.sort(key=lambda x: x[0], reverse=True)
                chosen = matches[0][2]
                return {
                    "address": chosen.get("address", ""),
                    "ws_id": chosen.get("workspace", {}).get("id", 1),
                    "ws_name": chosen.get("workspace", {}).get("name", "1"),
                    "class": chosen.get("class", "Terminal"),
                    "title": chosen.get("title", ""),
                    "pid": chosen.get("pid", matches[0][1])
                }

            # 3. Buscar en títulos de ventanas de clientes en hyprctl
            for c in clients:
                title = (c.get("title") or "").lower()
                if terms and any(term in title for term in terms):
                    return {
                        "address": c.get("address", ""),
                        "ws_id": c.get("workspace", {}).get("id", 1),
                        "ws_name": c.get("workspace", {}).get("name", "1"),
                        "class": c.get("class", "Terminal"),
                        "title": c.get("title", ""),
                        "pid": c.get("pid", 0)
                    }

        # 4. Fallback: activewindow
        res = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True)
        if res.returncode == 0 and res.stdout.strip():
            data = json.loads(res.stdout)
            if data and isinstance(data, dict) and data.get("address"):
                return {
                    "address": data.get("address", ""),
                    "ws_id": data.get("workspace", {}).get("id", 1),
                    "ws_name": data.get("workspace", {}).get("name", "1"),
                    "class": data.get("class", "Terminal"),
                    "title": data.get("title", ""),
                    "pid": data.get("pid", 0)
                }
    except Exception:
        pass
    return {
        "address": "",
        "ws_id": 1,
        "ws_name": "1",
        "class": "Terminal",
        "title": "Terminal",
        "pid": os.getppid()
    }


def get_project_name(target_pid=None, cwd=None):
    """Obtiene el nombre del repositorio git o directorio del agente."""
    if not cwd and target_pid:
        try:
            cwd = os.readlink(f"/proc/{int(target_pid)}/cwd")
        except Exception:
            pass
    if not cwd:
        cwd = os.getcwd()
    try:
        res = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=cwd, capture_output=True, text=True)
        if res.returncode == 0 and res.stdout.strip():
            return Path(res.stdout.strip()).name
    except Exception:
        pass
    return Path(cwd).name


def _norm_addr(addr):
    if not addr:
        return ""
    s = str(addr).lower()
    return s[2:] if s.startswith("0x") else s


def _state_file(address):
    return STATE_DIR / f"{_norm_addr(address) or 'unknown'}.json"


def quickshell_ipc(method, agent_data):
    """Envía una llamada IPC al servicio de agentes de Caelestia Quickshell."""
    try:
        subprocess.run(
            ["qs", "-c", "caelestia", "ipc", "call", "agents", method, json.dumps(agent_data)],
            capture_output=True,
            text=True,
            timeout=2
        )
    except Exception:
        pass


def send_desktop_notification(agent_data):
    """Envía notificación de escritorio rica mediante notify-send."""
    name = agent_data.get("name", "Agente")
    dir_name = agent_data.get("dir", "")
    ws = agent_data.get("ws", 1)
    status = agent_data.get("status", "Completado")
    task = agent_data.get("task", "")
    address = agent_data.get("address", "")
    duration = agent_data.get("duration", "")

    title = f"🤖 {name} ({dir_name})" if dir_name else f"🤖 {name}"

    body_parts = [task] if task and task != status else [f"Estado: {status}"]
    if duration:
        body_parts.append(f"Duración: {duration}")
    body_parts.append(f"Workspace {ws} • Clic para enfocar")
    body = " • ".join(body_parts)

    cmd = [
        "notify-send",
        "-a", "caelestia-agents",
        "-u", "normal",
        "-t", "6000",
        "-i", "utilities-terminal",
    ]
    if address:
        cmd.extend(["-h", f"string:address:{address}"])
    if ws:
        cmd.extend(["-h", f"int:ws:{ws}"])

    cmd.extend([title, body])

    try:
        subprocess.run(cmd, capture_output=True, timeout=2)
    except Exception:
        pass


def build_agent_data(name="Agente", status="Completado", task=None, duration="",
                     address="", ws=1, terminal="Terminal", target_pid=None, cwd=None,
                     start_time=None):
    """Construye el diccionario de datos del agente según el contrato de datos."""
    return {
        "id": f"agent-{int(time.time() * 1000)}",
        "name": name,
        "task": task if task else status,
        "status": status,
        "address": address,
        "ws": ws,
        "dir": get_project_name(target_pid, cwd),
        "duration": duration,
        "terminal": terminal,
        "startTime": start_time,
    }


def start_agent(name="Claude", task=None, target_pid=None, cwd=None):
    """Marca un agente como en ejecución (pulso en el pip)."""
    win = get_hyprland_window(target_pid=target_pid, agent_name=name)
    address = win["address"]
    ws = win["ws_id"]
    now = int(time.time() * 1000)

    data = build_agent_data(name=name, status="running", task=task or "Trabajando…",
                            address=address, ws=ws, terminal=win["class"],
                            target_pid=target_pid, cwd=cwd, start_time=now)
    data["status"] = "running"

    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        _state_file(address).write_text(json.dumps({
            "startTime": now, "task": data["task"], "name": name
        }))
    except Exception:
        pass

    quickshell_ipc("start", data)
    print(f"✓ En curso: {name} en Workspace {ws} ({data['dir']})")


def finish_agent(name="Claude", task=None, status="Completado", target_pid=None, cwd=None):
    """Marca un agente como finalizado (halo sólido + badge + toast)."""
    win = get_hyprland_window(target_pid=target_pid, agent_name=name)
    address = win["address"]
    ws = win["ws_id"]

    start_info = {}
    try:
        f = _state_file(address)
        if f.exists():
            start_info = json.loads(f.read_text())
            f.unlink()
    except Exception:
        pass

    duration = ""
    if start_info.get("startTime"):
        elapsed = max(0, int(time.time() * 1000) - int(start_info["startTime"])) // 1000
        mins, secs = divmod(elapsed, 60)
        duration = f"{mins}m {secs}s" if mins > 0 else f"{secs}s"

    task = task or start_info.get("task") or status

    data = build_agent_data(name=name, status=status, task=task, duration=duration,
                            address=address, ws=ws, terminal=win["class"],
                            target_pid=target_pid, cwd=cwd)

    quickshell_ipc("complete", data)
    send_desktop_notification(data)
    print(f"✓ Finalizado: {name} en Workspace {ws} ({data['dir']}{', ' + duration if duration else ''})")


def notify_agent(name="Agente", status="Completado", task=None, duration="",
                 custom_address=None, custom_ws=None, target_pid=None):
    """Registra y notifica la finalización de un agente (compat: interceptación de Antigravity)."""
    win = get_hyprland_window(target_pid=target_pid, agent_name=name)
    address = custom_address if custom_address else win["address"]
    ws = custom_ws if custom_ws is not None else win["ws_id"]

    agent_data = build_agent_data(name=name, status=status, task=task, duration=duration,
                                  address=address, ws=ws, terminal=win["class"], target_pid=target_pid)

    quickshell_ipc("notify", agent_data)
    send_desktop_notification(agent_data)

    print(f"✓ Notificación enviada: {name} en Workspace {ws} ({agent_data['dir']})")


def run_wrapped_command(cmd_args, name=None, task=None):
    """Ejecuta un comando emitiendo `start` al arrancar y `complete` al terminar."""
    if not name:
        name = Path(cmd_args[0]).name.capitalize()

    start_agent(name=name, task=task or f"Ejecutando {Path(cmd_args[0]).name}")

    try:
        ret = subprocess.run(cmd_args)
        status = "Completado" if ret.returncode == 0 else f"Error ({ret.returncode})"
        finish_agent(name=name, task=task, status=status)
        sys.exit(ret.returncode)
    except KeyboardInterrupt:
        finish_agent(name=name, task=task, status="Cancelado")
        sys.exit(130)


def cmd_hook(event):
    """Punto de entrada para los hooks de Claude Code (JSON por stdin)."""
    raw = ""
    try:
        if not sys.stdin.isatty():
            raw = sys.stdin.read()
    except Exception:
        pass
    try:
        hook = json.loads(raw) if raw.strip() else {}
    except Exception:
        hook = {}

    cwd = hook.get("cwd") or None

    if event == "prompt":
        prompt = (hook.get("prompt") or "").strip().replace("\n", " ")
        if len(prompt) > 80:
            prompt = prompt[:79] + "…"
        start_agent(name="Claude", task=prompt or "Procesando prompt", cwd=cwd)
    elif event == "stop":
        finish_agent(name="Claude", cwd=cwd)


def set_config(key, value):
    """Escribe una clave en ~/.config/caelestia/agents-config.json."""
    cfg = {}
    try:
        cfg = json.loads(AGENTS_CONFIG.read_text())
    except Exception:
        pass
    cfg[key] = value
    try:
        AGENTS_CONFIG.parent.mkdir(parents=True, exist_ok=True)
        AGENTS_CONFIG.write_text(json.dumps(cfg, indent=2) + "\n")
        print(f"✓ {key} = {value}")
    except Exception as e:
        print(f"Error al escribir config: {e}", file=sys.stderr)
        sys.exit(1)


def build_parser():
    """Construye el parser de argumentos de línea de comandos."""
    parser = argparse.ArgumentParser(description="Agent Notification & Focus Manager for Caelestia")
    parser.add_argument("--name", "-n", default="Agente", help="Nombre del agente")
    parser.add_argument("--status", "-s", default="Completado", help="Estado de la tarea")
    parser.add_argument("--task", "-t", default=None, help="Descripción de la tarea")
    parser.add_argument("--duration", "-d", default="", help="Duración de la tarea")
    parser.add_argument("--address", "-a", default=None, help="Dirección de ventana Hyprland")
    parser.add_argument("--ws", "-w", default=None, type=int, help="ID de Workspace")
    parser.add_argument("--pid", "-p", default=None, type=int, help="PID del proceso del agente")

    sub = parser.add_subparsers(dest="subcommand")

    rp = sub.add_parser("run", help="Ejecutar un agente y notificar inicio y fin")
    rp.add_argument("--name", "-n", help="Nombre descriptivo del agente (ej. Antigravity, Claude)")
    rp.add_argument("--task", "-t", default=None, help="Descripción de la tarea")
    rp.add_argument("command", nargs=argparse.REMAINDER, help="Comando a ejecutar con sus argumentos")

    sp = sub.add_parser("start", help="Marcar un agente como en ejecución (pulso)")
    sp.add_argument("--name", "-n", default="Claude")
    sp.add_argument("--task", "-t", default=None)
    sp.add_argument("--pid", "-p", default=None, type=int)

    fp = sub.add_parser("finish", help="Marcar un agente como finalizado (halo + toast)")
    fp.add_argument("--name", "-n", default="Claude")
    fp.add_argument("--task", "-t", default=None)
    fp.add_argument("--status", "-s", default="Completado")
    fp.add_argument("--pid", "-p", default=None, type=int)

    hp = sub.add_parser("hook", help="Punto de entrada para hooks de Claude Code (stdin JSON)")
    hp.add_argument("event", choices=["prompt", "stop"])

    npx = sub.add_parser("notify", help="Enviar notificación directa de agente finalizado")
    npx.add_argument("--name", "-n", default="Agente")
    npx.add_argument("--status", "-s", default="Completado")
    npx.add_argument("--task", "-t", default=None)
    npx.add_argument("--duration", "-d", default="")
    npx.add_argument("--address", "-a", default=None)
    npx.add_argument("--ws", "-w", default=None, type=int)
    npx.add_argument("--pid", "-p", default=None, type=int)

    stp = sub.add_parser("style", help="Estilo de la animación 'en curso'")
    stp.add_argument("value", choices=["blink", "breathe", "arc"])

    mkp = sub.add_parser("marker", help="Estilo del marcador de 'sin ver'")
    mkp.add_argument("value", choices=["badge", "wedge"])

    sndp = sub.add_parser("sound", help="Activar/desactivar los sonidos de notificación")
    sndp.add_argument("value", choices=["on", "off"])

    sub.add_parser("test", help="Probar notificación de agente")
    sub.add_parser("clear", help="Limpiar todos los estados de agentes")

    return parser


def main():
    parser = build_parser()
    args, unknown = parser.parse_known_args()

    if args.subcommand == "run":
        cmd = args.command
        if cmd and cmd[0] == "--":
            cmd = cmd[1:]
        if not cmd and unknown:
            cmd = unknown
        if not cmd:
            print("uso: agent-notify run [-n NOMBRE] [-t TAREA] -- <comando...>", file=sys.stderr)
            sys.exit(1)
        run_wrapped_command(cmd, name=args.name, task=args.task)

    elif args.subcommand == "start":
        start_agent(name=args.name, task=args.task, target_pid=args.pid)

    elif args.subcommand == "finish":
        finish_agent(name=args.name, task=args.task, status=args.status, target_pid=args.pid)

    elif args.subcommand == "hook":
        cmd_hook(args.event)

    elif args.subcommand == "style":
        set_config("runningStyle", args.value)

    elif args.subcommand == "marker":
        set_config("unseenMarker", args.value)

    elif args.subcommand == "sound":
        set_config("soundEnabled", args.value == "on")

    elif args.subcommand == "test":
        start_agent(name="Antigravity", task="Prueba de agente en curso")
        time.sleep(2)
        finish_agent(name="Antigravity", task="Prueba de notificación de agente")

    elif args.subcommand == "clear":
        try:
            subprocess.run(["qs", "-c", "caelestia", "ipc", "call", "agents", "clearAll"], check=True)
            print("✓ Estados de agentes limpiados.")
        except Exception as e:
            print(f"Error al limpiar: {e}")

    elif args.subcommand == "notify":
        notify_agent(name=args.name, status=args.status, task=args.task, duration=args.duration,
                     custom_address=args.address, custom_ws=args.ws, target_pid=args.pid)

    else:
        notify_agent(
            name=args.name,
            status=args.status,
            task=args.task,
            duration=args.duration,
            custom_address=args.address,
            custom_ws=args.ws,
            target_pid=args.pid
        )


if __name__ == "__main__":
    main()

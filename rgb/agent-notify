#!/usr/bin/env python3
"""
agent-notify: Notificador y gestor de foco contextual para agentes de IA en Hyprland / Caelestia.
Captura el espacio de trabajo, dirección de ventana Hyprland, repositorio y estado de ejecución,
registrando la píldora interactiva en Quickshell y enviando la notificación de escritorio enriquecida.
"""

import sys
import os
import json
import subprocess
import argparse
import time
from pathlib import Path


def get_hyprland_window():
    """Obtiene la información de la ventana activa en Hyprland."""
    try:
        res = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True, check=True)
        data = json.loads(res.stdout)
        if data and isinstance(data, dict):
            return {
                "address": data.get("address", ""),
                "ws_id": data.get("workspace", {}).get("id", 1),
                "ws_name": data.get("workspace", {}).get("name", "1"),
                "class": data.get("class", "Terminal"),
                "title": data.get("title", ""),
                "pid": data.get("pid", 0)
            }
    except Exception:
        pass
    return {
        "address": "",
        "ws_id": 1,
        "ws_name": "1",
        "class": "Terminal",
        "title": "Terminal",
        "pid": os.getppid()
    }


def get_project_name():
    """Obtiene el nombre del repositorio git o directorio actual."""
    try:
        res = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
        if res.returncode == 0 and res.stdout.strip():
            return Path(res.stdout.strip()).name
    except Exception:
        pass
    return Path(os.getcwd()).name


def send_quickshell_ipc(agent_data):
    """Envía la información del agente a Caelestia Quickshell vía IPC."""
    try:
        payload = json.dumps(agent_data)
        subprocess.run(
            ["qs", "-c", "caelestia", "ipc", "call", "agents", "notify", payload],
            capture_output=True,
            text=True,
            timeout=2
        )
    except Exception:
        pass


def send_desktop_notification(agent_data):
    """Envía notificación de escritorio rica mediante notify-send."""
    name = agent_data.get("name", "Agente")
    dir_name = agent_data.get("dir", "")
    ws = agent_data.get("ws", 1)
    status = agent_data.get("status", "Completado")
    address = agent_data.get("address", "")
    duration = agent_data.get("duration", "")

    title = f"🤖 {name} ({dir_name})" if dir_name else f"🤖 {name}"
    
    body_parts = [f"Estado: {status}"]
    if duration:
        body_parts.append(f"Duración: {duration}")
    body_parts.append(f"Workspace {ws} • Clic para enfocar")
    body = " • ".join(body_parts)

    cmd = [
        "notify-send",
        "-a", "caelestia-agents",
        "-u", "normal",
        "-i", "smart_toy",
    ]
    if address:
        cmd.extend(["-h", f"string:address:{address}"])
    
    cmd.extend([title, body])

    try:
        subprocess.run(cmd, capture_output=True, timeout=2)
    except Exception:
        pass


def notify_agent(name="Agente", status="Completado", duration="", custom_address=None, custom_ws=None):
    """Registra y notifica la finalización de un agente."""
    win = get_hyprland_window()
    address = custom_address if custom_address else win["address"]
    ws = custom_ws if custom_ws else win["ws_id"]
    dir_name = get_project_name()

    agent_data = {
        "id": f"agent-{int(time.time()*1000)}",
        "name": name,
        "status": status,
        "address": address,
        "ws": ws,
        "dir": dir_name,
        "duration": duration,
        "terminal": win["class"]
    }

    # 1. Registrar en Quickshell (píldora interactiva en la barra)
    send_quickshell_ipc(agent_data)

    # 2. Notificación de escritorio
    send_desktop_notification(agent_data)

    print(f"✓ Notificación enviada: {name} en Workspace {ws} ({dir_name})")


def run_wrapped_command(cmd_args, name=None):
    """Ejecuta un comando capturando la ventana de inicio y notificando al terminar."""
    if not name:
        name = Path(cmd_args[0]).name.capitalize()
    
    win = get_hyprland_window()
    start_time = time.time()
    
    try:
        ret = subprocess.run(cmd_args)
        elapsed = time.time() - start_time
        mins, secs = divmod(int(elapsed), 60)
        dur_str = f"{mins}m {secs}s" if mins > 0 else f"{secs}s"
        status = "Completado" if ret.returncode == 0 else f"Error ({ret.returncode})"
        notify_agent(name=name, status=status, duration=dur_str, custom_address=win["address"], custom_ws=win["ws_id"])
        sys.exit(ret.returncode)
    except KeyboardInterrupt:
        sys.exit(130)


def main():
    parser = argparse.ArgumentParser(description="Agent Notification & Focus Manager for Caelestia")
    subparsers = parser.add_subparsers(dest="subcommand")

    # run subcommand
    run_parser = subparsers.add_parser("run", help="Ejecutar un agente y notificar al finalizar")
    run_parser.add_argument("--name", "-n", help="Nombre descriptivo del agente (ej. Antigravity, Claude)")
    run_parser.add_argument("command", nargs=argparse.REMAINDER, help="Comando a ejecutar con sus argumentos")

    # notify subcommand
    notify_parser = subparsers.add_parser("notify", help="Enviar notificación directa de agente finalizado")
    notify_parser.add_argument("--name", "-n", default="Agente", help="Nombre del agente")
    notify_parser.add_argument("--status", "-s", default="Completado", help="Estado de la tarea")
    notify_parser.add_argument("--duration", "-d", default="", help="Duración de la tarea")
    notify_parser.add_argument("--address", "-a", default=None, help="Dirección de ventana Hyprland")
    notify_parser.add_argument("--ws", "-w", default=None, type=int, help="ID de Workspace")

    # test subcommand
    subparsers.add_parser("test", help="Probar notificación y píldora de agente")

    # clear subcommand
    subparsers.add_parser("clear", help="Limpiar todas las píldoras de agentes")

    args = parser.parse_args()

    if args.subcommand == "run":
        if not args.command:
            run_parser.print_help()
            sys.exit(1)
        # Quitar separador '--' si existe
        cmd = args.command
        if cmd and cmd[0] == "--":
            cmd = cmd[1:]
        run_wrapped_command(cmd, name=args.name)

    elif args.subcommand == "notify":
        notify_agent(
            name=args.name,
            status=args.status,
            duration=args.duration,
            custom_address=args.address,
            custom_ws=args.ws
        )

    elif args.subcommand == "test":
        notify_agent(name="Antigravity", status="Tarea completada con éxito", duration="1m 30s")

    elif args.subcommand == "clear":
        try:
            subprocess.run(["qs", "-c", "caelestia", "ipc", "call", "agents", "clearAll"], check=True)
            print("✓ Píldoras de agentes limpiadas.")
        except Exception as e:
            print(f"Error al limpiar: {e}")

    else:
        # Default: notificar estado actual
        notify_agent(name="Agente", status="Completado")


if __name__ == "__main__":
    main()

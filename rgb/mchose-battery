#!/usr/bin/env python3
"""
MCHOSE Wireless Peripherals Battery Monitor for Linux (sólo telemetría)

Supports:
  - MCHOSE V9 Pro Wireless Headset (C-Media CM2025 DSP, VID: 0x291D, PID: 0x385D)
  - MCHOSE K7 Ultra Wireless Mouse (RealTek SoC, VID: 0x3837, PID: 0x1001)
  - Akko Multi-modes Keyboard (ROYUAN B-Series, VID: 0x3151, PID: 0x4015/0x4011)

Features:
  - Comunicación hidraw nativa sin dependencias
  - Salida de tabla legible en terminal
  - Salida JSON estructurada para Quickshell / Caelestia (--json)
  - Salida Waybar para auriculares y ratón (--waybar-headset / --waybar-mouse)

La lógica batería->iluminación y las notificaciones de escritorio viven ahora
en el motor `rgb/battery-lighting`; este script sólo reporta estado.
"""

import sys
import os
import fcntl
import glob
import time
import select
import json
import argparse
import subprocess

CACHE_FILE = os.path.expanduser("~/.cache/mchose_battery.json")
DAEMON_LOG = os.path.expanduser("~/.cache/battery_lighting.log")
CACHE_FRESH_SECS = 90     # el caché se considera reciente si se escribió hace < 90 s
DAEMON_FRESH_SECS = 120   # el daemon se considera activo si su log tocó hace < 120 s

def HIDIOCSFEATURE(size):
    return (3 << 30) | (size << 16) | (ord("H") << 8) | 0x06

def HIDIOCGFEATURE(size):
    return (3 << 30) | (size << 16) | (ord("H") << 8) | 0x07

def load_cache():
    try:
        if os.path.exists(CACHE_FILE):
            with open(CACHE_FILE, "r") as f:
                return json.load(f)
    except Exception:
        pass
    return {}

def save_cache(data):
    try:
        os.makedirs(os.path.dirname(CACHE_FILE), exist_ok=True)
        with open(CACHE_FILE, "w") as f:
            json.dump(data, f)
    except Exception:
        pass

def _daemon_is_active():
    """True si el motor battery-lighting tocó su log hace menos de DAEMON_FRESH_SECS."""
    try:
        return (time.time() - os.path.getmtime(DAEMON_LOG)) < DAEMON_FRESH_SECS
    except Exception:
        return False

def fresh_cache_reading(prefix):
    """Si el caché es reciente (< CACHE_FRESH_SECS), devuelve (nivel, estado)
    leídos de ~/.cache/mchose_battery.json (escrito por el motor). Si no, None,
    y el llamante hace la lectura HID directa."""
    try:
        if (time.time() - os.path.getmtime(CACHE_FILE)) >= CACHE_FRESH_SECS:
            return None
    except Exception:
        return None
    cache = load_cache()
    bat = cache.get(f"{prefix}_battery")
    st = cache.get(f"{prefix}_status")
    if bat is None or not st:
        return None
    return bat, st

def glob_hidraw_nodes(target_vid, target_pid, iface=None):
    matched = []
    for h in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        uevent = f"{h}/device/uevent"
        if os.path.exists(uevent):
            try:
                with open(uevent, "r") as f:
                    content = f.read()
                for line in content.splitlines():
                    if line.startswith("HID_ID="):
                        parts = line.split("=")[1].split(":")
                        if len(parts) >= 3:
                            vid = int(parts[1], 16)
                            pid = int(parts[2], 16)
                            if vid == target_vid and pid == target_pid:
                                nodename = "/dev/" + os.path.basename(h)
                                if iface is not None:
                                    link = os.path.realpath(f"{h}/device")
                                    if f":1.{iface}" in link:
                                        matched.append(nodename)
                                else:
                                    matched.append(nodename)
            except Exception:
                pass
    return matched

# ==============================================================================
# 1. MCHOSE V9 PRO HEADSET
# ==============================================================================
def get_v9_pro_battery():
    fresh = fresh_cache_reading("v9")
    if fresh is not None:
        return fresh

    cache = load_cache()
    last_bat = cache.get("v9_battery")
    last_status = cache.get("v9_status", "Descargando")

    nodes = glob_hidraw_nodes(0x291D, 0x385D)
    if not nodes:
        return None, "Desconectado"

    for node in nodes:
        try:
            fd = os.open(node, os.O_RDWR | os.O_NONBLOCK)
            pkt = bytes([0x55, 0x65, 0x01] + [0x00] * 61)
            os.write(fd, pkt)
            r, _, _ = select.select([fd], [], [], 0.2)
            if r:
                resp = os.read(fd, 64)
                os.close(fd)
                if resp and len(resp) >= 4 and resp[0] == 0x55 and resp[1] == 0x65:
                    bat = resp[2]
                    st_code = resp[3]
                    if st_code == 3 or st_code == 0:
                        st = "Cargando"
                    elif st_code == 2:
                        st = "Descargando"
                    else:
                        st = "Descargando"
                    cache["v9_battery"] = bat
                    cache["v9_status"] = st
                    save_cache(cache)
                    return bat, st
            else:
                os.close(fd)
        except Exception:
            pass

    if last_bat:
        return last_bat, "En reposo"
    return None, "Sin respuesta"

def get_k7_ultra_battery():
    fresh = fresh_cache_reading("k7")
    if fresh is not None:
        return fresh

    cache = load_cache()
    last_bat = cache.get("k7_battery")
    last_status = cache.get("k7_status", "Descargando")

    nodes = glob_hidraw_nodes(0x3837, 0x1001, iface=2) or glob_hidraw_nodes(0x3837, 0x1001)
    if not nodes:
        return None, "Desconectado"

    for node in nodes:
        try:
            fd = os.open(node, os.O_RDWR | os.O_NONBLOCK)

            for attempt in range(4):
                req = bytearray([0x11, 0x06 ^ 0xFF] + [0xFF] * 19)
                try:
                    fcntl.ioctl(fd, HIDIOCSFEATURE(len(req)), req)
                except Exception:
                    pass
                time.sleep(0.025)

                # Check for incoming pushed report 0x13
                r, _, _ = select.select([fd], [], [], 0.02)
                if r:
                    d = os.read(fd, 64)
                    if len(d) >= 6 and d[0] == 0x13:
                        dec13 = [d[0]] + [b ^ 0xFF for b in d[1:]]
                        if (dec13[1] == 0xE2 or d[1] == 0x1D) and 0 < dec13[5] <= 100:
                            bat = dec13[5]
                            is_charging = (dec13[3] == 2 or dec13[4] == 1)
                            st = "Cargando" if is_charging else "Descargando"
                            os.close(fd)
                            cache["k7_battery"] = bat
                            cache["k7_status"] = st
                            save_cache(cache)
                            return bat, st

                # Read Feature Report 0x11 response
                buf = bytearray([0x11] + [0] * 63)
                try:
                    fcntl.ioctl(fd, HIDIOCGFEATURE(len(buf)), buf)
                    dec = [buf[0]] + [b ^ 0xFF for b in buf[1:]]
                    if len(dec) >= 13 and dec[0] == 0x11 and dec[1] == 0x06:
                        vid = dec[2] | (dec[3] << 8)
                        if vid == 0x3837:
                            bat = dec[11]
                            charge_st = dec[12]
                            if 0 < bat <= 100:
                                is_charging = (charge_st == 1)
                                st = "Cargando" if is_charging else "Descargando"
                                os.close(fd)
                                cache["k7_battery"] = bat
                                cache["k7_status"] = st
                                save_cache(cache)
                                return bat, st
                except Exception:
                    pass

            os.close(fd)
        except Exception:
            pass

    if last_bat:
        return last_bat, "En reposo"
    return None, "Sin respuesta"

# ==============================================================================
# 3. AKKO MULTI-MODES KEYBOARD (ROYUAN B-Series VID: 0x3151, PID: 0x4015/0x4011)
# ==============================================================================
def get_akko_keyboard_battery():
    fresh = fresh_cache_reading("akko")
    if fresh is not None:
        return fresh

    cache = load_cache()
    last_bat = cache.get("akko_battery", 100)

    # 1. Check if connected via Wired USB (PID 0x4015) - Direct VBUS USB Power / Charging
    wired_nodes = glob_hidraw_nodes(0x3151, 0x4015, iface=2) or glob_hidraw_nodes(0x3151, 0x4015)
    if wired_nodes:
        for node in wired_nodes:
            try:
                fd = os.open(node, os.O_RDWR | os.O_NONBLOCK)
                req = bytearray(64)
                req[0] = 0x83  # FEA_CMD_GET_BATTERY
                req[8] = 0xFF - (sum(req[:8]) & 0xFF)
                raw = bytearray([0x00]) + req
                fcntl.ioctl(fd, HIDIOCSFEATURE(len(raw)), raw)
                time.sleep(0.02)
                resp = bytearray(65)
                fcntl.ioctl(fd, HIDIOCGFEATURE(len(resp)), resp)
                os.close(fd)
                if len(resp) >= 4 and resp[1] == 0x83:
                    st_code = resp[3]
                    st = "Cargando" if st_code == 1 else "Conectado (USB)"
                    bat = resp[2] if (0 < resp[2] <= 100) else 100
                    cache["akko_battery"] = bat
                    save_cache(cache)
                    return bat, st
            except Exception:
                pass
        return 100, "Cargando (USB)"

    # 2. Check if connected via Bluetooth / UPower (Real BLE Battery GATT Telemetry)
    try:
        res = subprocess.run(["upower", "-e"], capture_output=True, text=True, timeout=1)
        for line in res.stdout.splitlines():
            if "keyboard" in line.lower() or "akko" in line.lower():
                info = subprocess.run(["upower", "-i", line], capture_output=True, text=True, timeout=1).stdout
                pct = None
                state = "Descargando"
                for iline in info.splitlines():
                    if "percentage:" in iline:
                        pct = int(iline.split(":")[1].strip().replace("%", ""))
                    elif "state:" in iline:
                        if "charging" in iline:
                            state = "Cargando"
                if pct is not None:
                    cache["akko_battery"] = pct
                    save_cache(cache)
                    return pct, state
    except Exception:
        pass

    # 3. Check if connected via 2.4 GHz Dongle (PID 0x4011)
    dongle_nodes = glob_hidraw_nodes(0x3151, 0x4011, iface=2) or glob_hidraw_nodes(0x3151, 0x4011)
    if dongle_nodes:
        for node in dongle_nodes:
            try:
                fd = os.open(node, os.O_RDWR | os.O_NONBLOCK)
                # Step 1: Send 0x83 request to trigger keyboard battery report
                req83 = bytearray(64)
                req83[0] = 0x83
                req83[7] = 0x7C
                fcntl.ioctl(fd, HIDIOCSFEATURE(65), bytearray([0x00]) + req83)
                
                # Step 2: Poll with 0xF7 until RF packet ready (or max 8 attempts)
                for _ in range(8):
                    time.sleep(0.03)
                    reqF7 = bytearray(64)
                    reqF7[0] = 0xF7
                    fcntl.ioctl(fd, HIDIOCSFEATURE(65), bytearray([0x00]) + reqF7)
                    time.sleep(0.02)
                    respF7 = bytearray(65)
                    fcntl.ioctl(fd, HIDIOCGFEATURE(65), respF7)
                    
                    if respF7[1] == 0x01 or respF7[1] == 0x83:
                        # Step 3: Fetch cached 0x83 response with 0xFC
                        reqFC = bytearray(64)
                        reqFC[0] = 0xFC
                        fcntl.ioctl(fd, HIDIOCSFEATURE(65), bytearray([0x00]) + reqFC)
                        time.sleep(0.02)
                        resp83 = bytearray(65)
                        fcntl.ioctl(fd, HIDIOCGFEATURE(65), resp83)
                        if resp83[1] == 0x83 and 0 < resp83[2] <= 100:
                            raw_bat = resp83[2]
                            st_code = resp83[3]
                            is_chg = (st_code == 1)
                            st = "Cargando" if is_chg else "Descargando"

                            last_st = cache.get("akko_status")
                            last_disp = cache.get("akko_battery")
                            last_ema = cache.get("akko_battery_ema")

                            if last_st != st or last_disp is None or last_ema is None:
                                ema = float(raw_bat)
                                displayed = raw_bat
                            else:
                                if abs(raw_bat - float(last_ema)) <= 15:
                                    ema = 0.8 * float(last_ema) + 0.2 * float(raw_bat)
                                else:
                                    ema = float(last_ema)
                                cand = int(round(ema))
                                if is_chg:
                                    displayed = max(int(last_disp), cand)
                                else:
                                    displayed = min(int(last_disp), cand)

                            displayed = max(1, min(100, displayed))
                            os.close(fd)
                            cache["akko_battery"] = displayed
                            cache["akko_battery_raw"] = raw_bat
                            cache["akko_battery_ema"] = round(ema, 2)
                            cache["akko_status"] = st
                            save_cache(cache)
                            return displayed, st
                os.close(fd)
            except Exception:
                pass
        return last_bat, cache.get("akko_status", "Descargando")

    return None, "Desconectado"

# ==============================================================================
# MAIN / CLI
# ==============================================================================
def main():
    parser = argparse.ArgumentParser(description="MCHOSE Wireless Peripherals Battery Monitor (sólo telemetría)")
    parser.add_argument("--json", action="store_true", help="Output state in JSON format")
    parser.add_argument("--waybar-headset", action="store_true", help="Waybar JSON for V9 Pro")
    parser.add_argument("--waybar-mouse", action="store_true", help="Waybar JSON for K7 Ultra")
    args = parser.parse_args()

    v9_bat, v9_st = get_v9_pro_battery()
    k7_bat, k7_st = get_k7_ultra_battery()
    akko_bat, akko_st = get_akko_keyboard_battery()

    if args.waybar_headset:
        if v9_bat is not None:
            is_charging = (v9_st == "Cargando")
            icon = "󰂄" if is_charging else "󰋋"
            css_class = "charging" if is_charging else ("low" if v9_bat <= 20 else "discharging")
            print(json.dumps({
                "text": f"{icon} {v9_bat}%",
                "alt": f"{v9_bat}%",
                "tooltip": f"🎧 MCHOSE V9 Pro: {v9_bat}% ({v9_st})",
                "percentage": v9_bat,
                "class": css_class
            }))
        else:
            print(json.dumps({"text": "", "tooltip": f"MCHOSE V9 Pro: {v9_st}", "class": "disconnected"}))
        return

    if args.waybar_mouse:
        if k7_bat is not None:
            is_charging = (k7_st == "Cargando")
            icon = "󰂄" if is_charging else "󰍽"
            css_class = "charging" if is_charging else ("low" if k7_bat <= 20 else "discharging")
            print(json.dumps({
                "text": f"{icon} {k7_bat}%",
                "alt": f"{k7_bat}%",
                "tooltip": f"🐭 MCHOSE K7 Ultra: {k7_bat}% ({k7_st})",
                "percentage": k7_bat,
                "class": css_class
            }))
        else:
            print(json.dumps({"text": "", "tooltip": f"MCHOSE K7 Ultra: {k7_st}", "class": "disconnected"}))
        return

    if args.json:
        data = {
            "headset": {
                "name": "MCHOSE V9 Pro",
                "battery": v9_bat,
                "status": v9_st,
                "mode": "2.4G Inalámbrico" if (v9_bat is not None and v9_st != "Desconectado") else "Desconectado",
                "charging": (v9_st == "Cargando"),
                "connected": (v9_bat is not None and v9_st != "Desconectado")
            },
            "mouse": {
                "name": "MCHOSE K7 Ultra",
                "battery": k7_bat,
                "status": k7_st,
                "mode": "2.4G Inalámbrico" if (k7_bat is not None and k7_st != "Desconectado") else "Desconectado",
                "charging": (k7_st == "Cargando"),
                "connected": (k7_bat is not None and k7_st != "Desconectado")
            },
            "keyboard": {
                "name": "Akko 5075B",
                "battery": akko_bat,
                "status": akko_st,
                "mode": "Cable USB" if "usb" in akko_st.lower() else ("Bluetooth" if "bluetooth" in akko_st.lower() else ("2.4G Inalámbrico" if (akko_bat is not None and akko_st != "Desconectado") else "Desconectado")),
                "charging": (akko_st == "Cargando" or "cargando (usb)" in akko_st.lower()),
                "connected": (akko_bat is not None and akko_st != "Desconectado")
            }
        }
        print(json.dumps(data, indent=2))
        return

    # CLI human-readable formatting
    print("┌──────────────────────────────────────────────┐")
    print("│        MCHOSE WIRELESS DEVICE STATUS         │")
    print("├──────────────────────────────────────────────┤")
    if v9_bat is not None:
        print(f"│  🎧 Auriculares V9 Pro : {v9_bat:>3}%  [{v9_st:<12}] │")
    else:
        print(f"│  🎧 Auriculares V9 Pro : ⚠️  {v9_st:<17} │")

    if k7_bat is not None:
        print(f"│  🐭 Ratón K7 Ultra     : {k7_bat:>3}%  [{k7_st:<12}] │")
    else:
        print(f"│  🐭 Ratón K7 Ultra     : ⚠️  {k7_st:<17} │")

    if akko_bat is not None:
        print(f"│  ⌨️  Teclado Akko 5075B : {akko_bat:>3}%  [{akko_st:<12}] │")
    else:
        print(f"│  ⌨️  Teclado Akko 5075B : ⚠️  {akko_st:<17} │")
    print("└──────────────────────────────────────────────┘")

if __name__ == "__main__":
    main()

def _hidraw_nodes(vid, pids):
    nodes = []
    for h in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        uevent = f"{h}/device/uevent"
        if not os.path.exists(uevent):
            continue
        try:
            with open(uevent) as f:
                content = f.read()
            if vid in content and any(p in content for p in pids):
                link = os.path.realpath(f"{h}/device")
                if ":1.2" in link:
                    nodes.append("/dev/" + os.path.basename(h))
        except Exception:
            pass
    return nodes


def _write_feature(node, raw):
    try:
        fd = os.open(node, os.O_RDWR | os.O_NONBLOCK)
        fcntl.ioctl(fd, HIDIOCSFEATURE(len(raw)), raw)
        os.close(fd)
    except Exception:
        pass


def _akko_checksum8(buf):
    return 0xFF - (sum(buf[:8]) & 0xFF)


# animación -> byte[2] del payload 0x2B del anillo de la base MCHOSE
_MCHOSE_ANIM_BYTE = {"solid": 0x06, "breathing": 0x02, "wave": 0x07,
                     "hardware_battery": 0x01}


def build_mchose_base_payload(effect, level, theme_rgb):
    """21 bytes listos para ioctl (Report ID 0x11 + XOR 0xFF en byte[1..20]).

    Portado de apply_charging_lighting / apply_low_battery_lighting de
    rgb/mchose-battery. `effect` = string antiguo o dict {animation,colour,...}.
    Devuelve None para `off`.
    """
    if effect == "none":
        return None
    effect = normalize_effect(effect)
    anim = effect["animation"]
    mb = _MCHOSE_ANIM_BYTE.get(anim)
    if mb is None:
        return None                       # off / animación no soportada por el anillo
    src = effect["colour"]["source"]
    if src == "fixed":
        h = effect["colour"].get("hex") or "d8bde7"
        r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
    elif src == "battery":
        r, g, b = battery_level_color(level)
    else:
        r, g, b = theme_rgb
    if anim == "wave":
        r, g, b = 255, 59, 0              # el wave del firmware ignora el color
    payload = [0x2B, 0x01, mb, 0x00, 100, 0x00, 0x01, 0x01, 0x00,
               r, g, b, r, g, b, 0, 0, 0, 0, 0]
    return bytes(bytearray([0x11] + [x ^ 0xFF for x in payload]))



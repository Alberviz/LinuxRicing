VALID_SOURCES = {"akko_keyboard", "mchose_mouse", "v9_headset"}
VALID_TRIGGERS = {"charging", "low", "critical"}
VALID_TARGETS = {"akko_keyboard", "mchose_base", "magichome", "openrgb"}
VALID_ZONES = {"keys", "sidestrip", "both"}


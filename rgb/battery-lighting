def _boost_for_leds(r, g, b):
    h, s, v = colorsys.rgb_to_hsv(r / 255.0, g / 255.0, b / 255.0)
    if s > 0.05:
        s2 = min(1.0, max(0.80, s * 3.5))
        nr, ng, nb = colorsys.hsv_to_rgb(h, s2, 1.0)
        return int(nr * 255), int(ng * 255), int(nb * 255)
    return r, g, b


def theme_primary_rgb():
    """Color primario activo de Matugen (~/.local/state/caelestia/scheme.json).

    Portado de get_theme_primary_rgb de rgb/mchose-battery con boost de saturación para LEDs.
    """
    scheme_file = os.path.expanduser("~/.local/state/caelestia/scheme.json")
    if os.path.exists(scheme_file):
        try:
            with open(scheme_file, "r") as f:
                data = json.load(f)
            hex_c = data.get("colours", {}).get("primary",
                                                data.get("primary", "#ff9800")).lstrip("#")
            r, g, b = int(hex_c[0:2], 16), int(hex_c[2:4], 16), int(hex_c[4:6], 16)
            return _boost_for_leds(r, g, b)
        except Exception:
            pass
    return 255, 152, 0



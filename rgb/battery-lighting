# Aplicadores de efectos (Task 7) — constructores de payload para la base
# MCHOSE y las zonas del teclado Akko (teclas / tira lateral). El medidor de
# batería del Akko (efecto `battery_meter`) lo añade la Task 8; MagicHome y
# OpenRGB, la Task 9. Helpers HID copiados de rgb/rgb-notify-flash a propósito.
# ============================================================================

def _hidraw_nodes(vid, pids):
    nodes = []
    for h in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        uevent = f"{h}/device/uevent"
        if not os.path.exists(uevent):
            continue
        try:
            with open(uevent) as f:
                content = f.read()
            if vid in content and any(p in content for p in pids):
                link = os.path.realpath(f"{h}/device")
                if ":1.2" in link:
                    nodes.append("/dev/" + os.path.basename(h))
        except Exception:
            pass
    return nodes


def _write_feature(node, raw):
    try:
        fd = os.open(node, os.O_RDWR | os.O_NONBLOCK)
        fcntl.ioctl(fd, HIDIOCSFEATURE(len(raw)), raw)
        os.close(fd)
    except Exception:
        pass


def _akko_checksum8(buf):
    return 0xFF - (sum(buf[:8]) & 0xFF)


def build_mchose_base_payload(effect, level, theme_rgb):
    """21 bytes listos para ioctl (Report ID 0x11 + XOR 0xFF en byte[1..20]).

    Portado de apply_charging_lighting / apply_low_battery_lighting de
    rgb/mchose-battery. Devuelve None para `none`/`off`.
    """
    if effect in ("none", "off"):
        return None
    th_r, th_g, th_b = theme_rgb
    bat_r, bat_g, bat_b = battery_level_color(level)
    if effect == "theme_breathing":
        payload = [0x2B, 0x01, 0x02, 0x00, 100, 0x00, 0x01, 0x01, 0x00,
                   th_r, th_g, th_b, th_r, th_g, th_b, 0, 0, 0, 0, 0]
    elif effect == "battery_color":
        payload = [0x2B, 0x01, 0x02, 0x00, 100, 0x00, 0x01, 0x01, 0x00,
                   bat_r, bat_g, bat_b, bat_r, bat_g, bat_b, 0, 0, 0, 0, 0]
    elif effect == "hardware_battery":
        payload = [0x2B, 0x01, 0x01, 0x00, 100, 0x00, 0x01, 0x01, 0x00,
                   bat_r, bat_g, bat_b, bat_r, bat_g, bat_b, 0, 0, 0, 0, 0]
    elif effect == "wave":
        payload = [0x2B, 0x01, 0x07, 0x00, 100, 0x00, 0x01, 0x01, 0x00,
                   255, 59, 0, 255, 59, 0, 0, 0, 0, 0, 0]
    elif effect == "red_breathing":
        payload = [0x2B, 0x01, 0x02, 0x00, 100, 0x00, 0x01, 0x01, 0x00,
                   255, 0, 0, 255, 0, 0, 0, 0, 0, 0, 0]
    elif effect == "red_static":
        payload = [0x2B, 0x01, 0x06, 0x00, 100, 0x00, 0x01, 0x01, 0x00,
                   255, 0, 0, 255, 0, 0, 0, 0, 0, 0, 0]
    else:
        return None
    return bytes(bytearray([0x11] + [x ^ 0xFF for x in payload]))


# efecto -> (modo byte[1], velocidad byte[2], origen de color)
_AKKO_EFFECTS = {
    "theme":             (0x01, 0x04, "theme"),
    "solid_theme":       (0x01, 0x04, "theme"),
    "red_static":        (0x01, 0x04, "red"),
    "red_breathing":     (0x02, 0x02, "red"),
    "breathing":         (0x02, 0x02, "theme"),
    "breathing_battery": (0x02, 0x02, "battery"),
    "stream":            (0x05, 0x00, "battery"),
    "stream_battery":    (0x05, 0x00, "battery"),
}

_AKKO_ZONE_OPCODES = {"keys": (0x07,), "sidestrip": (0x08,), "both": (0x07, 0x08)}

AKKO_FLAGS_CUSTOM_RGB = 0x08


def _akko_packet(opcode, effect, level, theme_rgb):
    spec = _AKKO_EFFECTS.get(effect)
    if spec is None:
        return None
    mode, speed, ckind = spec
    if ckind == "red":
        r, g, b = 255, 0, 0
    elif ckind == "battery":
        r, g, b = battery_level_color(level)
    else:
        r, g, b = theme_rgb
    buf = bytearray(64)
    buf[0] = opcode
    buf[1] = mode
    buf[2] = speed
    buf[3] = 0x04                    # brillo
    buf[4] = AKKO_FLAGS_CUSTOM_RGB   # flags custom RGB
    buf[5], buf[6], buf[7] = r, g, b
    buf[8] = _akko_checksum8(buf)
    return bytes(bytearray([0x00]) + buf)


def build_akko_packets(zone, effect, level, theme_rgb):
    """Lista de buffers de 65 bytes (0x00 + 64) para el teclado Akko.

    Portado de sync_akko_keyboard de rgb/sync-rgb.py. `battery_meter` en la
    zona `keys` lo maneja la Task 8; aquí cubre
    theme|solid_theme|breathing|breathing_battery|stream|stream_battery|
    red_breathing|red_static|none.
    """
    if effect == "none":
        return []
    out = []
    for op in _AKKO_ZONE_OPCODES.get(zone, (0x07,)):
        pkt = _akko_packet(op, effect, level, theme_rgb)
        if pkt is not None:
            out.append(pkt)
    return out


# --- Akko per-key battery meter (Task 8) -----------------------------------
def _akko_nodes():
    """Nodos hidraw del teclado Akko: cable (3151:4015) preferido, si no el
    dongle 2.4G (3151:4011), siempre en la interfaz :1.2. El enlace inalámbrico
    pierde paquetes y congela el backlight en blanco, así que se usa el cable
    cuando existe. Portado de sync_akko_keyboard de rgb/sync-rgb.py.
    """
    usb_nodes, wl_nodes = [], []
    for h in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        uevent = f"{h}/device/uevent"
        if not os.path.exists(uevent):
            continue
        try:
            with open(uevent) as f:
                content = f.read()
        except Exception:
            continue
        if "3151" not in content:
            continue
        if ":1.2" not in os.path.realpath(f"{h}/device"):
            continue
        node = "/dev/" + os.path.basename(h)
        if "4015" in content:
            usb_nodes.append(node)
        elif "4011" in content:
            wl_nodes.append(node)
    return usb_nodes or wl_nodes


def _load_state():
    try:
        with open(STATE_CACHE) as f:
            return json.load(f)
    except Exception:
        return {}


def _save_state(st):
    try:
        with open(STATE_CACHE, "w") as f:
            json.dump(st, f)
    except Exception:
        pass


def apply_akko_meter(level):
    """Pinta el medidor de batería sobre las teclas del Akko (modo lienzo).

    Envía 1 paquete lateral 0x08 para despertar el bus, 1 paquete de activación
    0x07 (modo 0x0D con Checksum Bit8) y los 7 chunks 0x0C (con Checksum Bit7),
    con time.sleep(0.03) entre escrituras. No hace nada si no hay nodo, o si el
    nivel redondeado a fila (meter_rows) no cambió desde la última vez (STATE_CACHE).
    """
    nodes = _akko_nodes()
    if not nodes:
        return
    rows = meter_rows(level, len(AKKO_KEY_ROWS))
    st = _load_state()
    if st.get("akko_meter_level") == rows:
        return

    # 1. Paquete lateral 0x08 para despertar el transceptor
    sled = bytearray(64)
    sled[0] = 0x08
    sled[1] = 0x01
    sled[2] = 4
    sled[3] = 4
    sled[4] = 0x08
    sled[5], sled[6], sled[7] = battery_level_color(level)
    sled[8] = _akko_checksum8(sled)
    raw_sled = bytes([0x00]) + bytes(sled)

    # 2. Paquete activación 0x07 (modo 0x0D)
    activate = bytearray(64)
    activate[0] = 0x07
    activate[1] = 0x0D          # MODE_USER_PICTURE (13)
    activate[2] = 0x01          # speed
    activate[3] = 0x04          # brightness
    activate[4] = 0x00          # flags (option << 4)
    activate[5] = 0x00
    activate[6] = 200
    activate[7] = 200
    activate[8] = _akko_checksum8(activate)
    raw_activate = bytes([0x00]) + bytes(activate)

    chunks = [bytes([0x00]) + c for c in akko_canvas_chunks(akko_meter_keys(level))]
    packets = [raw_sled, raw_activate] + chunks
    node = nodes[0]
    for pkt in packets:
        _write_feature(node, bytearray(pkt))
        time.sleep(0.03)
    st["akko_meter_level"] = rows
    _save_state(st)


def _effect_rgb(effect, level, theme_rgb):
    if effect in ("battery_color",):
        return battery_level_color(level)
    if effect in ("solid_theme",):
        return tuple(theme_rgb)
    if effect == "red":
        return (255, 0, 0)
    return None


def apply_magichome(effect, level, theme_rgb):
    rgb = _effect_rgb(effect, level, theme_rgb)
    if rgb is None:
        return
    hexs = "%02x%02x%02x" % rgb
    try:
        subprocess.run([MAGICHOME_CONTROL, "--color", hexs], timeout=6,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as e:
        log(f"magichome: {e}")


def apply_openrgb(effect, level, theme_rgb):
    if effect == "none":
        return
    if effect == "battery_meter":
        log("openrgb battery_meter -> sólido por nivel (relleno animado es v2)")  # TODO v2: integrar con argb-wave.py
        rgb = battery_level_color(level)
    else:
        rgb = _effect_rgb(effect, level, theme_rgb) or tuple(theme_rgb)
    try:
        from openrgb import OpenRGBClient
        from openrgb.utils import RGBColor
        client = OpenRGBClient()
        for dev in client.devices:
            name_l = dev.name.lower()
            if "akko" in name_l or "royuan" in name_l:
                continue
            try:
                dev.set_mode(0)
                dev.set_color(RGBColor(*rgb))
            except Exception:
                pass
    except Exception as e:
        log(f"openrgb: {e}")


_DEVICE_OF_ZONE = {"akko_keyboard": "akko_keyboard", "mchose_base": "mchose_base",
                   "magichome": "magichome", "openrgb": "openrgb"}


def apply_zone(zonekey, action, theme_rgb):
    target, zone = zonekey.split(":")
    if action is None:
        subprocess.run([sys.executable, SYNC_RGB, "--only", _DEVICE_OF_ZONE[target]],
                       timeout=10, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    eff, level = action["effect"], action.get("level")
    if target == "mchose_base":
        raw = build_mchose_base_payload(eff, level, theme_rgb)
        if raw:
            for n in _hidraw_nodes("3837", ("1001",)):
                _write_feature(n, raw)
    elif target == "akko_keyboard":
        if zone == "keys" and eff == "battery_meter":
            apply_akko_meter(level)
            return
        for pkt in build_akko_packets(zone, eff, level, theme_rgb):
            for n in _akko_nodes():
                _write_feature(n, pkt)
    elif target == "magichome":
        apply_magichome(eff, level, theme_rgb)
    elif target == "openrgb":
        apply_openrgb(eff, level, theme_rgb)



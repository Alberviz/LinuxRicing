    "red_static":        {"animation": "solid", "colour": {"source": "fixed", "hex": "ff0000"}},
    "red_breathing":     {"animation": "breathing", "colour": {"source": "fixed", "hex": "ff0000"}},
    "red":               {"animation": "solid", "colour": {"source": "fixed", "hex": "ff0000"}},
    "none":              {"animation": "off", "colour": {"source": "theme"}},
    "off":               {"animation": "off", "colour": {"source": "theme"}},
}

DEFAULT_EFFECT = {"animation": "solid", "colour": {"source": "theme", "hex": "d8bde7"},
                  "speed": 3, "direction": "right"}

_AKKO_ZONE_OPCODES = {"keys": (0x07,), "sidestrip": (0x08,), "both": (0x07, 0x08)}
AKKO_FLAGS_CUSTOM_RGB = 0x08


def normalize_effect(eff):
    """Acepta un string antiguo o un dict; devuelve un dict de efecto completo."""
    if isinstance(eff, str):
        eff = EFFECT_ALIASES.get(eff, {"animation": "off"})
    if not isinstance(eff, dict):
        return dict(DEFAULT_EFFECT)
    out = dict(DEFAULT_EFFECT)
    for k in ("animation", "speed", "direction"):
        if k in eff:
            out[k] = eff[k]
    c = eff.get("colour") or {}
    out["colour"] = {"source": c.get("source", "theme"),
                     "hex": (c.get("hex") or "d8bde7").lstrip("#").lower()}
    if out["colour"]["source"] not in ("theme", "fixed", "battery"):
        out["colour"]["source"] = "theme"
    try:
        out["speed"] = max(1, min(5, int(out["speed"])))
    except (TypeError, ValueError):
        out["speed"] = 3
    if out["direction"] not in _DIR_IDX:
        out["direction"] = "right"
    if out["animation"] not in AKKO_ANIM_BYTE and out["animation"] != "hardware_battery":
        out["animation"] = "off"
    return out


def _effect_uses_battery_colour(eff):
    """True si el efecto (string antiguo o dict) toma el color del nivel de batería."""
    if eff is None:
        return False
    if isinstance(eff, str):
        eff = EFFECT_ALIASES.get(eff, {})
    return isinstance(eff, dict) and (eff.get("colour") or {}).get("source") == "battery"


def _akko_colour_rgb(effect, level, theme_rgb):
    src = effect["colour"]["source"]
    if src == "fixed":
        h = (effect["colour"].get("hex") or "d8bde7")
        return (int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16))
    if src == "battery":
        return battery_level_color(level)
    return tuple(theme_rgb)


def _akko_speed_byte(ui_speed, opcode):
    ui_speed = max(1, min(5, int(ui_speed)))
    # teclas (0x07): el firmware invierte; tira (0x08): directa. 1 = lento, 5 = rápido.
    return (5 - ui_speed) if opcode == 0x07 else (ui_speed - 1)


def _akko_flag_byte(effect):
    if effect["animation"] in AKKO_DIRECTIONAL:
        return AKKO_FLAGS_CUSTOM_RGB | (_DIR_IDX.get(effect["direction"], 0) << 4)
    return AKKO_FLAGS_CUSTOM_RGB


def _akko_packet(opcode, effect, level, theme_rgb):
    anim = effect["animation"]
    mode = 0 if anim == "off" else AKKO_ANIM_BYTE.get(anim)
    if mode is None:
        return None
    r, g, b = _akko_colour_rgb(effect, level, theme_rgb)
    buf = bytearray(64)
    buf[0] = opcode
    buf[1] = mode
    buf[2] = _akko_speed_byte(effect["speed"], opcode)
    buf[3] = 0x04                    # brillo
    buf[4] = _akko_flag_byte(effect)
    buf[5], buf[6], buf[7] = r, g, b
    buf[8] = _akko_checksum8(buf)
    return bytes(bytearray([0x00]) + buf)


def build_akko_packets(zone, effect, level, theme_rgb):
    """Lista de buffers de 65 bytes (0x00 + 64) para el teclado Akko.
    `effect` puede ser un string antiguo o un dict {animation,colour,speed,direction}.
    El string "none" significa "no tocar" (lista vacía); {animation:"off"} apaga.
    """
    if effect == "none":
        return []
    effect = normalize_effect(effect)
    out = []
    for op in _AKKO_ZONE_OPCODES.get(zone, (0x07,)):
        eff = effect
        if op == 0x08 and effect["animation"] not in AKKO_SIDESTRIP_ANIMS:
            eff = dict(effect, animation="solid")   # la tira no tiene esa animación
        pkt = _akko_packet(op, eff, level, theme_rgb)
        if pkt is not None:
            out.append(pkt)
    return out


# --- Akko: nodos hidraw ---------------------------------------------------
def _akko_nodes():
    """Nodos hidraw del teclado Akko: cable (3151:4015) preferido, si no el
    dongle 2.4G (3151:4011), siempre en la interfaz :1.2. Portado de
    sync_akko_keyboard de rgb/sync-rgb.py.
    """
    usb_nodes, wl_nodes = [], []
    for h in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        uevent = f"{h}/device/uevent"
        if not os.path.exists(uevent):
            continue
        try:
            with open(uevent) as f:
                content = f.read()
        except Exception:
            continue
        if "3151" not in content:
            continue
        if ":1.2" not in os.path.realpath(f"{h}/device"):
            continue
        node = "/dev/" + os.path.basename(h)
        if "4015" in content:
            usb_nodes.append(node)
        elif "4011" in content:
            wl_nodes.append(node)
    return usb_nodes or wl_nodes



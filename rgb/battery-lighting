_NOTIFY_DEVICES = [
    ("Auriculares MCHOSE V9 Pro", "audio-headset", "v9_headset", "v9"),
    ("Ratón MCHOSE K7 Ultra", "input-mouse", "mchose_mouse", "k7"),
    ("Teclado Akko 5075B", "input-keyboard", "akko_keyboard", "akko"),
]


def _notify(config, telemetry):
    """Notificaciones de escritorio con dedupe por nivel.

    Portado de check_and_notify de rgb/mchose-battery: crítico <=
    critical_threshold, bajo <= 20, dedupe vía notified_levels en la caché de
    batería. Ignora dispositivos que están cargando.
    """
    ct = config.get("critical_threshold", 10)
    cache = read_battery_cache()
    notified = cache.get("notified_levels", {}) or {}

    for name, icon, src, key in _NOTIFY_DEVICES:
        t = telemetry.get(src, {})
        bat = t.get("level")
        charging = t.get("charging", False)
        if bat is not None and not charging:
            last_warn = notified.get(key, 100)
            if bat <= ct and last_warn > ct:
                send_notification(
                    f"⚠️ Batería Crítica: {name}",
                    f"La batería está al {bat}%. Conecta el cargador inmediatamente.",
                    icon, urgency="critical")
                notified[key] = ct
            elif bat <= 20 and last_warn > 20:
                send_notification(
                    f"\U0001f50b Batería Baja: {name}",
                    f"Nivel actual: {bat}%. Considera cargarlo pronto.",
                    icon, urgency="normal")
                notified[key] = 20
            elif bat > 20:
                notified[key] = 100
        elif charging:
            notified[key] = 100

    cache["notified_levels"] = notified
    try:
        os.makedirs(os.path.dirname(BATTERY_CACHE), exist_ok=True)
        with open(BATTERY_CACHE, "w") as f:
            json.dump(cache, f)
    except Exception as e:
        log(f"_notify cache: {e}")


def _check_battery_mode_refreshes(telemetry, active_alert_zones):
    """If a device profile in rgb-config.json has a dynamic battery mode and is not in active alert, refresh when level changes."""
    rgb_cfg_path = os.path.expanduser("~/.config/caelestia/rgb-config.json")
    if not os.path.exists(rgb_cfg_path):
        return
    try:
        with open(rgb_cfg_path) as f:
            rgb_cfg = json.load(f)
    except Exception:
        return

    profiles = rgb_cfg.get("device_profiles", {})
    st = _load_state()
    last_levels = st.get("last_profile_levels", {})
    cur_levels = {}
    dirty_devices = set()

    def _prof_eff(prof, *ks):
        for k in ks:
            if k in prof:
                return prof[k]
        return None

    # Akko (perfil nuevo {keys,sidestrip} o antiguo {keys_mode,sidestrip_mode})
    akko_prof = profiles.get("akko_keyboard", {})
    akko_effs = [_prof_eff(akko_prof, "keys", "keys_mode"),
                 _prof_eff(akko_prof, "sidestrip", "sidestrip_mode")]
    akko_lvl = telemetry.get("akko_keyboard", {}).get("level")
    cur_levels["akko"] = akko_lvl
    if akko_lvl is not None and akko_lvl != last_levels.get("akko"):
        if any(_effect_uses_battery_colour(e) for e in akko_effs):
            if not ("akko_keyboard:keys" in active_alert_zones and "akko_keyboard:sidestrip" in active_alert_zones):
                dirty_devices.add("akko_keyboard")

    # Mchose base (perfil nuevo {ring} o antiguo {mode})
    base_prof = profiles.get("mchose_base", {})
    base_eff = _prof_eff(base_prof, "ring", "mode")
    mouse_lvl = telemetry.get("mchose_mouse", {}).get("level")
    cur_levels["mouse"] = mouse_lvl
    if mouse_lvl is not None and mouse_lvl != last_levels.get("mouse"):
        if _effect_uses_battery_colour(base_eff):
            if "mchose_base:_" not in active_alert_zones:
                dirty_devices.add("mchose_base")

    st["last_profile_levels"] = cur_levels
    _save_state(st)

    for dev in dirty_devices:
        subprocess.run([sys.executable, SYNC_RGB, "--only", dev],
                       timeout=8, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# Mientras un dispositivo carga, un efecto cuyo color sale del nivel de batería
# hay que repintarlo cuando el nivel cruza un escalón para que el gradiente
# rojo->verde avance. Cada repintado es 1 paquete de firmware (no congela el
# teclado; el lienzo per-key que sí lo hacía ya se retiró).


def _battery_step(level):
    if level is None:
        return None
    return max(0, min(10, int(level) // 10))


def tick(config=None, telemetry=None):
    config = config or load_config()
    telemetry = telemetry or read_telemetry()
    write_battery_cache(telemetry)
    theme = theme_primary_rgb()
    new = resolve(config, telemetry)
    old = read_alerts()

    st = _load_state()
    steps = dict(st.get("charging_colour_step", {}))

    for zk, payload in new.items():
        prev = old.get(zk)
        changed = (not prev or prev.get("effect") != payload["effect"]
                   or prev.get("trigger") != payload["trigger"])
        batt_charge = (payload.get("trigger") == "charging"
                       and _effect_uses_battery_colour(payload.get("effect")))
        step = _battery_step(payload.get("level")) if batt_charge else None
        if batt_charge and steps.get(zk) != step:
            changed = True
        if changed:
            apply_zone(zk, payload, theme)
        if batt_charge:
            steps[zk] = step
        else:
            steps.pop(zk, None)
    for zk in old:
        if zk not in new:
            apply_zone(zk, None, theme)
            steps.pop(zk, None)

    st["charging_colour_step"] = steps
    _save_state(st)

    write_alerts(new)
    _notify(config, telemetry)
    _check_battery_mode_refreshes(telemetry, set(new.keys()))
    return new


def _daemon_loop():
    last_secs = None
    last_alerts = None
    while True:
        charging = False
        try:
            new = tick()
            if last_alerts is None or new != last_alerts:
                print(f"[battery-lighting] alertas activas: {list(new)}", flush=True)
                last_alerts = copy.deepcopy(new)
            charging = any(v.get("trigger") == "charging" for v in new.values())
        except Exception as e:
            log(f"tick error: {e}")
        cfg = load_config()
        secs = cfg["poll"]["charging_seconds"] if charging else cfg["poll"]["idle_seconds"]
        if last_secs != secs:
            print(f"[battery-lighting] cadencia -> {secs}s (charging={charging})", flush=True)
            last_secs = secs
        time.sleep(secs)


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(USAGE)
        return 0
    cmd = argv[0]
    if cmd == "--tick":
        tick()
        return 0
    if cmd == "--clear":
        theme = theme_primary_rgb()
        for zk in read_alerts():
            apply_zone(zk, None, theme)
        write_alerts({})
        return 0
    if cmd == "--dump":
        print(json.dumps({"telemetry": read_telemetry(),
                          "alerts": resolve(load_config(), read_telemetry())}, indent=2))
        return 0
    if cmd == "--apply" and len(argv) > 1:
        cfg = load_config()
        rule = next((r for r in cfg["rules"] if r["id"] == argv[1]), None)
        if not rule:
            print(f"regla desconocida: {argv[1]}")
            return 1
        theme = theme_primary_rgb()
        for a in rule["actions"]:
            for zk in _zone_keys(a):
                apply_zone(zk, {"effect": a["effect"], "trigger": rule["trigger"],
                                "source": rule["source"], "level": 50, "force": True}, theme)
        return 0
    if cmd == "--daemon":
        return _daemon_loop()
    print(USAGE)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

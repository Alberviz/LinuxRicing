def send_notification(title, message, icon, urgency="normal"):
    """Copiado de send_notification de rgb/mchose-battery."""
    try:
        subprocess.run([
            "notify-send",
            "-a", "MCHOSE Battery",
            "-u", urgency,
            "-i", icon,
            title,
            message,
        ], check=False)
    except Exception:
        pass


_NOTIFY_DEVICES = [
    ("Auriculares MCHOSE V9 Pro", "audio-headset", "v9_headset", "v9"),
    ("Ratón MCHOSE K7 Ultra", "input-mouse", "mchose_mouse", "k7"),
    ("Teclado Akko 5075B", "input-keyboard", "akko_keyboard", "akko"),
]


def _notify(config, telemetry):
    """Notificaciones de escritorio con dedupe por nivel.

    Portado de check_and_notify de rgb/mchose-battery: crítico <=
    critical_threshold, bajo <= 20, dedupe vía notified_levels en la caché de
    batería. Ignora dispositivos que están cargando.
    """
    ct = config.get("critical_threshold", 10)
    cache = read_battery_cache()
    notified = cache.get("notified_levels", {}) or {}

    for name, icon, src, key in _NOTIFY_DEVICES:
        t = telemetry.get(src, {})
        bat = t.get("level")
        charging = t.get("charging", False)
        if bat is not None and not charging:
            last_warn = notified.get(key, 100)
            if bat <= ct and last_warn > ct:
                send_notification(
                    f"⚠️ Batería Crítica: {name}",
                    f"La batería está al {bat}%. Conecta el cargador inmediatamente.",
                    icon, urgency="critical")
                notified[key] = ct
            elif bat <= 20 and last_warn > 20:
                send_notification(
                    f"\U0001f50b Batería Baja: {name}",
                    f"Nivel actual: {bat}%. Considera cargarlo pronto.",
                    icon, urgency="normal")
                notified[key] = 20
            elif bat > 20:
                notified[key] = 100
        elif charging:
            notified[key] = 100

    cache["notified_levels"] = notified
    try:
        os.makedirs(os.path.dirname(BATTERY_CACHE), exist_ok=True)
        with open(BATTERY_CACHE, "w") as f:
            json.dump(cache, f)
    except Exception as e:
        log(f"_notify cache: {e}")


def tick(config=None, telemetry=None):
    config = config or load_config()
    telemetry = telemetry or read_telemetry()
    write_battery_cache(telemetry)
    theme = theme_primary_rgb()
    new = resolve(config, telemetry)
    old = read_alerts()

    for zk, payload in new.items():
        prev = old.get(zk)
        if (not prev or prev.get("effect") != payload["effect"]
                or prev.get("trigger") != payload["trigger"]):
            apply_zone(zk, payload, theme)
    for zk in old:
        if zk not in new:
            apply_zone(zk, None, theme)

    write_alerts(new)
    _notify(config, telemetry)
    return new


def _daemon_loop():
    last_secs = None
    last_alerts = None
    while True:
        charging = False
        try:
            new = tick()
            if last_alerts is None or new != last_alerts:
                print(f"[battery-lighting] alertas activas: {list(new)}", flush=True)
                last_alerts = copy.deepcopy(new)
            charging = any(v.get("trigger") == "charging" for v in new.values())
        except Exception as e:
            log(f"tick error: {e}")
        cfg = load_config()
        secs = cfg["poll"]["charging_seconds"] if charging else cfg["poll"]["idle_seconds"]
        if last_secs != secs:
            print(f"[battery-lighting] cadencia -> {secs}s (charging={charging})", flush=True)
            last_secs = secs
        time.sleep(secs)


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(USAGE)
        return 0
    cmd = argv[0]
    if cmd == "--tick":
        tick()
        return 0
    if cmd == "--clear":
        theme = theme_primary_rgb()
        for zk in read_alerts():
            apply_zone(zk, None, theme)
        write_alerts({})
        return 0
    if cmd == "--dump":
        print(json.dumps({"telemetry": read_telemetry(),
                          "alerts": resolve(load_config(), read_telemetry())}, indent=2))
        return 0
    if cmd == "--apply" and len(argv) > 1:
        cfg = load_config()
        rule = next((r for r in cfg["rules"] if r["id"] == argv[1]), None)
        if not rule:
            print(f"regla desconocida: {argv[1]}")
            return 1
        theme = theme_primary_rgb()
        for a in rule["actions"]:
            for zk in _zone_keys(a):
                apply_zone(zk, {"effect": a["effect"], "trigger": rule["trigger"],
                                "source": rule["source"], "level": 50}, theme)
        return 0
    if cmd == "--daemon":
        return _daemon_loop()
    print(USAGE)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

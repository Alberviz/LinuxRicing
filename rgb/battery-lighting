    [0, 12, 18, 24, 30, 36, 42, 48, 54, 60, 66, 72, 78, 86],         # F-keys / Esc / Del
    [1, 7, 13, 19, 25, 31, 37, 43, 49, 55, 61, 67, 73, 79, 85],       # Números / Backspace / Ins
    [2, 8, 14, 20, 26, 32, 38, 44, 50, 56, 62, 68, 74, 80, 92],       # QWERTY / End
    [3, 9, 15, 21, 27, 33, 39, 45, 51, 57, 63, 69, 81, 87],           # ASDF / Enter / PgUp
    [4, 16, 22, 28, 34, 40, 46, 52, 58, 64, 70, 76, 94, 88],          # ZXCV / Shift / ↑ / PgDn
    [5, 17, 23, 41, 59, 71, 77, 83, 89, 95],                          # Inferior (Ctrl/Win/Alt/Space/Arrows)
]


def akko_meter_keys(level):
    keys = [(0, 0, 0)] * 128
    rows_on = meter_rows(level, len(AKKO_KEY_ROWS))
    colour = battery_level_color(level)
    # AKKO_KEY_ROWS[0] es la fila de arriba; encendemos desde abajo.
    for row in AKKO_KEY_ROWS[len(AKKO_KEY_ROWS) - rows_on:]:
        for idx in row:
            if 0 <= idx < 128:
                keys[idx] = colour
    return keys


def akko_canvas_chunks(rgb_per_key):
    blob = bytearray(384)
    for idx, (r, g, b) in enumerate(rgb_per_key[:128]):
        blob[idx * 3] = r
        blob[idx * 3 + 1] = g
        blob[idx * 3 + 2] = b
    chunks = []
    for page in range(7):
        buf = bytearray(64)
        buf[0] = 0x0C
        buf[1] = 0x00
        buf[2] = 384 & 0xFF        # 0x80
        buf[3] = (384 >> 8) & 0xFF # 0x01
        buf[4] = page
        buf[5] = 0x00
        buf[6] = 0x00
        buf[7] = 0xFF - (sum(buf[:7]) & 0xFF)  # Checksum Bit7 obligatorio en yc500
        start = page * 56
        end = min(start + 56, len(blob))
        buf[8:8 + (end - start)] = blob[start:end]
        chunks.append(bytes(buf))
    return chunks



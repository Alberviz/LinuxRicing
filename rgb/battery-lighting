EFFECT_ALIASES = {
    "theme":             {"animation": "solid", "colour": {"source": "theme"}},
    "solid_theme":       {"animation": "solid", "colour": {"source": "theme"}},
    "battery_color":     {"animation": "solid", "colour": {"source": "battery"}},

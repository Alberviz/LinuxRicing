# Servicio de usuario para Aurora.
#   cp aurora.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now aurora
[Unit]
Description=Aurora — asistente de voz local
After=graphical-session.target pipewire.service
Wants=pipewire.service

[Service]
Type=simple
WorkingDirectory=%h/LinuxRicing/assistant
ExecStart=%h/LinuxRicing/assistant/.venv/bin/python %h/LinuxRicing/assistant/aurorad.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target

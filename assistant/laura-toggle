#!/usr/bin/env python
"""Dispara un ciclo de Laura. Atar a un atajo de Hyprland.

    hl.bind("SUPER + A", hl.dsp.exec_cmd(".../laura-toggle"))

Un solo modo: si Laura ya está en marcha, repetir el atajo cancela el ciclo
(lo gestiona el daemon). No lleva argumentos.
"""
import os
import socket
import sys

path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "laura.sock")
try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(path)
    s.sendall(b"activate")
    s.close()
except (FileNotFoundError, ConnectionRefusedError):
    sys.stderr.write("laura: el daemon no está corriendo\n")
    os.system("notify-send -a Laura 'Laura' 'El daemon no está corriendo'")
    sys.exit(1)

filters:
  and:
    - file.inFolder("Backlog")
    - file.ext == "md"
formulas:
  prio: if(prioridad == 1, "🔴 1", if(prioridad == 2, "🟠 2", if(prioridad == 3, "🟡 3", if(prioridad == 4, "🔵 4", "⚪ 5"))))
  estado_icon: if(estado == "idea", "💡", if(estado == "hecha", "✅", if(estado == "en-curso", "🔄", if(estado == "descartada", "✖️", "⏳"))))
  dias: (now() - file.ctime).days
properties:
  formula.prio:
    displayName: Prioridad
  formula.dias:
    displayName: Días
  area:
    displayName: Área
  origen:
    displayName: Origen
  esfuerzo:
    displayName: Esfuerzo
  estado:
    type: select
    options:
      - idea
      - pendiente
      - en-curso
      - hecha
      - descartada
    displayName: Estado
  creado:
    displayName: Creado
  flujo:
    displayName: Flujo
views:
  - type: table
    name: 💡 Ideas
    filters:
      or:
        - estado == "idea"
        - estado.isEmpty()
    order:
      - file.name
      - area
      - flujo
      - esfuerzo
      - formula.prio
      - estado
    sort:
      - property: estado
        direction: ASC
    columnSize:
      file.name: 320
      note.area: 90
      note.flujo: 95
  - type: table
    name: 🔨 En curso
    filters:
      and:
        - estado == ["en-curso"]
    order:
      - formula.estado_icon
      - file.name
      - area
      - formula.prio
      - estado
      - flujo
    sort:
      - property: origen
        direction: ASC
    columnSize:
      formula.estado_icon: 34
      file.name: 106
  - type: table
    name: 🎯 Hoy
    filters:
      and:
        - estado == ["pendiente"]
    groupBy:
      property: prioridad
      direction: ASC
    order:
      - formula.estado_icon
      - file.name
      - area
      - esfuerzo
      - estado
      - flujo
    sort:
      - property: origen
        direction: ASC
    columnSize:
      formula.estado_icon: 42
      file.name: 125
      note.area: 70
      note.esfuerzo: 102
      note.origen: 138
  - type: table
    name: 📋 Todo
    filters:
      and:
        - not:
            - estado == "descartada"
        - not:
            - estado == "idea"
    order:
      - formula.prio
      - formula.estado_icon
      - file.name
      - area
      - esfuerzo
      - estado
  - type: table
    name: 🗂️ Por área
    filters:
      and:
        - not:
            - estado == "descartada"
        - not:
            - estado == "idea"
    groupBy:
      property: area
      direction: ASC
    order:
      - formula.prio
      - formula.estado_icon
      - file.name
      - esfuerzo
      - estado
  - type: table
    name: 🆕 Reciente
    order:
      - file.ctime
      - formula.estado_icon
      - file.name
      - area
      - formula.prio
      - estado
    limit: 15
    columnSize:
      file.ctime: 66
      formula.estado_icon: 32
      file.name: 284
  - type: table
    name: ✅ Hechas
    filters:
      and:
        - estado == "hecha"
    order:
      - file.name
      - area
      - origen
      - creado
  - type: cards
    name: 🃏 Tablero
    filters:
      not:
        - estado == "descartada"
    groupBy:
      property: estado
      direction: ASC
    order:
      - file.name
      - formula.prio
      - area
      - esfuerzo

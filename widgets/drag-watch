#!/usr/bin/env python3
"""
drag-watch — vigilante global de «arrastre de archivo en curso» para los portales de Quickshell.

Wayland no avisa de un drag-and-drop a quien no es origen ni destino, así que se deduce:
botón izquierdo del ratón/touchpad mantenido + el cursor se aleja > UMBRAL px del punto de
pulsación + (opcional) la ventana activa es un gestor de archivos o un navegador (evita falsos
positivos al mover ventanas o seleccionar texto).

Lee los eventos de botón directamente de /dev/input/event* (grupo `input`; no hace falta
python-evdev) y la posición/ventana de Hyprland por su socket. Sirve un socket unix
$XDG_RUNTIME_DIR/drag-watch.sock con un JSON por línea:
    {"dragging": false}
    {"dragging": true, "x": 1200, "y": 300}      # ~30 Hz, SOLO mientras dura el arrastre
En reposo el proceso duerme bloqueado en select(): cero CPU, cero sondeo.

CUÁNDO SALEN LOS PORTALES (reglas, 2026-11-12). Wayland no cuenta los arrastres de otros, así que se deduce y se
filtra para no confundir un arrastre de archivo o de texto con seleccionar texto, mover un deslizador o un rectángulo
de selección:
  1. Botón izquierdo mantenido y el cursor se aleja más de UMBRAL px del clic.
  2. La ventana activa decide qué cuenta:
       · gestor de archivos (Dolphin, Thunar…): vale cualquier arrastre (un archivo, varios);
       · navegador: solo si había texto seleccionado ANTES del clic (selección primaria no vacía) y no cambia durante
         el arrastre. Seleccionar texto nuevo (la selección cambia) o mover un deslizador, una barra o un mapa
         (sin selección previa) no enciende nada. (Arrastrar un enlace o una imagen de una página no se detecta;
         DRAG_WATCH_NAVEGADOR=todo lo vuelve a permitir.)
       · cualquier otra ventana: nunca.
  3. Zona: los portales solo se encienden cuando el cursor entra en la franja de arriba (los 40 % superiores de la
     pantalla) o en la de la derecha (el 25 % derecho). Una vez encendidos se quedan hasta soltar.
Variables: DRAG_WATCH_THRESHOLD (px, 40), DRAG_WATCH_CLASSES (regex de gestores de archivos),
DRAG_WATCH_NAVEGADOR (seleccion|todo|nada; por defecto seleccion), DRAG_WATCH_ZONA (alto%,ancho%; 40,25; 100,100 = todo).
Prueba:  drag-watch sim x y | drag-watch sim off   (emite estados falsos a los clientes).
"""
import glob
import json
import os
import re
import select
import socket
import struct
import sys
import time

RUNTIME = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
SOCK = os.path.join(RUNTIME, "drag-watch.sock")
THRESHOLD = float(os.environ.get("DRAG_WATCH_THRESHOLD", "40"))
CLASSES = os.environ.get(
    "DRAG_WATCH_CLASSES",
    r"(?i)thunar|dolphin|nautilus|nemo|pcmanfm|caja|krusader|doublecmd|files",
)
NAVEGADORES = os.environ.get(
    "DRAG_WATCH_NAVEGADORES",
    r"(?i)zen|firefox|chrom|brave|librewolf|vivaldi|floorp|waterfox",
)
MODO_NAVEGADOR = os.environ.get("DRAG_WATCH_NAVEGADOR", "seleccion")
try:
    ZONA_ALTO, ZONA_ANCHO = (float(v) / 100 for v in os.environ.get("DRAG_WATCH_ZONA", "40,25").split(","))
except ValueError:
    ZONA_ALTO, ZONA_ANCHO = 0.40, 0.25
CLASS_RE = re.compile(CLASSES) if CLASSES else None
NAV_RE = re.compile(NAVEGADORES) if NAVEGADORES else None
BTN_LEFT = 0x110
EV_KEY = 1
EVFMT = "llHHi"
EVSIZE = struct.calcsize(EVFMT)
TICK = 0.033


def hypr(cmd):
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not sig:
        d = glob.glob(os.path.join(RUNTIME, "hypr", "*"))
        if not d:
            return None
        sig = os.path.basename(max(d, key=os.path.getmtime))
    path = os.path.join(RUNTIME, "hypr", sig, ".socket.sock")
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(0.5)
    try:
        s.connect(path)
        s.sendall(cmd.encode())
        buf = b""
        while True:
            c = s.recv(65536)
            if not c:
                break
            buf += c
        return json.loads(buf)
    except Exception:
        return None
    finally:
        s.close()


def cursor():
    r = hypr("j/cursorpos")
    return (float(r["x"]), float(r["y"])) if r else None


def active_class():
    r = hypr("j/activewindow")
    return (r.get("class") or "") if isinstance(r, dict) else ""


def primaria():
    """Texto de la selección primaria (None si no se puede leer; '' si está vacía)."""
    import subprocess
    try:
        r = subprocess.run(["wl-paste", "--primary", "--no-newline"], capture_output=True, timeout=0.3)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout if r.returncode == 0 else b""


def pantalla_enfocada():
    """(x, y, ancho, alto) lógicos del monitor enfocado, o None."""
    r = hypr("j/monitors")
    if not isinstance(r, list):
        return None
    for m in r:
        if m.get("focused"):
            esc = float(m.get("scale") or 1) or 1.0
            return (float(m["x"]), float(m["y"]), float(m["width"]) / esc, float(m["height"]) / esc)
    return None


def en_zona(pos, pant):
    """¿Está el cursor en la franja de arriba o en la de la derecha del monitor?"""
    if not pant:
        return True
    x0, y0, w, h = pant
    return (pos[1] - y0) <= h * ZONA_ALTO or (pos[0] - x0) >= w * (1 - ZONA_ANCHO)


def has_btn_left(ev):
    try:
        words = open(f"/sys/class/input/{ev}/device/capabilities/key").read().split()
        bits = int("".join(w.zfill(16) for w in words), 16) if words else 0
        # Con words de 64 bit (unsigned long), el más significativo va primero.
        return bool(bits >> BTN_LEFT & 1)
    except Exception:
        return False


def open_pointers():
    fds = {}
    for p in sorted(glob.glob("/dev/input/event*")):
        ev = os.path.basename(p)
        if not has_btn_left(ev):
            continue
        try:
            fds[os.open(p, os.O_RDONLY | os.O_NONBLOCK)] = ev
        except OSError:
            pass
    return fds


def refresh_pointers(fds):
    known = set(fds.values())
    for p in sorted(glob.glob("/dev/input/event*")):
        ev = os.path.basename(p)
        if ev in known or not has_btn_left(ev):
            continue
        try:
            fds[os.open(p, os.O_RDONLY | os.O_NONBLOCK)] = ev
        except OSError:
            pass


def send_cmd(args):
    s = socket.socket(socket.AF_UNIX)
    s.connect(SOCK + ".ctl")
    s.sendall((json.dumps(args) + "\n").encode())
    s.close()


def daemon():
    for p in (SOCK, SOCK + ".ctl"):
        try:
            os.unlink(p)
        except FileNotFoundError:
            pass
    srv = socket.socket(socket.AF_UNIX)
    srv.bind(SOCK)
    srv.listen(8)
    ctl = socket.socket(socket.AF_UNIX)
    ctl.bind(SOCK + ".ctl")
    ctl.listen(4)
    clients = []
    fds = open_pointers()
    if not fds:
        print("drag-watch: sin ratón legible (¿grupo input?)", file=sys.stderr)
    state = {"dragging": False}
    pressed = False
    origin = None
    sim = False
    clase = ""          # ventana activa al hacer clic
    previa = None        # selección primaria al hacer clic (navegadores)
    pant = None          # monitor enfocado al hacer clic
    ultimo_chequeo = 0.0

    ultimo_rescan = time.monotonic()

    def publish(obj):
        data = (json.dumps(obj) + "\n").encode()
        for c in clients[:]:
            try:
                c.sendall(data)
            except OSError:
                clients.remove(c)
                c.close()

    def set_state(obj):
        state.clear()
        state.update(obj)
        publish(obj)

    while True:
        dragging = state.get("dragging")
        timeout = TICK if (pressed or dragging) and not sim else 3.0
        rl, _, _ = select.select([srv, ctl, *fds, *clients], [], [], timeout)
        if time.monotonic() - ultimo_rescan >= 3.0:
            ultimo_rescan = time.monotonic()
            refresh_pointers(fds)
        for r in rl:
            if r is srv:
                c, _ = srv.accept()
                c.setblocking(True)
                c.settimeout(0.2)
                clients.append(c)
                try:
                    c.sendall((json.dumps(state) + "\n").encode())
                except OSError:
                    pass
            elif r is ctl:
                c, _ = ctl.accept()
                try:
                    msg = json.loads(c.recv(4096).decode().strip() or "{}")
                except Exception:
                    msg = {}
                c.close()
                if msg.get("sim") == "off":
                    sim = False
                    set_state({"dragging": False})
                elif "x" in msg:
                    sim = True
                    set_state({"dragging": True, "x": msg["x"], "y": msg["y"]})
            elif r in clients:
                try:
                    if not r.recv(64):
                        raise OSError
                except (OSError, socket.timeout):
                    clients.remove(r)
                    r.close()
            else:
                try:
                    data = os.read(r, EVSIZE * 64)
                except BlockingIOError:
                    continue
                except OSError:
                    fds.pop(r, None)
                    try:
                        os.close(r)
                    except OSError:
                        pass
                    refresh_pointers(fds)
                    continue
                for i in range(0, len(data) - EVSIZE + 1, EVSIZE):
                    _, _, typ, code, val = struct.unpack(EVFMT, data[i:i + EVSIZE])
                    if typ == EV_KEY and code == BTN_LEFT and not sim:
                        if val == 1:
                            pressed = True
                            origin = cursor()
                            clase = active_class()
                            pant = pantalla_enfocada()
                            previa = primaria() if (NAV_RE and NAV_RE.search(clase) and MODO_NAVEGADOR == "seleccion") else None
                        elif val == 0:
                            pressed = False
                            origin = None
                            if state.get("dragging"):
                                set_state({"dragging": False})
        if sim:
            continue
        if pressed and origin:
            pos = cursor()
            if pos:
                dx, dy = pos[0] - origin[0], pos[1] - origin[1]
                lejos = (dx * dx + dy * dy) ** 0.5 > THRESHOLD
                if not state.get("dragging"):
                    if lejos:
                        veredicto = clasificar(clase, previa)
                        if veredicto is None:
                            pressed = False  # no es un arrastre de archivo o de texto: ignorar hasta soltar
                        elif en_zona(pos, pant):
                            set_state({"dragging": True, "x": pos[0], "y": pos[1]})
                else:
                    # En un navegador la selección no puede cambiar: si cambia, era seleccionar texto, no arrastrarlo.
                    if previa is not None and time.monotonic() - ultimo_chequeo > 0.15:
                        ultimo_chequeo = time.monotonic()
                        if primaria() != previa:
                            pressed = False
                            set_state({"dragging": False})
                            continue
                    set_state({"dragging": True, "x": pos[0], "y": pos[1]})


def clasificar(clase, previa):
    """True/False: arrastre posible según la ventana; None: ignorar. Ver las reglas en la cabecera."""
    if CLASS_RE and CLASS_RE.search(clase):
        return True
    if NAV_RE and NAV_RE.search(clase):
        if MODO_NAVEGADOR == "todo":
            return True
        if MODO_NAVEGADOR == "seleccion" and previa:
            return True
    return None


def main():
    a = sys.argv[1:]
    if not a or a[0] == "daemon":
        daemon()
    elif a[0] == "sim":
        if a[1:] == ["off"]:
            send_cmd({"sim": "off"})
        else:
            send_cmd({"x": float(a[1]), "y": float(a[2])})
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main()

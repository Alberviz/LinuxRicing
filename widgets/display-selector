#!/usr/bin/env bash
# ==============================================================================
#  🛸 display-selector — Selector nativo de proyección de pantallas (Win + P)
#  Usa el diálogo nativo Material Design 3 de Quickshell (con fallback a Fuzzel MD3)
# ==============================================================================

# 1. Intentar abrir el diálogo nativo Material Design 3 de Quickshell
if qs -c caelestia ipc show >/dev/null 2>&1; then
    qs -c caelestia ipc call projectMenu toggle
    exit 0
fi

# 2. Fallback por si Quickshell estuviera cerrado o en reinicio
pkill -f "fuzzel.*Proyectar" 2>/dev/null && exit 0

python3 - << 'PYEOF'
import json, os, subprocess
from pathlib import Path

SCHEME_PATH = Path(os.path.expanduser("~/.local/state/caelestia/scheme.json"))

def get_m3_colors():
    defaults = {
        "bg": "130d0af2", "text": "f8e1d6ff", "prompt": "f7b999ff",
        "placeholder": "847269ff", "selection": "74472fdd",
        "selection_text": "ffdcccff", "selection_match": "fff6e2ff",
        "border": "f7b999bb",
    }
    if not SCHEME_PATH.exists():
        return defaults
    try:
        data = json.loads(SCHEME_PATH.read_text())
        c = data.get("colours", {})
        return {
            "bg": f"{c.get('surfaceContainer', '130d0a')}f4",
            "text": f"{c.get('onSurface', 'f8e1d6')}ff",
            "prompt": f"{c.get('primary', 'f7b999')}ff",
            "placeholder": f"{c.get('outline', '847269')}ff",
            "selection": f"{c.get('primaryContainer', '74472f')}ee",
            "selection_text": f"{c.get('onPrimaryContainer', 'ffdccc')}ff",
            "selection_match": f"{c.get('tertiary', 'fff6e2')}ff",
            "border": f"{c.get('primary', 'f7b999')}aa",
        }
    except Exception:
        return defaults

def get_monitors():
    try:
        raw = subprocess.check_output(["hyprctl", "monitors", "all", "-j"]).decode()
        mons = json.loads(raw)
        internal = "eDP-2"
        external = "HDMI-A-1"
        for m in mons:
            name = m.get("name", "")
            if name.startswith("eDP"):
                internal = name
            elif name:
                external = name
        return internal, external
    except Exception:
        return "eDP-2", "HDMI-A-1"

internal, external = get_monitors()
colors = get_m3_colors()

options = [
    "🖥️   Solo monitor externo (Apagar pantalla del portátil)",
    "🔀  Extender pantallas (Doble monitor a 144Hz)",
    "🪞   Duplicar / Espejo (144Hz en ambas pantallas)",
    "💻  Solo pantalla del portátil",
    "❌  Cancelar",
]

fuzzel_cmd = [
    "fuzzel", "--dmenu", "--lines=5", "--width=48", "--horizontal-pad=28",
    "--vertical-pad=18", "--inner-pad=12", "--line-height=30",
    "--prompt=󰍹  Proyectar pantalla   ", "--placeholder=Elige cómo proyectar...",
    f"--background-color={colors['bg']}", f"--text-color={colors['text']}",
    f"--prompt-color={colors['prompt']}", f"--placeholder-color={colors['placeholder']}",
    f"--input-color={colors['text']}", f"--selection-color={colors['selection']}",
    f"--selection-text-color={colors['selection_text']}",
    f"--selection-match-color={colors['selection_match']}",
    "--selection-radius=12", f"--border-color={colors['border']}",
    "--border-width=2", "--border-radius=20",
]

try:
    res = subprocess.check_output(fuzzel_cmd, input="\n".join(options).encode(), stderr=subprocess.DEVNULL).decode().strip()
except Exception:
    exit(0)

if "Solo monitor externo" in res:
    subprocess.run(["hyprctl", "eval", f"hl.monitor({{ output = '{internal}', disabled = true }}); hl.monitor({{ output = '{external}', mode = '1920x1080@144', position = '0x0', scale = 1, disabled = false }})"])
elif "Extender pantallas" in res:
    subprocess.run(["hyprctl", "eval", f"hl.monitor({{ output = '{external}', mode = '1920x1080@144', position = '1920x0', scale = 1, disabled = false }}); hl.monitor({{ output = '{internal}', mode = '1920x1080@144', position = '0x0', scale = 1, disabled = false }})"])
elif "Duplicar" in res:
    subprocess.run(["hyprctl", "eval", f"hl.monitor({{ output = '{internal}', mode = '1920x1080@144', position = 'auto', scale = 1, disabled = false }}); hl.monitor({{ output = '{external}', mode = '1920x1080@144', position = 'auto', scale = 1, mirror = '{internal}', disabled = false }})"])
elif "Solo pantalla del portátil" in res:
    subprocess.run(["hyprctl", "eval", f"hl.monitor({{ output = '{external}', disabled = true }}); hl.monitor({{ output = '{internal}', mode = '1920x1080@144', position = '0x0', scale = 1, disabled = false }})"])
PYEOF

#!/usr/bin/env python3
"""
warp — pasar texto y archivos del PC al móvil (bandeja «Desde el PC» de Olimpo). Diseño: docs/WARP.md.

Es la única puerta de Warp en el PC: la usan el atajo (Super+Shift+K), el arrastre de texto al portal de arriba, Laura
y las órdenes que llegan del móvil por el puente de Olimpo (Instinct). Envía con `olimpo enviar` (sin red propia) y,
por cada envío, escribe en $XDG_RUNTIME_DIR/warp/salidas.jsonl para que el shell abra el agujero negro.

  warp texto "…" | warp texto -        un texto (argumento o entrada estándar)
  warp portapapeles                    lo copiado (texto, o imagen → PNG)
  warp seleccion                       lo subrayado (selección primaria)
  warp rapido                          portapapeles; si está vacío, la selección (lo usa el atajo)
  warp captura                         captura del monitor enfocado
  warp ultimo [carpeta]                envía el archivo más reciente (por defecto Descargas)
  warp listar [carpeta]                los 8 archivos más recientes de una carpeta, sin enviar (por defecto Descargas)
  warp buscar "<descripción>"          candidatos, sin enviar (p. ej. "pdf práctica redes"); --carpeta X para acotar
  warp archivo <ruta>                  envía ese archivo

  --json      una línea JSON en la salida estándar (contrato con Laura y el puente)
  --remoto    la orden viene del móvil: solo listar/buscar/ultimo/archivo y nada oculto ni sensible
  --origen X  quién lo pide (atajo, laura, instinct, arrastre…), para el shell

Variables (pruebas): WARP_OLIMPO (binario de olimpo), WARP_RAIZ (raíz de búsqueda, por defecto $HOME),
WARP_BUSCADOR=walk (sin fd), WARP_SALIDAS (ruta de salidas.jsonl).
"""
from __future__ import annotations

import argparse
import json
import math
import os
import re
import shutil
import subprocess
import sys
import time
import unicodedata
from pathlib import Path

HOME = Path.home()
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}")
MAX_ARCHIVO = 50 * 1024 * 1024
MAX_TEXTO = 32 * 1024
FRAGMENTO = 140

TIPOS = {
    "pdf": {"pdf"},
    "foto": {"jpg", "jpeg", "png", "webp", "heic", "gif"}, "fotos": None, "imagen": None, "imagenes": None,
    "captura": {"png", "jpg", "jpeg", "webp"}, "capturas": None, "pantallazo": None, "pantallazos": None,
    "video": {"mp4", "mkv", "webm", "mov", "avi"}, "videos": None,
    "documento": {"pdf", "doc", "docx", "odt", "md", "txt", "rtf"}, "documentos": None,
    "word": {"doc", "docx", "odt"},
    "presentacion": {"ppt", "pptx", "odp", "key"}, "presentaciones": None, "diapositivas": None,
    "hoja": {"xls", "xlsx", "ods", "csv"}, "excel": None, "calculo": None,
    "audio": {"mp3", "ogg", "opus", "m4a", "wav", "flac"}, "cancion": None, "musica": None,
    "zip": {"zip", "rar", "7z", "tar", "gz", "xz"}, "comprimido": None,
}
for _k, _v in list(TIPOS.items()):  # los sinónimos heredan del anterior con conjunto
    if _v is None:
        TIPOS[_k] = _prev
    else:
        _prev = _v
VACIAS = {"el", "la", "los", "las", "de", "del", "un", "una", "unos", "unas", "mi", "mis", "me", "que", "por", "para", "en",
          "y", "o", "a", "al", "con", "archivo", "fichero", "ultimo", "ultima", "esto", "eso", "ese", "esa", "lo", "le"}
PREFERIDAS = ("documentos", "descargas", "universidad", "escritorio", "imagenes", "proyectos")
EXCLUIR = ("node_modules", "__pycache__", "target", "build", "dist", "venv", ".venv", "site-packages")
SENSIBLE = re.compile(r"(?i)(^|/)(\.ssh|\.gnupg|\.password-store|\.config|\.local|\.env[^/]*)(/|$)|"
                      r"\.(key|pem|p12|pfx|kdbx|token|gpg|asc)$|(^|/)id_[^/]*$|(^|/)(credentials|secrets?)(\.[^/]*)?$")


class Fallo(Exception):
    pass


# ── utilidades ──────────────────────────────────────────────────────────────────────────────────────────────────────

def plano(s: str) -> str:
    """minúsculas y sin tildes («Práctica» → «practica»)."""
    return "".join(c for c in unicodedata.normalize("NFD", s.lower()) if unicodedata.category(c) != "Mn")


def tam(b: int) -> str:
    if b >= 1048576:
        return f"{b / 1048576:.1f} MB".replace(".", ",")
    return f"{max(1, round(b / 1024))} KB"


def salidas_ruta() -> Path:
    return Path(os.environ.get("WARP_SALIDAS") or RUNTIME / "warp" / "salidas.jsonl")


def anunciar(fase: str, tipo: str, nombre: str, origen: str, fragmento: str = "", mensaje: str = "", tamano: int = 0) -> None:
    """Una línea en salidas.jsonl (el portal de arriba la sigue con tail -F). Nunca hace fallar el envío."""
    try:
        p = salidas_ruta()
        p.parent.mkdir(parents=True, exist_ok=True)
        if p.exists() and p.stat().st_size > 256 * 1024:
            p.write_text("")
        linea = {"fase": fase, "tipo": tipo, "nombre": nombre, "fragmento": fragmento[:FRAGMENTO], "origen": origen,
                 "mensaje": mensaje, "tamano": tamano, "ts": time.time()}
        with open(p, "a", encoding="utf-8") as f:
            f.write(json.dumps(linea, ensure_ascii=False) + "\n")
    except OSError:
        pass


def olimpo(args: list[str], entrada: str | None = None, timeout: float = 300) -> dict:
    exe = os.environ.get("WARP_OLIMPO") or shutil.which("olimpo") or str(HOME / ".local/bin/olimpo")
    try:
        r = subprocess.run([exe, *args], input=entrada, capture_output=True, text=True, timeout=timeout)
    except FileNotFoundError:
        raise Fallo("No encuentro el CLI de Olimpo (olimpo).") from None
    except subprocess.TimeoutExpired:
        raise Fallo("Olimpo tardó demasiado.") from None
    try:
        d = json.loads(r.stdout.strip().splitlines()[-1])
    except (IndexError, ValueError):
        raise Fallo((r.stderr or "Olimpo no respondió").strip()[:200]) from None
    if not d.get("ok"):
        raise Fallo(str(d.get("error") or "Olimpo no pudo enviarlo."))
    return d


def leer(cmd: list[str]) -> bytes:
    try:
        r = subprocess.run(cmd, capture_output=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return b""
    return r.stdout if r.returncode == 0 else b""


# ── envíos ──────────────────────────────────────────────────────────────────────────────────────────────────────────

def enviar_texto(texto: str, origen: str) -> dict:
    texto = texto.replace("\r\n", "\n")
    if not texto.strip():
        raise Fallo("No hay texto que enviar.")
    if len(texto.encode()) > MAX_TEXTO:
        raise Fallo(f"El texto es demasiado largo (máx. {MAX_TEXTO // 1024} KB).")
    primera = next(l for l in texto.splitlines() if l.strip()).strip()
    anunciar("enviando", "texto", primera[:60], origen, texto)
    try:
        olimpo(["enviar", "--texto", "-"], entrada=texto, timeout=30)
    except Fallo as e:
        anunciar("error", "texto", primera[:60], origen, texto, str(e))
        raise
    anunciar("ok", "texto", primera[:60], origen, texto, "En tu móvil")
    return {"ok": True, "tipo": "texto", "caracteres": len(texto)}


def enviar_archivo(ruta: Path, origen: str, remoto: bool = False) -> dict:
    ruta = ruta.expanduser()
    if remoto:
        permitido(ruta)
    if not ruta.is_file():
        raise Fallo(f"No existe el archivo «{ruta}».")
    t = ruta.stat().st_size
    if t > MAX_ARCHIVO:
        raise Fallo(f"Demasiado grande para el móvil ({tam(t)} / máx. 50 MB).")
    anunciar("enviando", "archivo", ruta.name, origen, tamano=t)
    try:
        olimpo(["enviar", str(ruta)])
    except Fallo as e:
        anunciar("error", "archivo", ruta.name, origen, mensaje=str(e), tamano=t)
        raise
    anunciar("ok", "archivo", ruta.name, origen, mensaje="En tu móvil", tamano=t)
    return {"ok": True, "tipo": "archivo", "enviado": ficha(ruta)}


def permitido(ruta: Path) -> None:
    """Restricciones de lo que pide el móvil: bajo $HOME, nada oculto ni con pinta de secreto."""
    raiz = Path(os.environ.get("WARP_RAIZ") or HOME).resolve()
    try:
        real = ruta.resolve()
        rel = real.relative_to(raiz)
    except (OSError, ValueError):
        raise Fallo("Esa ruta no se puede enviar desde el móvil.") from None
    if any(p.startswith(".") for p in rel.parts) or SENSIBLE.search("/" + rel.as_posix()):
        raise Fallo("Esa ruta no se puede enviar desde el móvil.")


def ficha(p: Path, puntos: float | None = None) -> dict:
    st = p.stat()
    d = {"ruta": str(p), "nombre": p.name, "tamano": st.st_size, "modificado": int(st.st_mtime)}
    if p.is_dir():
        d["carpeta"] = True
    if puntos is not None:
        d["puntos"] = round(puntos, 2)
    return d


def portapapeles(origen: str, primaria: bool = False) -> dict:
    extra = ["--primary"] if primaria else []
    tipos = leer(["wl-paste", *extra, "--list-types"]).decode(errors="replace").split()
    imagen = next((t for t in ("image/png", "image/jpeg", "image/webp") if t in tipos), None)
    if imagen and not primaria:
        datos = leer(["wl-paste", "--type", imagen])
        if datos:
            d = RUNTIME / "warp"
            d.mkdir(parents=True, exist_ok=True)
            f = d / f"Portapapeles {time.strftime('%Y-%m-%d %H.%M.%S')}.{imagen.split('/')[1]}"
            f.write_bytes(datos)
            try:
                return enviar_archivo(f, origen)
            finally:
                f.unlink(missing_ok=True)
    texto = leer(["wl-paste", *extra, "--no-newline"]).decode(errors="replace")
    if not texto.strip():
        raise Fallo("La selección está vacía." if primaria else "El portapapeles está vacío.")
    return enviar_texto(texto, origen)


def rapido(origen: str) -> dict:
    """El atajo: lo copiado (intención explícita); si no hay nada, lo subrayado."""
    try:
        return portapapeles(origen)
    except Fallo as e:
        if "vacío" not in str(e):
            raise
        return portapapeles(origen, primaria=True)


def captura(origen: str) -> dict:
    mon = None
    try:
        mons = json.loads(leer(["hyprctl", "monitors", "-j"]) or b"[]")
        mon = next((m["name"] for m in mons if m.get("focused")), None)
    except ValueError:
        pass
    d = RUNTIME / "warp"
    d.mkdir(parents=True, exist_ok=True)
    f = d / f"Captura {time.strftime('%Y-%m-%d %H.%M.%S')}.png"
    r = subprocess.run(["grim", *(["-o", mon] if mon else []), str(f)], capture_output=True, timeout=10)
    if r.returncode != 0 or not f.exists():
        raise Fallo("No se pudo hacer la captura.")
    try:
        return enviar_archivo(f, origen)
    finally:
        f.unlink(missing_ok=True)


# ── buscar ──────────────────────────────────────────────────────────────────────────────────────────────────────────

def carpeta_de(nombre: str | None) -> Path:
    raiz = Path(os.environ.get("WARP_RAIZ") or HOME)
    n = plano(nombre or "descargas").strip("/ ")
    xdg = {"descargas": "DOWNLOAD", "documentos": "DOCUMENTS", "escritorio": "DESKTOP", "imagenes": "PICTURES",
           "fotos": "PICTURES", "videos": "VIDEOS", "musica": "MUSIC"}
    if n in xdg and "WARP_RAIZ" not in os.environ:
        p = Path(leer(["xdg-user-dir", xdg[n]]).decode().strip() or raiz)
        if p != HOME and p.is_dir():
            return p
    for hijo in raiz.iterdir() if raiz.is_dir() else []:
        if hijo.is_dir() and plano(hijo.name) == n:
            return hijo
    p = Path(nombre or "").expanduser()
    if p.is_absolute() and p.is_dir():
        return p
    raise Fallo(f"No encuentro la carpeta «{nombre}».")


def ultimo(carpeta: str | None, origen: str, remoto: bool, enviar: bool = True) -> dict:
    c = carpeta_de(carpeta)
    archivos = [p for p in c.iterdir() if p.is_file() and not p.name.startswith(".") and not p.name.endswith((".part", ".crdownload"))]
    if remoto:
        archivos = [p for p in archivos if _ok_remoto(p)]
    if not archivos:
        raise Fallo(f"No hay archivos en {c.name}.")
    p = max(archivos, key=lambda x: x.stat().st_mtime)
    if not enviar:
        return {"ok": True, "candidatos": [ficha(p)], "claro": True}
    d = enviar_archivo(p, origen, remoto)
    return {**d, "candidatos": [d["enviado"]], "claro": True}


def listar(carpeta: str | None, remoto: bool, n: int = 8) -> dict:
    c = carpeta_de(carpeta)
    if remoto:
        permitido(c)
    archivos = [p for p in c.iterdir() if p.is_file() and not p.name.startswith(".") and not p.name.endswith((".part", ".crdownload"))]
    if remoto:
        archivos = [p for p in archivos if _ok_remoto(p)]
    archivos.sort(key=lambda x: -x.stat().st_mtime)
    if remoto:
        return {"ok": True, "carpeta": str(c), "total": len(archivos), "candidatos": [ficha(p) for p in archivos[:n]],
                "claro": False}
    # En local también se ven las subcarpetas (primero, por nombre): si no, Documentos o Vídeos parecen vacías
    carpetas = sorted((p for p in c.iterdir() if p.is_dir() and not p.name.startswith(".")), key=lambda x: x.name.lower())
    return {"ok": True, "carpeta": str(c), "total": len(carpetas) + len(archivos),
            "candidatos": [ficha(p) for p in (carpetas + archivos[:n])[:12]], "claro": False}


def _ok_remoto(p: Path) -> bool:
    try:
        permitido(p)
        return True
    except Fallo:
        return False


def analizar(consulta: str) -> tuple[list[str], set[str]]:
    palabras, exts = [], set()
    for w in re.findall(r"[\w.-]+", plano(consulta)):
        if w in TIPOS:
            exts |= TIPOS[w]
        elif w.startswith(".") and len(w) > 1:
            exts.add(w[1:])
        elif w not in VACIAS and len(w) > 1:
            palabras.append(w)
    return palabras, exts


def _regex_sin_tildes(w: str) -> str:
    grupos = {"a": "aáàä", "e": "eéèë", "i": "iíìï", "o": "oóòö", "u": "uúùü", "n": "nñ"}
    return "".join(f"[{grupos[c]}]" if c in grupos else re.escape(c) for c in w)


def candidatos_crudos(raiz: Path, palabras: list[str], exts: set[str]) -> list[Path]:
    clave = max(palabras, key=len) if palabras else None
    if os.environ.get("WARP_BUSCADOR") != "walk" and shutil.which("fd"):
        cmd = ["fd", "--type", "f", "--absolute-path", "--ignore-case", "--max-results", "3000"]
        for x in EXCLUIR:
            cmd += ["--exclude", x]
        for e in sorted(exts):
            cmd += ["-e", e]
        if clave:
            cmd += ["--full-path", _regex_sin_tildes(clave)]
        else:
            cmd += ["--changed-within", "120d", "."]
        cmd.append(str(raiz))
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
            return [Path(l) for l in r.stdout.splitlines() if l]
        except (OSError, subprocess.SubprocessError):
            pass
    fuera = []
    for d, dirs, files in os.walk(raiz):
        dirs[:] = [x for x in dirs if not x.startswith(".") and x not in EXCLUIR]
        for f in files:
            if f.startswith("."):
                continue
            p = Path(d) / f
            if exts and p.suffix.lower().lstrip(".") not in exts:
                continue
            if clave and clave not in plano(str(p)):
                continue
            fuera.append(p)
            if len(fuera) >= 3000:
                return fuera
    return fuera


def puntuar(p: Path, raiz: Path, palabras: list[str], exts: set[str], ahora: float) -> float | None:
    try:
        rel = plano(p.relative_to(raiz).as_posix())
        st = p.stat()
    except (OSError, ValueError):
        return None
    if exts and p.suffix.lower().lstrip(".") not in exts:
        return None
    nombre = plano(p.name)
    pts = 0.0
    for w in palabras:
        if w in nombre:
            pts += 3
        elif w in rel:
            pts += 1
        else:
            return None
    if exts:
        pts += 1
    edad = max(0.0, (ahora - st.st_mtime) / 86400)
    pts += 2 * math.exp(-edad / 30)
    if rel.split("/")[0] in PREFERIDAS:
        pts += 0.5
    return pts


def buscar(consulta: str, remoto: bool, carpeta: str | None = None) -> dict:
    palabras, exts = analizar(consulta)
    if not palabras and not exts:
        raise Fallo("Dime algo del archivo: un nombre, una palabra o el tipo (pdf, foto…).")
    raiz = carpeta_de(carpeta) if carpeta else Path(os.environ.get("WARP_RAIZ") or HOME)
    if carpeta and remoto:
        permitido(raiz)
    ahora = time.time()
    vistos = []
    for p in candidatos_crudos(raiz, palabras, exts):
        if remoto and not _ok_remoto(p):
            continue
        if not p.is_relative_to(raiz) or any(part.startswith(".") for part in p.relative_to(raiz).parts):
            continue
        s = puntuar(p, raiz, palabras, exts, ahora)
        if s is not None:
            vistos.append((s, p))
    vistos.sort(key=lambda x: (-x[0], -x[1].stat().st_mtime))
    top = vistos[:5]
    claro = bool(top) and (len(top) == 1 or top[0][0] >= 1.5 * top[1][0])
    return {"ok": True, "candidatos": [ficha(p, s) for s, p in top], "claro": claro}


# ── main ────────────────────────────────────────────────────────────────────────────────────────────────────────────

LOCALES = ("texto", "portapapeles", "seleccion", "rapido", "captura")


def ejecutar(a) -> dict:
    if a.remoto and a.accion in LOCALES:
        raise Fallo("Eso solo se puede pedir desde el PC.")
    if a.accion == "texto":
        t = sys.stdin.read() if (not a.args or a.args == ["-"]) else " ".join(a.args)
        return enviar_texto(t, a.origen)
    if a.accion == "portapapeles":
        return portapapeles(a.origen)
    if a.accion == "seleccion":
        return portapapeles(a.origen, primaria=True)
    if a.accion == "rapido":
        return rapido(a.origen)
    if a.accion == "captura":
        return captura(a.origen)
    if a.accion == "ultimo":
        return ultimo(a.args[0] if a.args else None, a.origen, a.remoto, enviar=not a.solo_mirar)
    if a.accion == "listar":
        return listar(a.args[0] if a.args else None, a.remoto)
    if a.accion == "buscar":
        return buscar(" ".join(a.args), a.remoto, a.carpeta)
    if a.accion == "archivo":
        if not a.args:
            raise Fallo("¿Qué archivo?")
        return enviar_archivo(Path(" ".join(a.args)), a.origen, a.remoto)
    raise Fallo("Acción desconocida.")


def legible(d: dict) -> str:
    if not d.get("ok"):
        return f"✗ {d.get('error')}"
    if "candidatos" in d and "enviado" not in d:
        if not d["candidatos"]:
            return "Nada encontrado."
        return "\n".join(f"{'→' if i == 0 and d.get('claro') else ' '} {c['ruta']}{'/' if c.get('carpeta') else ''}"
                         f"{'' if c.get('carpeta') else '  (' + tam(c['tamano']) + ')'}"
                         for i, c in enumerate(d["candidatos"]))
    if d.get("tipo") == "texto":
        return f"✓ Texto enviado al móvil ({d['caracteres']} caracteres)"
    return f"✓ {d['enviado']['nombre']} enviado al móvil"


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="warp", description="Pasa texto y archivos del PC al móvil (Olimpo).")
    ap.add_argument("accion", choices=("texto", "portapapeles", "seleccion", "rapido", "captura", "ultimo", "listar", "buscar",
                                       "archivo"))
    ap.add_argument("args", nargs="*")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--remoto", action="store_true")
    ap.add_argument("--origen", default="terminal")
    ap.add_argument("--carpeta", help="buscar: solo dentro de esta carpeta (Descargas, Documentos… o una ruta)")
    ap.add_argument("--solo-mirar", action="store_true", help="ultimo: dice cuál es, sin enviarlo")
    a = ap.parse_args(argv)
    try:
        d = ejecutar(a)
    except Fallo as e:
        d = {"ok": False, "error": str(e)}
    print(json.dumps(d, ensure_ascii=False) if a.json else legible(d), flush=True)
    return 0 if d.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main())

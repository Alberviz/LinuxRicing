CAST_SENDER = os.environ.get("CAST_SENDER", os.path.expanduser("~/.local/lib/linuxricing/cast_sender"))
STREAM_PLAYOUT_MS = int(os.environ.get("CAST_STREAM_PLAYOUT_MS", "150"))   # búfer de reproducción del receptor
STREAM_KBPS = int(os.environ.get("CAST_STREAM_KBPS", "8000"))
MIRROR_BACKEND = os.environ.get("CAST_MIRROR_BACKEND", "auto")   # auto | cast-streaming | hls
PREFS_PATH = os.path.expanduser("~/.config/caelestia/cast-mirror.json")
VIRT_PATH = os.path.join(WORK_DIR, "virtual.json")
VIRT_OUT = "CAST-1"
QUALITY_SIZE = {"720p": (1280, 720), "1080p": (1920, 1080)}
DEFAULT_PREFS = {"source": "monitor", "quality": "auto", "encoder": "auto", "audio": True}


def stream_available():
    return os.access(CAST_SENDER, os.X_OK)


def load_prefs():
    p = dict(DEFAULT_PREFS)
    try:
        with open(PREFS_PATH) as f:
            for k, v in json.load(f).items():
                if k in p:
                    p[k] = v
    except Exception:  # noqa: BLE001
        pass
    return p


def save_prefs(**kw):
    p = load_prefs()
    p.update({k: v for k, v in kw.items() if v is not None})
    try:
        os.makedirs(os.path.dirname(PREFS_PATH), exist_ok=True)
        atomic_write(PREFS_PATH, json.dumps(p, ensure_ascii=False, indent=1))
    except Exception:  # noqa: BLE001
        log.warning("no se pudo guardar %s", PREFS_PATH)
    return p


def power_state():
    """{ac: bool, profile: power-saver|balanced|performance|None}."""
    ac = None
    for d in glob.glob("/sys/class/power_supply/*"):
        try:
            with open(os.path.join(d, "type")) as f:
                if f.read().strip() != "Mains":
                    continue
            with open(os.path.join(d, "online")) as f:
                ac = (ac or False) or f.read().strip() == "1"
        except OSError:
            pass
    prof = None
    try:
        prof = subprocess.run(["powerprofilesctl", "get"], capture_output=True, text=True, timeout=3).stdout.strip() or None
    except Exception:  # noqa: BLE001
        pass
    return {"ac": True if ac is None else ac, "profile": prof}


def encoder_auto(power):
    """nvidia (h264_nvenc) con corriente y perfil distinto de ahorro; si no, cpu (VP8)."""
    return "nvidia" if power["ac"] and power["profile"] != "power-saver" else "cpu"


def resolve_encoder(mode, power, quality=None):
    # NVENC a 1080p: ~28 fps pero >90 % de fotogramas tardíos (medido 2026-11-09); VP8 por CPU va fluido.
    if mode not in ("cpu", "nvidia") and quality == "1080p":
        return "cpu"
    return mode if mode in ("cpu", "nvidia") else encoder_auto(power)


def resolve_quality(q, enc):
    # auto = 720p: en las pruebas, 1080p con NVENC no mantuvo 28 fps ni pocos tardíos (ver docs); 1080p solo si se pide.
    return q if q in QUALITY_SIZE else "720p"


def hypr_json(what):
    ensure_desktop_env()
    try:
        return json.loads(subprocess.run(["hyprctl", "-j", what], capture_output=True, text=True, timeout=5).stdout or "[]")
    except Exception:  # noqa: BLE001
        return []


def hypr_move_ws(ws, mon):
    subprocess.run(["hyprctl", "dispatch", f"hl.dsp.workspace.move({{workspace={ws}, monitor='{mon}'}})"],
                   capture_output=True, timeout=5)


def hypr_focus_ws(ws):
    subprocess.run(["hyprctl", "dispatch", f"hl.dsp.focus({{workspace={ws}}})"], capture_output=True, timeout=5)


def hypr_wake():
    """Enciende la pantalla SOLO si está apagada (con DPMS off no hay nada que capturar). Un `dpms on` con la
    pantalla ya encendida reconfigura la salida un instante y gpu-screen-recorder no encuentra el monitor
    («display "eDP-2" not found»): fallaba ~2 de cada 3 arranques. Tras encender, esperar a que se asiente."""
    try:
        if all(m.get("dpmsStatus", True) for m in real_monitors()):
            return
        subprocess.run(["hyprctl", "dispatch", 'hl.dsp.dpms("on")'], capture_output=True, timeout=2)
        for _ in range(20):
            time.sleep(0.1)
            if all(m.get("dpmsStatus", True) for m in real_monitors()):
                break
        time.sleep(1.5)
    except Exception:  # noqa: BLE001
        pass


def real_monitors():
    return [m for m in hypr_json("monitors") if not m["name"].startswith("CAST-")]


def mirror_options():
    ensure_desktop_env()
    mons = [{"name": m["name"], "width": m["width"], "height": m["height"], "focused": bool(m.get("focused"))}
            for m in real_monitors()]
    wss = [{"id": w["id"], "name": w["name"], "monitor": w.get("monitor"), "windows": w.get("windows", 0)}
           for w in hypr_json("workspaces") if isinstance(w.get("id"), int) and w["id"] > 0
           and w.get("monitor") and not w["monitor"].startswith("CAST-")]
    wins = [{"address": c["address"], "title": c.get("title", ""), "class": c.get("class", ""),
             "workspace": (c.get("workspace") or {}).get("id")}
            for c in hypr_json("clients") if c.get("mapped", True) and (c.get("workspace") or {}).get("id", 0) > 0]
    pw = power_state()
    pr = load_prefs()
    return {"ok": True, "monitors": mons, "workspaces": wss, "windows": wins, "power": pw,
            "encoder_auto": encoder_auto(pw),
            "defaults": {"quality": pr["quality"], "encoder": pr["encoder"], "audio": bool(pr["audio"])}}


class VirtualOutput:
    """Salida headless de Hyprland (CAST-1) para duplicar un workspace o extender el escritorio.
    Guarda en virtual.json lo movido para restaurarlo aunque el daemon se caiga."""

    def __init__(self):
        self.moved = []
        self.focus = None
        self.active = False

    def _save(self):
        try:
            atomic_write(VIRT_PATH, json.dumps({"output": VIRT_OUT, "moved": self.moved, "focus": self.focus}))
        except Exception:  # noqa: BLE001
            pass

    def create(self):
        mons = hypr_json("monitors")
        f = next((m for m in mons if m.get("focused")), None)
        if f:
            self.focus = {"monitor": f["name"], "ws": f["activeWorkspace"]["id"]}
        if not any(m["name"] == VIRT_OUT for m in mons):
            subprocess.run(["hyprctl", "output", "create", "headless", VIRT_OUT], capture_output=True, timeout=5)
        for _ in range(30):
            if any(m["name"] == VIRT_OUT for m in hypr_json("monitors")):
                break
            time.sleep(0.1)
        else:
            raise RuntimeError("Hyprland no creó la salida virtual")
        self.active = True
        self._save()

    def attach_workspace(self, ws):
        info = next((w for w in hypr_json("workspaces") if w.get("id") == ws), None)
        if info is None:
            raise ValueError(f"el workspace {ws} no existe")
        self.moved.append({"ws": ws, "monitor": info["monitor"]})
        self._save()
        hypr_move_ws(ws, VIRT_OUT)

    def extend_workspace(self):
        for _ in range(20):
            w = next((w for w in hypr_json("workspaces") if w.get("monitor") == VIRT_OUT), None)
            if w:
                return w["id"]
            time.sleep(0.1)
        return None

    def release(self):
        if not self.active:
            return
        self.active = False
        restore_virtual({"moved": self.moved, "focus": self.focus})
        try:
            os.unlink(VIRT_PATH)
        except OSError:
            pass


def restore_virtual(st):
    """Devuelve los workspaces a su monitor, restaura el foco y borra las salidas CAST-*."""
    names = {m["name"] for m in hypr_json("monitors")}
    for it in reversed(st.get("moved") or []):
        if it["monitor"] in names and any(w.get("id") == it["ws"] and w.get("monitor", "").startswith("CAST-")
                                          for w in hypr_json("workspaces")):
            hypr_move_ws(it["ws"], it["monitor"])
    # cualquier workspace con ventanas que aún cuelgue de una CAST-* vuelve al monitor real principal
    real = [m["name"] for m in real_monitors()]
    if real:
        for w in hypr_json("workspaces"):
            if str(w.get("monitor", "")).startswith("CAST-") and w.get("windows", 0) > 0 and isinstance(w.get("id"), int):
                hypr_move_ws(w["id"], real[0])
    fo = st.get("focus")
    if fo and fo["monitor"] in names:
        hypr_focus_ws(fo["ws"])
    for n in sorted(names):
        if n.startswith("CAST-"):
            subprocess.run(["hyprctl", "output", "remove", n], capture_output=True, timeout=5)


def cleanup_orphan_virtual():
    """Al arrancar el daemon: si quedó una salida CAST-* de una sesión anterior, restaurar."""
    try:
        if not any(m["name"].startswith("CAST-") for m in hypr_json("monitors")) and not os.path.exists(VIRT_PATH):
            return
        st = {}
        try:
            with open(VIRT_PATH) as f:
                st = json.load(f)
        except Exception:  # noqa: BLE001
            pass
        log.warning("restaurando salida virtual huérfana")
        restore_virtual(st)
        try:
            os.unlink(VIRT_PATH)
        except OSError:
            pass
    except Exception:  # noqa: BLE001
        log.exception("limpieza de salidas virtuales")


def intel_render_node():
    for n in sorted(glob.glob("/sys/class/drm/renderD*")):
        try:
            with open(os.path.join(n, "device/vendor")) as f:
                if f.read().strip() == "0x8086":
                    return "/dev/dri/" + os.path.basename(n)
        except OSError:
            pass
    return "/dev/dri/renderD128"


def default_monitor_source():
    try:
        sink = subprocess.run(["pactl", "get-default-sink"], capture_output=True, text=True, timeout=4).stdout.strip()
        return sink + ".monitor" if sink else "@DEFAULT_MONITOR@"
    except Exception:  # noqa: BLE001
        return "@DEFAULT_MONITOR@"


def build_stream_cmds(source, host, port, audio_fifo, quality, encoder):
    """captura (gpu-screen-recorder | wf-recorder para salida virtual) -> ffmpeg (SPS/PPS en cada keyframe)
    -> cast_sender (stdin = mpegts). source = (tipo, valor): monitor/NAME, virtual/CAST-1, window/None."""
    w, h = QUALITY_SIZE[quality]
    kind, val = source
    if kind == "virtual":
        cap = ["wf-recorder", "-y", "-o", val, "-c", "h264_vaapi", "-d", intel_render_node(), "-D", "-r", str(MIRROR_FPS),
               "-F", f"scale_vaapi=w={w}:h={h}:format=nv12", "-p", "low_power=1", "-p", "bf=0",
               "-p", f"g={MIRROR_FPS // 2}", "-p", f"b={MIRROR_KBPS * 1000}", "-m", "mpegts", "-f", "/dev/stdout"]
    elif kind == "monitor" and shutil.which("gpu-screen-recorder"):
        cap = ["gpu-screen-recorder", "-w", val, "-f", str(MIRROR_FPS),
               "-c", "mpegts", "-k", "h264", "-bm", "cbr", "-q", str(MIRROR_KBPS), "-keyint", "0.5", "-cursor", "yes",
               "-fm", "cfr", "-ffmpeg-video-opts", "tune=ull;zerolatency=1;rc-lookahead=0;bf=0;delay=0",
               "-s", f"{w}x{h}", "-o", "/dev/stdout"]
    elif kind == "monitor":
        cap = ["wf-recorder", "-y", "-o", val, "-c", "h264_vaapi", "-d", intel_render_node(), "-D", "-r", str(MIRROR_FPS),
               "-F", f"scale_vaapi=w={w}:h={h}:format=nv12", "-p", "low_power=1", "-p", "bf=0",
               "-p", f"g={MIRROR_FPS // 2}", "-p", f"b={MIRROR_KBPS * 1000}", "-m", "mpegts", "-f", "/dev/stdout"]
    else:
        cap = ["gpu-screen-recorder", "-w", "portal", "-f", str(MIRROR_FPS),
               "-c", "mpegts", "-k", "h264", "-bm", "cbr", "-q", str(MIRROR_KBPS), "-keyint", "0.5", "-cursor", "yes",
               "-fm", "cfr", "-ffmpeg-video-opts", "tune=ull;zerolatency=1;rc-lookahead=0;bf=0;delay=0",
               "-s", f"{w}x{h}", "-o", "/dev/stdout"]
    ff = ["ffmpeg", "-nostdin", "-loglevel", "error", "-fflags", "nobuffer+flush_packets", "-flags", "low_delay",
          "-probesize", "32768", "-analyzeduration", "0", "-f", "mpegts", "-i", "pipe:0", "-c:v", "copy",
          "-bsf:v", "dump_extra=freq=keyframe", "-an", "-muxdelay", "0", "-muxpreload", "0",
          "-flush_packets", "1", "-f", "mpegts", "pipe:1"]
    codec = "h264" if encoder == "nvidia" else "vp8"
    snd = [CAST_SENDER, "-n", "-c", codec, "-m", str(STREAM_KBPS * 1000), f"{host}:{port}", "pipe:0"]
    env = dict(os.environ, CAST_LIVE="1", CAST_PLAYOUT_MS=str(STREAM_PLAYOUT_MS), CAST_INFLIGHT_MS="300")
    if encoder == "nvidia":
        env["CAST_ENCODER"] = "h264_nvenc"
    else:
        env.pop("CAST_ENCODER", None)
    aud = None
    if audio_fifo:
        env["CAST_AUDIO_PATH"] = audio_fifo
        aud = ["ffmpeg", "-y", "-nostdin", "-loglevel", "error", "-fflags", "nobuffer", "-f", "pulse",
               "-i", default_monitor_source(), "-ac", "2", "-ar", "48000", "-c:a", "pcm_s16le",
               "-flush_packets", "1", "-f", "wav", audio_fifo]
    else:
        env["CAST_NO_AUDIO"] = "1"
    return cap, ff, snd, env, aud


def build_ffmpeg_cmd(path, info, audio_index, start):
    v = info["video"]
    cmd = ["ffmpeg", "-nostdin", "-loglevel", "error"]
    if start and start > 0:
        cmd += ["-ss", f"{start:.3f}"]
    cmd += ["-i", path, "-map", f"0:{v['index']}"]
    if audio_index is not None:
        cmd += ["-map", f"0:{audio_index}"]
    cmd += ["-c:v", "copy"]
    if v["codec"] == "hevc":
        cmd += ["-tag:v", "hvc1"]
    if audio_index is not None:
        a = next(x for x in info["audio"] if x["index"] == audio_index)
        if a["codec"] == "aac" and (a.get("channels") or 2) <= 2:
            cmd += ["-c:a", "copy"]
        else:
            cmd += ["-c:a", "aac", "-ac", "2", "-b:a", "256k"]
    cmd += ["-sn", "-dn", "-map_chapters", "-1", "-avoid_negative_ts", "make_zero", "-f", "mp4",
            "-movflags", "frag_keyframe+empty_moov+default_base_moof", "pipe:1"]
    return cmd


def kill_proc(p):
    if p and p.poll() is None:
        try:
            p.terminate()
            try:
                p.wait(2)
            except subprocess.TimeoutExpired:
                p.kill()
                p.wait(2)
        except Exception:
            pass


class MediaServer:
    def __init__(self, port):
        self.port = port
        self.routes = {}
        self.httpd = None
        self.thread = None

    def start(self):
        if self.httpd:
            return
        routes = self.routes

        class Handler(http.server.BaseHTTPRequestHandler):
            protocol_version = "HTTP/1.0"  # sin Content-Length => cierre al terminar

            def log_message(self, fmt, *args):
                log.debug("http %s " + fmt, self.address_string(), *args)

            def _route(self):
                p = urllib.parse.urlparse(self.path).path
                name = p.rsplit("/", 1)[-1]
                rt = routes.get(name)
                if rt is None and re.match(r"^[0-9a-f]+-m\d*\.(ts|m3u8)$", name):
                    f = os.path.join(WORK_DIR, name)
                    if os.path.isfile(f):
                        rt = Route("direct", f, "application/x-mpegURL" if name.endswith("m3u8") else "video/mp2t")
                        rt.nocache = True
                return rt

            def _cors(self):
                self.send_header("Access-Control-Allow-Origin", "*")
                self.send_header("Access-Control-Allow-Headers", "Range, Content-Type")
                self.send_header("Access-Control-Expose-Headers", "Content-Range, Content-Length, Accept-Ranges")

            def do_OPTIONS(self):
                self.send_response(204)
                self._cors()
                self.send_header("Content-Length", "0")
                self.end_headers()

            def do_HEAD(self):
                self._serve(head=True)

            def do_GET(self):
                self._serve(head=False)

            def _serve(self, head):
                rt = self._route()
                if rt is None:
                    self.send_error(404)
                    return
                try:
                    if rt.kind == "direct":
                        self._serve_file(rt, head)
                    elif rt.kind == "proxy":
                        self._serve_proxy(rt, head)
                    elif rt.kind == "sub":
                        self._serve_bytes(rt, head)
                    elif rt.kind == "mirror":
                        self._serve_mirror(rt, head)
                    elif rt.kind == "mirrorhls":
                        self._serve_mirror_hls(rt, head)
                    else:
                        self._serve_transcode(rt, head)
                except (BrokenPipeError, ConnectionResetError):
                    pass

            def _serve_bytes(self, rt, head):
                data = open(rt.path, "rb").read()
                self.send_response(200)
                self.send_header("Content-Type", rt.mime)
                self.send_header("Content-Length", str(len(data)))
                self._cors()
                self.end_headers()
                if not head:
                    self.wfile.write(data)

            def _serve_proxy(self, rt, head):
                headers = {}
                rng = self.headers.get("Range")
                if rng:
                    headers["Range"] = rng
                req = urllib.request.Request(rt.path, headers=headers, method="HEAD" if head else "GET")
                try:
                    resp = urllib.request.urlopen(req, timeout=60)
                except urllib.error.HTTPError as e:
                    self.send_response(e.code)
                    self._cors()
                    self.end_headers()
                    return
                with resp:
                    self.send_response(resp.status)
                    for h in ("Content-Type", "Content-Length", "Content-Range", "Accept-Ranges"):
                        v = resp.headers.get(h)
                        if v:
                            self.send_header(h, v)
                    self.send_header("Cache-Control", "no-store")
                    self._cors()
                    self.end_headers()
                    if head:
                        return
                    while True:
                        chunk = resp.read(65536)
                        if not chunk:
                            break
                        self.wfile.write(chunk)
                        self.wfile.flush()

            def _serve_file(self, rt, head):
                size = os.path.getsize(rt.path)
                start, end, code = 0, size - 1, 200
                rng = self.headers.get("Range")
                if rng:
                    m = re.match(r"bytes=(\d*)-(\d*)", rng.strip())
                    if m and (m.group(1) or m.group(2)):
                        if m.group(1):
                            start = int(m.group(1))
                            if m.group(2):
                                end = min(int(m.group(2)), size - 1)
                        else:
                            start = max(0, size - int(m.group(2)))
                        if start >= size:
                            self.send_response(416)
                            self.send_header("Content-Range", f"bytes */{size}")
                            self._cors()
                            self.end_headers()
                            return
                        code = 206
                length = end - start + 1
                self.send_response(code)
                self.send_header("Content-Type", rt.mime)
                self.send_header("Accept-Ranges", "bytes")
                if getattr(rt, "nocache", False):
                    self.send_header("Cache-Control", "no-store")
                self.send_header("Content-Length", str(length))
                if code == 206:
                    self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
                self._cors()
                self.end_headers()
                if head:
                    return
                with open(rt.path, "rb") as f:
                    f.seek(start)
                    left = length
                    while left > 0:
                        chunk = f.read(min(262144, left))
                        if not chunk:
                            break
                        self.wfile.write(chunk)
                        left -= len(chunk)

            def _serve_mirror_hls(self, rt, head):
                with rt.lock:
                    if not rt.procs or rt.procs[0].poll() is not None:
                        for q in rt.procs:
                            kill_proc(q)
                        for f in glob.glob(os.path.join(WORK_DIR, f"{rt.token}-m*")):
                            try:
                                os.unlink(f)
                            except OSError:
                                pass
                        gcmd, fcmd = build_mirror_cmds(rt.monitor, rt.audio, rt.size, rt.profile, rt.token)
                        log.info("espejo(hls): %s | %s", " ".join(gcmd), " ".join(fcmd))
                        gsr = subprocess.Popen(gcmd, stdout=subprocess.PIPE, stderr=open(os.path.join(WORK_DIR, "mirror-gsr.log"), "wb"))
                        ff = subprocess.Popen(fcmd, stdin=gsr.stdout, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
                        gsr.stdout.close()
                        rt.procs = [ff, gsr]
                pl = os.path.join(WORK_DIR, f"{rt.token}-m.m3u8")
                t0 = time.time()
                while not os.path.isfile(pl) and time.time() - t0 < 8:
                    time.sleep(0.05)
                if not rt.t_first and os.path.isfile(pl):
                    rt.t_first = time.time()
                try:
                    data = open(pl, "rb").read()
                except OSError:
                    self.send_error(503)
                    return
                st = MIRROR_PROFILES.get(rt.profile or DEFAULT_MIRROR_PROFILE, {}).get("start")
                if st and b"#EXTM3U" in data:
                    data = data.replace(b"#EXTM3U\n", b"#EXTM3U\n#EXT-X-START:TIME-OFFSET=" + st.encode() + b",PRECISE=NO\n", 1)
                self.send_response(200)
                self.send_header("Content-Type", "application/x-mpegURL")
                self.send_header("Cache-Control", "no-store")
                self.send_header("Content-Length", str(len(data)))
                self._cors()
                self.end_headers()
                if not head:
                    self.wfile.write(data)

            def _serve_mirror(self, rt, head):
                self.send_response(200)
                self.send_header("Content-Type", "video/mp4")
                self.send_header("Cache-Control", "no-store")
                self._cors()
                self.end_headers()
                if head:
                    return
                with rt.lock:
                    for q in rt.procs:
                        kill_proc(q)  # una sola conexión viva por ruta
                    gcmd, fcmd = build_mirror_cmds(rt.monitor, rt.audio, rt.size, rt.profile, rt.token)
                    log.info("espejo: %s | %s", " ".join(gcmd), " ".join(fcmd))
                    gsr = subprocess.Popen(gcmd, stdout=subprocess.PIPE, stderr=open(os.path.join(WORK_DIR, "mirror-gsr.log"), "wb"))
                    ff = subprocess.Popen(fcmd, stdin=gsr.stdout, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
                    gsr.stdout.close()
                    rt.procs = [ff, gsr]
                try:
                    while True:
                        chunk = ff.stdout.read1(65536)
                        if not chunk:
                            break
                        if not rt.t_first:
                            rt.t_first = time.time()
                        self.wfile.write(chunk)
                        self.wfile.flush()
                finally:
                    kill_proc(gsr)
                    kill_proc(ff)

            def _serve_transcode(self, rt, head):
                self.send_response(200)
                self.send_header("Content-Type", "video/mp4")
                self.send_header("Cache-Control", "no-store")
                self._cors()
                self.end_headers()
                if head:
                    return
                with rt.lock:
                    kill_proc(rt.proc)  # una sola conexión viva por ruta
                    cmd = build_ffmpeg_cmd(rt.path, rt.info, rt.audio, rt.offset)
                    log.info("ffmpeg: %s", " ".join(cmd))
                    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
                    rt.proc = proc
                try:
                    while True:
                        chunk = proc.stdout.read(65536)
                        if not chunk:
                            break
                        self.wfile.write(chunk)
                        self.wfile.flush()
                finally:
                    kill_proc(proc)
                    err = proc.stderr.read().decode(errors="replace").strip() if proc.stderr else ""
                    if err:
                        log.warning("ffmpeg stderr: %s", err[-300:])

        class Server(http.server.ThreadingHTTPServer):
            allow_reuse_address = True
            daemon_threads = True

        try:
            self.httpd = Server(("0.0.0.0", self.port), Handler)
        except OSError as e:
            self.httpd = None
            raise RuntimeError(f"puerto {self.port} ocupado (¿otro catt sirviendo?): {e.strerror}")
        self.thread = threading.Thread(target=self.httpd.serve_forever, daemon=True)
        self.thread.start()

    def add(self, name, route):
        self.routes[name] = route

    def remove(self, name):
        rt = self.routes.pop(name, None)
        if rt is not None and rt.kind == "transcode":
            kill_proc(rt.proc)
        if rt is not None and rt.kind == "mirror":
            for q in rt.procs:
                kill_proc(q)


def port_from_env():
    try:
        return int(os.environ.get("CAST_HELPER_PORT", DEFAULT_PORT))
    except ValueError:
        return DEFAULT_PORT


# ── sesion de reproduccion ───────────────────────────────────────────────────
class Session:
    _counter = 0

    def __init__(self, daemon, dev, source, mode, title):
        Session._counter += 1
        self.n = Session._counter
        self.daemon = daemon
        self.dev = dev
        self.source = source
        self.orig_source = source
        self.mode = mode
        self.title = title
        self.token = secrets.token_hex(6)
        self.state = "BUFFERING"
        self.duration = 0.0
        self.volume = 0
        self.muted = False
        self.subs_label = None
        self.preparing = True
        self.offset = 0.0
        self.status = None
        self.cast = None
        self.seen_active = False
        self.reloading = False
        self.loaded = False
        self.dead = False
        self.route = None
        self.sub_names = []
        self.sub_tracks = []
        self.sub_active = None
        self.audio_active = None
        self.art_path = None
        self.reload_n = 0
        self.info = None
        self.audio_index = None
        self.sub_vtt = None
        self.sub_lang = "es"
        self.ip = None
        self.fake = False
        self.torrent_proc = None
        self.is_torrent = False
        self.is_proxy = False
        self.torrent_req = None
        self.torrent_name = None
        self._torrent_err = None

    # -- estado --
    def position(self):
        if self.status is None:
            return self.offset
        try:
            cur = self.status.adjusted_current_time if self.state == "PLAYING" else self.status.current_time
        except Exception:
            cur = 0.0
        pos = self.offset + (cur or 0.0)
        if self.duration:
            pos = min(pos, self.duration)
        return max(0.0, pos)

    def as_dict(self):
        return {
            "device_uuid": self.dev["uuid"], "device_name": self.dev["name"],
            "title": self.title, "source": self.source, "target": self.orig_source, "mode": self.mode,
            "state": self.state, "position": round(self.position(), 1),
            "duration": round(self.duration, 1), "volume": self.volume,
            "muted": self.muted, "subs": self.subs_label, "preparing": self.preparing,
            "art": self.art_path if self.art_path and os.path.isfile(self.art_path) else None,
            "tracks": self.tracks_dict(),
        }

    def tracks_dict(self):
        """Contrato de pistas (también lo usa Olimpo): subs/audio con n estable."""
        if not self.info or self.mode in ("url", "mirror"):
            return None
        return {
            "subs": [{"n": t["n"], "label": t["label"], "lang": t["meta"].get("lang", ""),
                      "forced": bool(t["meta"].get("forced"))} for t in self.sub_tracks],
            "audio": [{"n": a["index"], "label": audio_label(a), "lang": a.get("lang", ""),
                       "codec": a.get("codec", ""), "channels": a.get("channels") or 0}
                      for a in self.info["audio"]],
            "sub_active": self.sub_active,
            "audio_active": self.audio_active,
        }

    # -- carga --
    def _start_torrent(self):
        # stderr a un fichero: un PIPE sin lector acabaría bloqueando a node al llenarse (64 KiB).
        errlog_path = os.path.join(WORK_DIR, "cast-torrent.err")
        self._torrent_err = open(errlog_path, "w", encoding="utf-8")
        proc = subprocess.Popen(
            ["node", TORRENT_SERVER, self.source],
            stdout=subprocess.PIPE, stderr=self._torrent_err, text=True,
        )
        self.torrent_proc = proc
        deadline = time.monotonic() + 90.0
        line = ""
        while time.monotonic() < deadline:
            if self.dead:
                raise RuntimeError("reproducción cancelada")
            if proc.poll() is not None:
                rem = proc.stdout.read().strip() if proc.stdout else ""
                if rem:
                    line = rem.splitlines()[-1]
                    break
                try:
                    err = open(errlog_path, encoding="utf-8").read().strip()
                except OSError:
                    err = ""
                raise RuntimeError(err.splitlines()[-1] if err else "cast-torrent terminó inesperadamente")
            rlist, _, _ = select.select([proc.stdout], [], [], 0.25)
            if rlist:
                line = proc.stdout.readline().strip()
                if line:
                    break
        if not line:
            raise RuntimeError("tiempo de espera agotado conectando a peers del torrent (90 s)")
        try:
            meta = json.loads(line)
        except Exception as e:
            raise RuntimeError(f"respuesta inválida de cast-torrent: {line}") from e
        if not meta.get("ready"):
            raise RuntimeError(meta.get("error") or "no se pudo abrir el torrent")
        self.source = meta["url"]
        self.torrent_name = meta.get("name") or "Torrent"
        req = self.torrent_req or {}
        if not req.get("title"):
            self.title = clean_title(self.torrent_name)
        status_url = meta.get("statusUrl")
        if status_url:
            buf_deadline = time.monotonic() + 35.0
            last_peers = 0
            while time.monotonic() < buf_deadline:
                if self.dead:
                    raise RuntimeError("reproducción cancelada")
                if proc.poll() is not None:
                    raise RuntimeError("cast-torrent se cerró inesperadamente")
                try:
                    with urllib.request.urlopen(status_url, timeout=2) as r:
                        st = json.loads(r.read().decode())
                    last_peers = int(st.get("peers") or 0)
                    if int(st.get("downloaded") or 0) > 0:
                        break
                except Exception:
                    pass
                time.sleep(0.5)
            else:
                raise RuntimeError(f"el torrent no tiene peers disponibles ({last_peers} conectados)")
        info = probe_file(self.source, external_subs=meta.get("subs") or [])
        return self._configure_probed(info, req, name_hint=self.torrent_name)

    def _configure_probed(self, info, req, name_hint=None):
        aidx = req.get("audio")
        if aidx is None:
            a = default_audio(info["audio"])
            aidx = a["index"] if a else None
        else:
            aidx = int(aidx)
        mode, _, err = plan_playback(self.source, info, aidx, name_hint=name_hint)
        if err:
            raise ValueError(err)
        # Los streams de torrent/Stremio en .mp4 suelen tener el átomo moov al final o audio 5.1,
        # lo que provoca errores o bloqueos de Range en Chromecast en modo directo; remuxear a fMP4 evita ambos.
        if (self.is_torrent or self.is_proxy) and mode == "direct":
            mode = "transcode"
        spec = self.daemon._sub_spec(req, info)
        self.mode = mode
        self.info = info
        self.duration = info["duration"]
        self.audio_index = aidx if mode == "transcode" else None
        self.audio_active = aidx if aidx is not None else (info["audio"][0]["index"] if info["audio"] else None)
        return spec

    def _prepare_local_url(self):
        req = self.torrent_req or {}
        info = probe_file(self.source)
        if not req.get("title"):
            fmt_title = info.get("title")
            self.title = clean_title(fmt_title) if fmt_title else clean_title(self.source.split("?", 1)[0])
        return self._configure_probed(info, req)

    def run_load(self, start, sub_spec):
        try:
            if self.mode == "url":
                self._connect()
                self._load_url(start)
            elif self.mode == "torrent":
                spec = self._start_torrent()
                if self.dead:
                    return
                self._prepare_subs(spec)
                self._connect()
                self._load(start)
            elif self.mode == "local_url":
                spec = self._prepare_local_url()
                if self.dead:
                    return
                self._prepare_subs(spec)
                self._connect()
                self._load(start)
            else:
                self._prepare_subs(sub_spec)
                self._extract_art()
                self._connect()
                self._load(start)
            self.preparing = False
            self.loaded = True
        except Exception as e:  # noqa: BLE001
            log.exception("fallo al preparar/cargar")
            self.daemon.fail(self, f"No se pudo reproducir: {e}")
            return
        self.daemon.publish()

    def _connect(self):
        self.cast = self.daemon.get_cast(self.dev)
        self.cast_listener = _CastListener(self)
        self.cast.media_controller.register_status_listener(self.cast_listener)
        self.cast.register_status_listener(self.cast_listener)
        st = self.cast.status
        if st:
            self.volume = round(st.volume_level * 100)
            self.muted = bool(st.volume_muted)
        self.ip = local_ip_for(self.dev["host"])

    def _prepare_subs(self, spec):
        """Carga TODAS las pistas de texto (incrustadas + externas) como VTT; activa solo la elegida.
        spec: ('none',) | ('embedded', idx, meta) | ('file', path, meta)"""
        self.sub_tracks = []
        self.sub_active = None
        self.subs_label = None
        info = self.info
        if not info:
            return
        texts = [] if (self.is_torrent or self.is_proxy) else [x for x in info["subs"] if x["text"]]
        if texts:
            load_embedded_batch(self.source, [x["index"] for x in texts])
        for x in texts:
            self.sub_tracks.append({"n": x["index"], "kind": "emb", "ref": (self.source, x["index"]), "meta": x})
        for i, e in enumerate(info.get("external_subs_info", [])):
            self.sub_tracks.append({"n": 1000 + i, "kind": "file", "ref": e["path"], "meta": e})
        keep = []
        for t in self.sub_tracks:
            try:
                t["vtt"] = load_full_vtt(t["kind"], t["ref"], None)
            except Exception as e:  # noqa: BLE001
                log.warning("subtítulo %s no cargable: %s", t["n"], e)
                continue
            m = t["meta"]
            t["label"] = lang_label(m.get("lang"), m.get("title", ""), m.get("forced", False))
            lg = m.get("lang") or "es"
            t["lang_code"] = "es" if is_spanish(lg) else (lg if lg else "und")
            keep.append(t)
        self.sub_tracks = keep
        if spec and spec[0] != "none":
            for t in self.sub_tracks:
                if (spec[0] == "embedded" and t["kind"] == "emb" and t["n"] == spec[1]) or \
                   (spec[0] == "file" and t["kind"] == "file" and t["ref"] == spec[1]):
                    self.sub_active = t["n"]
                    self.subs_label = t["label"]
                    self.sub_lang = t["lang_code"]

    def _extract_art(self):
        if not self.info or self.daemon.no_art:
            return
        try:
            at = max(1.0, self.duration * 0.1)
            out = os.path.join(WORK_DIR, f"art-{self.n}.jpg")
            r = subprocess.run(
                ["ffmpeg", "-nostdin", "-loglevel", "error", "-y", "-ss", f"{at:.1f}", "-i", self.source,
                 "-map", f"0:{self.info['video']['index']}", "-frames:v", "1", "-vf", "scale=480:-2", out],
                capture_output=True, timeout=30,
            )
            if r.returncode == 0 and os.path.isfile(out):
                self.art_path = out
        except Exception:  # noqa: BLE001
            pass

    def _write_tracks_for(self, offset):
        """Escribe los VTT de todas las pistas (desplazados por offset) y devuelve MediaTrack."""
        out = []
        for t in self.sub_tracks:
            name = f"{self.token}-s{self.reload_n}-{t['n']}.vtt"
            path = os.path.join(WORK_DIR, name)
            atomic_write(path, shift_vtt(t["vtt"], offset))
            self.daemon.server.add(name, Route("sub", path, "text/vtt; charset=utf-8"))
            self.sub_names.append(name)
            out.append((t, name))
        return out

    def _load(self, start):
        d = self.daemon
        self.reload_n += 1
        self.offset = float(start) if self.mode == "transcode" else 0.0
        mc_start = 0.0 if self.mode == "transcode" else float(start)
        mname = f"{self.token}-m{self.reload_n}.mp4"
        if self.mode == "direct":
            fname = self.torrent_name or self.source
            mime = "video/webm" if fname.lower().endswith(".webm") else "video/mp4"
            rt = Route("proxy" if (self.is_torrent or self.is_proxy) else "direct", self.source, mime)
        else:
            rt = Route("transcode", self.source, "video/mp4", info=self.info, audio=self.audio_index)
            rt.offset = self.offset
        if self.route is not None:
            for k, v in list(d.server.routes.items()):
                if v is self.route:
                    d.server.remove(k)
        d.server.add(mname, rt)
        self.route = rt
        written = self._write_tracks_for(self.offset)
        base = f"http://{self.ip}:{d.server.port}"
        kw = {}
        if written:
            kw["media_info"] = {
                "tracks": [{"trackId": t["n"], "type": "TEXT", "subtype": "SUBTITLES",
                            "trackContentId": f"{base}/{name}", "trackContentType": "text/vtt",
                            "language": t["lang_code"], "name": t["label"]} for t, name in written],
                "textTrackStyle": {"backgroundColor": "#FFFFFF00", "edgeType": "OUTLINE", "edgeColor": "#000000FF"},
            }
        cast = self.cast
        if cast.app_id != APP_MEDIA_RECEIVER:
            cast.start_app(APP_MEDIA_RECEIVER)
        mc = cast.media_controller
        self.reloading = True
        try:
            mc.play_media(
                f"{base}/{mname}", rt.mime if self.mode == "direct" else "video/mp4",
                title=self.title, current_time=mc_start, autoplay=True,
                stream_type="BUFFERED" if self.mode == "direct" else "LIVE", **kw,
            )
            mc.block_until_active(timeout=15)
            if written and self.sub_active is not None:
                try:
                    mc.enable_subtitle(self.sub_active)
                except Exception:  # noqa: BLE001
                    log.warning("no se pudo activar el subtítulo %s", self.sub_active)
        finally:
            self.reloading = False

    def _load_url(self, start=0):
        from catt.api import CattDevice  # type: ignore
        dev = CattDevice(ip_addr=self.dev["host"])
        dev.play_url(self.source, resolve=True, current_time=float(start) if start else None)
        self.cast.media_controller.update_status()

    # -- controles --
    def _need_cast(self):
        if self.cast is None or not self.loaded:
            raise RuntimeError("la reproducción todavía se está preparando")
        return self.cast

    def play(self):
        self._need_cast().media_controller.play()

    def pause(self):
        self._need_cast().media_controller.pause()

    def toggle(self):
        if self.state == "PLAYING":
            self.pause()
        else:
            self.play()

    def seek(self, pos):
        cast = self._need_cast()
        pos = max(0.0, float(pos))
        if self.duration:
            pos = min(pos, max(0.0, self.duration - 1))
        if self.mode == "transcode":
            self._load(pos)
        else:
            cast.media_controller.seek(pos)
        self.daemon.mpris_seeked(pos)

    def set_sub(self, n):
        mc = self._need_cast().media_controller
        if n is None:
            mc.disable_subtitle()
            self.sub_active = None
            self.subs_label = None
        else:
            t = next((x for x in self.sub_tracks if x["n"] == n), None)
            if t is None:
                raise ValueError(f"pista de subtítulos {n} inexistente")
            mc.enable_subtitle(n)
            self.sub_active = n
            self.subs_label = t["label"]

    def set_audio_track(self, n):
        cast = self._need_cast()
        if not self.info or self.mode == "url":
            raise ValueError("no se puede cambiar el audio de este contenido")
        if not any(a["index"] == n for a in self.info["audio"]):
            raise ValueError(f"pista de audio {n} inexistente")
        pos = self.position()
        mode, _reason, err = plan_playback(self.source, self.info, n, name_hint=self.torrent_name)
        if err:
            raise ValueError(err)
        if (self.is_torrent or self.is_proxy) and mode == "direct":
            mode = "transcode"
        self.mode = mode
        self.audio_index = n if mode == "transcode" else None
        self.audio_active = n
        self._load(pos)
        self.daemon.mpris_seeked(pos)

    def set_volume(self, v):
        v = max(0, min(100, int(v)))
        self._need_cast().set_volume(v / 100.0)
        self.volume = v

    def mute(self):
        cast = self._need_cast()
        cast.set_volume_muted(not self.muted)

    def stop(self):
        cast = self.cast
        if cast is not None:
            try:
                cast.media_controller.stop()
            except Exception:  # noqa: BLE001
                pass
            try:
                cast.quit_app()
            except Exception:  # noqa: BLE001
                pass

    def cleanup(self):
        """Limpia rutas/ficheros (no toca el Chromecast)."""
        self.dead = True
        if self.torrent_proc is not None:
            kill_proc(self.torrent_proc)
            self.torrent_proc = None
            try:
                self._torrent_err.close()
            except Exception:  # noqa: BLE001
                pass
        rt = self.route
        if rt is not None and getattr(rt, "procs", None):      # espejo HLS: no dejar gsr/ffmpeg huérfanos
            for q in rt.procs:
                try:
                    q.terminate()
                except Exception:  # noqa: BLE001
                    pass
        srv = self.daemon.server
        for k, v in list(srv.routes.items()):
            if v is self.route or k in self.sub_names:
                srv.remove(k)
        for n in self.sub_names:
            try:
                os.unlink(os.path.join(WORK_DIR, n))
            except OSError:
                pass
        if self.art_path:
            try:
                os.unlink(self.art_path)
            except OSError:
                pass
        if self.cast is not None:
            try:
                self.cast.media_controller._status_listeners.remove(self.cast_listener)
            except Exception:  # noqa: BLE001
                pass
            try:
                self.cast.socket_client.receiver_controller._status_listeners.remove(self.cast_listener)
            except Exception:  # noqa: BLE001
                pass


class _CastListener:
    """Escucha estado de media y del receptor (volumen/app) de una sesion."""

    def __init__(self, sess):
        self.s = sess

    # media
    def new_media_status(self, st):
        s = self.s
        if s.dead or s.reloading:
            return
        ps = st.player_state
        if ps == "IDLE":
            if not s.seen_active:
                return
            reason = st.idle_reason
            err = "El Chromecast encontró un error al reproducir" if reason == "ERROR" else None
            s.daemon.end_session(s, error=err)
            return
        if ps == "UNKNOWN":
            return
        s.seen_active = True
        s.status = st
        s.state = ps
        if s.mode != "transcode" and st.duration:
            s.duration = float(st.duration)
        if s.mode == "url":
            md = st.media_metadata or {}
            if md.get("title"):
                s.title = md["title"]
            if st.duration:
                s.duration = float(st.duration)
        s.volume = round(st.volume_level * 100)
        s.muted = bool(st.volume_muted)
        s.daemon.publish()

    def load_media_failed(self, queue_item_id, error_code):
        s = self.s
        if not s.dead:
            s.daemon.fail(s, f"El Chromecast no pudo cargar el medio (código {error_code})")

    # receptor
    def new_cast_status(self, status):
        s = self.s
        if s.dead or not status:
            return
        s.volume = round(status.volume_level * 100)
        s.muted = bool(status.volume_muted)
        if s.loaded and not s.reloading and s.mode != "mirror" and status.app_id != APP_MEDIA_RECEIVER:
            s.daemon.end_session(s, error=None)
            return
        s.daemon.publish()


class MirrorSession(Session):
    """Duplicar pantalla: captura de una salida (gpu-screen-recorder) emitida en vivo al Chromecast."""

    def __init__(self, daemon, dev, monitor, audio, size, profile=None):
        super().__init__(daemon, dev, monitor, "mirror", f"Duplicando pantalla · {monitor}")
        self.profile = profile or DEFAULT_MIRROR_PROFILE
        self.monitor = monitor
        self.audio = audio
        self.size = size
        self.preparing = True

    def as_dict(self):
        d = super().as_dict()
        d.update(monitor=self.monitor, audio=self.audio, position=0, duration=0,
                 profile=self.profile, backend="hls", latency=self.latency())
        return d

    def latency(self):
        """Estimación: tiempo desde que salió el primer dato - posición reproducida por el receptor."""
        rt = self.route
        if rt is None or not rt.t_first or self.status is None or self.state != "PLAYING":
            return None
        try:
            cur = self.status.adjusted_current_time
        except Exception:  # noqa: BLE001
            return None
        return round((time.time() - rt.t_first) - (cur or 0.0) + LATENCY_CAL, 2)

    def run_load(self, start, sub_spec):
        try:
            self._connect()
            self._load_mirror()
            self.preparing = False
            self.loaded = True
        except Exception as e:  # noqa: BLE001
            log.exception("fallo al iniciar el espejo")
            self.daemon.fail(self, f"No se pudo duplicar la pantalla: {e}")
            return
        self.daemon.publish()

    def _load_mirror(self):
        d = self.daemon
        self.reload_n += 1
        hls = MIRROR_PROFILES.get(self.profile, {}).get("hls")
        name = f"{self.token}-mirror{self.reload_n}.mp4" if not hls else f"{self.token}-mirrorhls{self.reload_n}.m3u8"
        rt = Route("mirrorhls" if hls else "mirror", self.monitor, "video/mp4")
        rt.monitor, rt.audio, rt.size = self.monitor, self.audio, self.size
        rt.profile = self.profile
        rt.token = f"{self.token}{self.reload_n}"
        if hls:
            rt.token = f"{self.token}{self.reload_n}"
            # el playlist real se escribe como <token>-m.m3u8 y se sirve por el fallback; el nombre registrado lo redirige
            name = f"{rt.token}-m.m3u8"
        if self.route is not None:
            for k, v in list(d.server.routes.items()):
                if v is self.route:
                    d.server.remove(k)
        d.server.add(name, rt)
        self.route = rt
        hls_now = bool(hls)
        cast = self.cast
        if cast.app_id != APP_MEDIA_RECEIVER:
            cast.start_app(APP_MEDIA_RECEIVER)
        mc = cast.media_controller
        self.reloading = True
        try:
            ctype = "application/x-mpegURL" if hls_now else "video/mp4"
            mc.play_media(f"http://{self.ip}:{d.server.port}/{name}", ctype, title=self.title,
                          autoplay=True, stream_type="LIVE")
            mc.block_until_active(timeout=20)
        finally:
            self.reloading = False

    def set_audio(self, on):
        if bool(on) == self.audio:
            return
        self.audio = bool(on)
        self._load_mirror()

    def seek(self, pos):
        raise RuntimeError("no se puede mover el tiempo al duplicar la pantalla")


class CastStreamSession(Session):
    """Duplicar pantalla por Cast Streaming (openscreen): UDP/RTP en vivo, ~0,15-0,3 s, con audio.
    Fuentes: monitor | workspace (salida virtual) | extend (escritorio extendido) | window (portal)."""

    def __init__(self, daemon, dev, source, quality, encoder, audio):
        self.source = source           # "monitor:eDP-2" | "workspace:3" | "extend" | "window"
        self.kind = source.split(":")[0]
        self.monitor = source.split(":", 1)[1] if self.kind == "monitor" else self.kind
        super().__init__(daemon, dev, source, "mirror", f"Duplicando pantalla · {self.monitor}")
        self.source = source
        self.quality_mode = quality
        self.encoder_mode = encoder
        self.audio = bool(audio)
        self.want_audio = self.audio
        self.size = None
        self.restart = False
        self.procs = []
        self.stopping = False
        self.virt = None
        self.t_stream = 0.0
        self.attempt = 0
        self.plock = threading.Lock()   # protege procs/starting frente a set_options desde otro hilo
        self.starting = False
        self.capture_lost = False
        self.power = power_state()
        self.enc = resolve_encoder(encoder, self.power, quality)
        self.qual = resolve_quality(quality, self.enc)

    def as_dict(self):
        d = super().as_dict()
        d.update(monitor=self.monitor, audio=self.audio, position=0, duration=0,
                 profile="cast-streaming", backend="cast-streaming", source=self.source,
                 quality=self.qual, quality_mode=self.quality_mode, encoder=self.enc,
                 encoder_mode=self.encoder_mode, power=self.power,
                 latency=round(STREAM_PLAYOUT_MS / 1000.0 + 0.15, 2) if self.state == "PLAYING" else None)
        return d

    # -- procesos --
    def _kill_all(self):
        procs, self.procs = self.procs, []
        for p in reversed(procs):          # primero el emisor: avisa al receptor de que se acaba
            if p.poll() is None:
                try:
                    os.killpg(p.pid, signal.SIGTERM)
                except OSError:
                    try:
                        p.terminate()
                    except OSError:
                        pass
        deadline = time.time() + 3
        for p in procs:
            try:
                p.wait(timeout=max(0.1, deadline - time.time()))
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(p.pid, signal.SIGKILL)
                except OSError:
                    try:
                        p.kill()
                    except OSError:
                        pass
                try:
                    p.wait(timeout=1)
                except Exception:  # noqa: BLE001
                    pass

    def _prepare_source(self):
        """Devuelve (tipo, valor) para build_stream_cmds; crea la salida virtual si hace falta."""
        if self.kind == "monitor":
            return ("monitor", self.monitor)
        if self.kind == "window":
            return ("window", None)
        if self.virt is None:
            self.virt = VirtualOutput()
            self.virt.create()
            if self.kind == "workspace":
                self.virt.attach_workspace(int(self.source.split(":")[1]))
        return ("virtual", VIRT_OUT)

    def _request_restart(self):
        """Reconectar con los valores nuevos. Si la tubería está arrancando no se toca: run_load lo verá al
        terminar el arranque (matarla a medias dejaba al emisor leyendo una tubería muerta)."""
        with self.plock:
            self.restart = True
            if not self.starting:
                self._kill_all()

    def _watch_capture(self, snd, caps):
        """Si la captura muere con el emisor vivo, el emisor no sale solo (se queda sin vídeo y la sesión
        parece activa): se le mata para que run_load reintente."""
        while snd.poll() is None:
            if any(c.poll() is not None for c in caps):
                if not (self.dead or self.stopping or self.restart):
                    log.warning("la captura se cerró (%s); reintentando", [c.poll() for c in caps])
                    self.capture_lost = True
                try:
                    os.killpg(snd.pid, signal.SIGTERM)
                except OSError:
                    pass
                return
            time.sleep(0.5)

    def _start_pipeline(self):
        with self.plock:
            self.starting = True
        try:
            return self._start_pipeline_inner()
        finally:
            with self.plock:
                self.starting = False

    def _start_pipeline_inner(self):
        import select
        hypr_wake()
        self.power = power_state()
        self.enc = resolve_encoder(self.encoder_mode, self.power, self.quality_mode)
        self.qual = resolve_quality(self.quality_mode, self.enc)
        src = self._prepare_source()
        fifo = None
        if self.audio:
            fifo = os.path.join(WORK_DIR, f"{self.token}-a.fifo")
            try:
                os.unlink(fifo)
            except OSError:
                pass
            os.mkfifo(fifo)
        cap_c, ff_c, snd_c, env, aud_c = build_stream_cmds(src, self.dev["host"], self.dev.get("port") or 8009,
                                                           fifo, self.qual, self.enc)
        caplog = open(os.path.join(WORK_DIR, "capture.log"), "ab")     # diagnóstico: por qué muere la captura
        caplog.write(f"\n--- {time.strftime('%H:%M:%S')} {' '.join(cap_c)}\n".encode())
        caplog.flush()
        cap = subprocess.Popen(cap_c, stdout=subprocess.PIPE, stderr=caplog, start_new_session=True)
        ff = subprocess.Popen(ff_c, stdin=cap.stdout, stdout=subprocess.PIPE, stderr=caplog,
                              start_new_session=True)
        cap.stdout.close()
        caplog.close()
        self.procs = [cap, ff]
        # el emisor sondea el flujo al abrirlo: esperar a que ya salgan datos (el selector de ventana puede tardar)
        r, _, _ = select.select([ff.stdout], [], [], 90 if self.kind == "window" else 12)
        if not r:
            raise RuntimeError("la captura de pantalla no produce vídeo")
        if cap.poll() is not None or ff.poll() is not None:
            raise RuntimeError("la captura de pantalla se cerró al arrancar")
        procs = [cap, ff]
        if aud_c:       # el emisor abre el FIFO al arrancar; ffmpeg escribe en cuanto haya lector
            procs.append(subprocess.Popen(aud_c, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                          start_new_session=True))
        snd = subprocess.Popen(snd_c, stdin=ff.stdout, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                               env=env, start_new_session=True)
        ff.stdout.close()
        with self.plock:
            self.procs = procs + [snd]
        threading.Thread(target=self._watch_capture, args=(snd, [cap, ff]), daemon=True).start()
        return snd

    def _watch_power(self):
        """Sondeo de 5 s: si cambia el encoder 'auto' (AC / perfil de energía), reconecta."""
        while not (self.dead or self.stopping):
            time.sleep(5)
            if self.dead or self.stopping or not self.loaded:
                continue
            pw = power_state()
            if pw != self.power:
                self.power = pw
                self.daemon.publish()
                if self.encoder_mode == "auto" and resolve_encoder("auto", pw, self.quality_mode) != self.enc:
                    log.info("cambio de energía %s: el encoder pasa a %s", pw, resolve_encoder("auto", pw, self.quality_mode))
                    self._request_restart()

    def _sync_cast_bg(self):
        try:
            self.cast = self.daemon.get_cast(self.dev)
            self.cast_listener = _CastListener(self)
            self.cast.register_status_listener(self.cast_listener)
            st = self.cast.status
            if st:
                self.volume = round(st.volume_level * 100)
                self.muted = bool(st.volume_muted)
                self.daemon.publish()
        except Exception as e:  # noqa: BLE001
            log.warning("no se pudo enlazar volumen de Chromecast: %s", e)

    def run_load(self, start, sub_spec):
        threading.Thread(target=self._watch_power, daemon=True).start()
        threading.Thread(target=self._sync_cast_bg, daemon=True).start()
        try:
            self.ip = local_ip_for(self.dev["host"])
            attempt = 0
            while attempt < 3:
                attempt += 1
                self.attempt = attempt
                try:
                    snd = self._start_pipeline()
                except RuntimeError as e:      # la captura no arrancó: reintentar antes de rendirse
                    self._kill_all()
                    if self.dead or self.stopping:
                        return
                    log.warning("arranque de la captura fallido (intento %d): %s", attempt, e)
                    if attempt >= 3:
                        raise
                    time.sleep(1.0)
                    continue
                if self.restart:        # llegó un cambio mientras arrancaba
                    self._kill_all()
                t0 = time.time()
                streaming = False
                for raw in iter(snd.stdout.readline, b""):
                    line = raw.decode("utf-8", "replace")
                    if "Streaming to" in line and not streaming:
                        streaming = True
                        self.t_stream = time.time()
                        self.state = "PLAYING"
                        self.preparing = False
                        self.loaded = True
                        self.seen_active = True
                        self.daemon.publish()
                    elif "Last reported statistics" in line:
                        m = re.search(r'"video_statistics":\{[^}]*', line)
                        if m:
                            g = lambda k: (re.search(r'"%s":([0-9.]+)' % k, m.group(0)) or [0, "?"])[1]  # noqa: E731
                            log.info("cast-streaming: e2e %s ms, fps %s, tardíos %s de %s", g("AvgEndToEndLatencyMs"),
                                     g("EnqueueFps"), g("NumLateFrames"), g("NumFramesCaptured"))
                    elif "ERROR" in line:
                        log.warning("cast_sender: %s", line.strip()[:200])
                snd.wait()
                if self.dead or self.stopping:
                    return
                self._kill_all()
                if self.restart:        # cambio de audio/calidad/encoder: reconectar sin contar como fallo
                    self.restart = False
                    self.state, self.preparing = "BUFFERING", True
                    self.daemon.publish()
                    time.sleep(1.0)
                    attempt = 0
                    continue
                if self.capture_lost:   # la captura murió: reintento (cuenta como intento)
                    self.capture_lost = False
                    self.state, self.preparing = "BUFFERING", True
                    self.daemon.publish()
                    time.sleep(1.0)
                    continue
                if streaming:      # sesión viva que terminó (parada en la tele / red)
                    self.daemon.end_session(self, error=None)
                    return
                log.warning("cast_sender terminó sin llegar a emitir (intento %d, %.1fs)", attempt, time.time() - t0)
                time.sleep(1.0)
            raise RuntimeError("el emisor Cast Streaming no arrancó")
        except Exception as e:  # noqa: BLE001
            if self.dead or self.stopping:
                return
            log.exception("Cast Streaming falló")
            self._kill_all()
            if self.kind == "monitor":
                self.daemon.fallback_hls(self, why=str(e))
            else:
                self.daemon.fail(self, f"No se pudo duplicar la pantalla: {e}")

    def set_options(self, quality=None, encoder=None, audio=None):
        ch = False
        if quality is not None and quality != self.quality_mode:
            self.quality_mode, ch = quality, True
        if encoder is not None and encoder != self.encoder_mode:
            self.encoder_mode, ch = encoder, True
        if audio is not None and bool(audio) != self.audio:
            self.audio, ch = bool(audio), True
        save_prefs(quality=self.quality_mode, encoder=self.encoder_mode, audio=self.audio)
        if ch:
            self._request_restart()     # run_load reconecta con los nuevos valores
        self.daemon.publish()

    def set_audio(self, on):
        self.set_options(audio=bool(on))

    def seek(self, pos):
        raise RuntimeError("no se puede mover el tiempo al duplicar la pantalla")

    def play(self):
        raise RuntimeError("no se puede pausar el espejo")

    pause = play

    def _need_cast(self):
        if self.cast is None:
            self.cast = self.daemon.get_cast(self.dev)
        return self.cast

    def _release_virtual(self):
        if self.virt is not None:
            v, self.virt = self.virt, None
            try:
                v.release()
            except Exception:  # noqa: BLE001
                log.exception("restaurar salida virtual")

    def stop(self):
        self.stopping = True
        self._kill_all()
        self._release_virtual()
        super().stop()   # cast.quit_app() si hay conexión (el emisor ya cerró la app)

    def cleanup(self):
        self.stopping = True
        self._kill_all()
        self._release_virtual()
        super().cleanup()


class FakeSession(Session):
    """Sesion ficticia (pruebas): no toca ningun Chromecast."""

    def __init__(self, daemon):
        dev = {"uuid": "fake-0000", "name": "Prueba", "model": "Fake", "host": "127.0.0.1"}
        super().__init__(daemon, dev, "/fake/pelicula.mkv", "transcode", "Película de prueba")
        self.fake = True
        self.state = "PAUSED"
        self.duration = 600.0
        self.volume = 40
        self.preparing = False
        self.loaded = True
        self._pos = 12.0
        self._t = time.time()

    def position(self):
        if self.state == "PLAYING":
            now = time.time()
            self._pos = min(self.duration, self._pos + now - self._t)
            self._t = now
        else:
            self._t = time.time()
        return self._pos

    def _set(self, state):
        self.position()
        self.state = state
        self.daemon.publish()

    def play(self):
        self._set("PLAYING")

    def pause(self):
        self._set("PAUSED")

    def seek(self, pos):
        self._pos = max(0.0, min(self.duration, float(pos)))
        self._t = time.time()
        self.daemon.publish()
        self.daemon.mpris_seeked(self._pos)

    def set_volume(self, v):
        self.volume = max(0, min(100, int(v)))
        self.daemon.publish()

    def mute(self):
        self.muted = not self.muted
        self.daemon.publish()

    def stop(self):
        pass



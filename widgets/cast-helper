class Daemon:
    def __init__(self):
        self.lock = threading.RLock()
        self.cmd_lock = threading.RLock()
        self.active = None
        self.error = None
        self.devices = {}      # uuid -> dict(uuid,name,model,host,port)
        self.cast_info = {}    # uuid -> CastInfo (mDNS vivo)
        self.casts = {}        # uuid -> Chromecast
        self.server = MediaServer(port_from_env())
        self.browser = None
        self.zc = None
        self.mpris = None
        self.no_art = False
        self.monitors = []
        self._stop = threading.Event()
        self._load_cache()

    # -- dispositivos --
    def _load_cache(self):
        try:
            for d in json.load(open(CACHE_PATH, encoding="utf-8")):
                self.devices[d["uuid"]] = d
        except Exception:  # noqa: BLE001
            pass

    def _save_cache(self):
        try:
            atomic_write(CACHE_PATH, json.dumps(list(self.devices.values()), ensure_ascii=False, indent=1))
        except Exception:  # noqa: BLE001
            log.exception("cache de dispositivos")

    def start_discovery(self):
        import pychromecast
        from pychromecast.discovery import AbstractCastListener, CastBrowser, create_zeroconf
        d = self

        class L(AbstractCastListener):
            def add_cast(self, uuid, service):
                d._on_device(uuid)

            def update_cast(self, uuid, service):
                d._on_device(uuid)

            def remove_cast(self, uuid, service, cast_info):
                pass  # mantenemos el ultimo host conocido

        self.zc = create_zeroconf()
        self.browser = CastBrowser(L(), self.zc)
        self.browser.start_discovery()
        self._pychromecast = pychromecast

    def _on_device(self, uuid):
        info = self.browser.devices.get(uuid)
        if not info:
            return
        self.cast_info[str(uuid)] = info
        rec = {"uuid": str(uuid), "name": info.friendly_name or info.host,
               "model": info.model_name or "", "host": info.host, "port": info.port or 8009}
        if self.devices.get(rec["uuid"]) != rec:
            self.devices[rec["uuid"]] = rec
            self._save_cache()
        self.publish()

    def device_list(self):
        return sorted(self.devices.values(), key=lambda x: x["name"])

    def find_device(self, key):
        key_l = key.lower()
        if key in self.devices:
            return self.devices[key]
        for d in self.devices.values():
            if d["name"].lower() == key_l:
                return d
        for d in self.devices.values():
            if key_l in d["name"].lower() or d["uuid"].startswith(key_l):
                return d
        return None

    def get_cast(self, dev):
        import uuid as uuidlib
        pc = self._pychromecast
        c = self.casts.get(dev["uuid"])
        if c is not None and not c.socket_client.stop.is_set() and c.socket_client.is_alive():
            return c
        info = self.cast_info.get(dev["uuid"])
        if info is not None:
            c = pc.get_chromecast_from_cast_info(info, self.zc, tries=3, retry_wait=2, timeout=10)
        else:
            c = pc.get_chromecast_from_host(
                (dev["host"], dev.get("port") or 8009, uuidlib.UUID(dev["uuid"]), dev.get("model"), dev["name"]),
                tries=3, retry_wait=2, timeout=10)
        c.wait(timeout=20)
        self.casts[dev["uuid"]] = c
        return c

    # -- estado --
    def publish(self):
        with self.lock:
            s = self.active
            st = {
                "updated": time.time(),
                "devices": [{k: d[k] for k in ("uuid", "name", "model", "host")} for d in self.device_list()],
                "active": s.as_dict() if s else None,
                "monitors": self.monitors,
                "error": self.error,
            }
            try:
                atomic_write(STATE_PATH, json.dumps(st, ensure_ascii=False))
            except Exception:  # noqa: BLE001
                log.exception("state.json")
        if self.mpris:
            self.mpris.sync()

    def mpris_seeked(self, pos):
        if self.mpris:
            self.mpris.seeked(pos)

    def set_active(self, s):
        with self.lock:
            old = self.active
            self.active = s
        if old is not None and old is not s:
            old.cleanup()
        self.publish()

    def end_session(self, s, error=None):
        with self.lock:
            if self.active is not s:
                return
            self.active = None
            if error:
                self.error = error
        s.cleanup()
        self.publish()

    def fail(self, s, msg):
        with self.lock:
            self.error = msg
            if self.active is s:
                self.active = None
        s.cleanup()
        self.publish()

    def run_async(self, fn):
        """Ejecuta fn(sesion_activa) en un hilo (usado por MPRIS)."""
        def go():
            s = self.active
            if not s:
                return
            try:
                with self.cmd_lock:
                    fn(s)
            except Exception:  # noqa: BLE001
                log.exception("orden MPRIS")
        threading.Thread(target=go, daemon=True).start()

    def ticker(self):
        while not self._stop.wait(1.0):
            s = self.active
            if s and s.state in ("PLAYING", "BUFFERING"):
                self.publish()

    # -- comandos --
    def handle(self, req):
        cmd = req.get("cmd")
        fn = getattr(self, "cmd_" + str(cmd).replace("-", "_"), None)
        if fn is None:
            return {"ok": False, "error": f"comando desconocido: {cmd}"}
        try:
            with self.cmd_lock:
                return fn(req)
        except (ValueError, RuntimeError) as e:
            self.error = str(e) if cmd == "cast" else self.error
            if cmd == "cast":
                self.publish()
            return {"ok": False, "error": str(e)}
        except Exception as e:  # noqa: BLE001
            log.exception("comando %s", cmd)
            return {"ok": False, "error": f"{type(e).__name__}: {e}"}

    def cmd_devices(self, req):
        self.monitors = list_monitors() or self.monitors
        t0 = time.time()
        while not self.devices and time.time() - t0 < 4:
            time.sleep(0.2)
        return {"ok": True, "devices": self.device_list()}

    def cmd_probe(self, req):
        path = os.path.abspath(os.path.expanduser(req["path"]))
        info = probe_file(path)
        a = default_audio(info["audio"])
        mode, reason, err = plan_playback(path, info, a["index"] if a else None)
        out = {"ok": True, "duration": info["duration"],
               "video": {k: info["video"][k] for k in ("codec", "width", "height")},
               "audio": info["audio"], "subs": info["subs"],
               "external_subs": info["external_subs"], "mode": mode, "reason": reason,
               "default_audio": a["index"] if a else None,
               "default_sub": describe_default_sub(info)}
        if err:
            out["playable"] = False
            out["warning"] = err
        else:
            out["playable"] = True
        return out

    def _sub_spec(self, req, info):
        if req.get("no_subs"):
            return ("none",)
        if req.get("sub_file"):
            p = os.path.abspath(os.path.expanduser(req["sub_file"]))
            if not os.path.isfile(p):
                raise ValueError(f"no existe el archivo de subtítulos: {p}")
            meta = ext_sub_info(p)
            return ("file", p, meta)
        if req.get("sub") is not None:
            n = int(req["sub"])
            for s in info["subs"]:
                if s["index"] == n:
                    if not s["text"]:
                        raise ValueError(f"la pista de subtítulos {n} es de imagen ({s['codec']}); no soportada")
                    return ("embedded", n, s)
            raise ValueError(f"pista de subtítulos {n} inexistente")
        return default_sub_spec(info)

    def cmd_cast(self, req):
        dev = self.find_device(req["device"])
        if not dev:
            raise ValueError(f"dispositivo no encontrado: {req['device']}")
        src = req["source"]
        start = float(req.get("start") or 0)
        if re.match(r"^https?://", src):
            self.server_ok = None
            s = Session(self, dev, src, "url", req.get("title") or src)
            self.error = None
            self.set_active(s)
            threading.Thread(target=s.run_load, args=(0, None), daemon=True).start()
            return {"ok": True, "mode": "url", "preparing": True}
        path = os.path.abspath(os.path.expanduser(src))
        info = probe_file(path)
        aidx = req.get("audio")
        if aidx is None:
            a = default_audio(info["audio"])
            aidx = a["index"] if a else None
        else:
            aidx = int(aidx)
        mode, reason, err = plan_playback(path, info, aidx)
        if err:
            raise ValueError(err)
        spec = self._sub_spec(req, info)
        self.server.start()  # puede lanzar RuntimeError "puerto ocupado"; el daemon sigue vivo
        s = Session(self, dev, path, mode, req.get("title") or clean_title(path))
        s.info = info
        s.duration = info["duration"]
        s.audio_index = aidx if mode == "transcode" else None
        self.error = None
        self.set_active(s)
        threading.Thread(target=s.run_load, args=(start, spec), daemon=True).start()
        return {"ok": True, "mode": mode, "reason": reason, "preparing": True,
                "subs": (lang_label(spec[2].get("lang"), spec[2].get("title", ""), spec[2].get("forced"))
                         if spec[0] != "none" else None)}

    def cmd_mirror(self, req):
        act = req.get("action", "start")
        if act == "monitors":
            self.monitors = list_monitors() or self.monitors
            self.publish()
            return {"ok": True, "monitors": self.monitors}
        if act == "stop":
            self.do_stop()
            return {"ok": True}
        if act == "audio":
            s = self._need_active()
            if not isinstance(s, MirrorSession):
                raise ValueError("no se está duplicando la pantalla")
            s.set_audio(bool(req.get("on", True)))
            self.publish()
            return {"ok": True, "audio": s.audio}
        # start
        if not self.monitors:
            self.monitors = list_monitors()
        if not self.monitors:
            raise ValueError("no se encontró ninguna pantalla capturable (gpu-screen-recorder)")
        key = req.get("device")
        dev = self.find_device(key) if key else (self.device_list() or [None])[0]
        if not dev:
            raise ValueError("no hay ningún Chromecast")
        names = [m["name"] for m in self.monitors]
        mon = req.get("monitor") or names[0]
        if mon not in names:
            raise ValueError(f"pantalla desconocida: {mon}")
        m = next(x for x in self.monitors if x["name"] == mon)
        size = "1920x1080" if m["width"] > 1920 else None
        self.server.start()
        s = MirrorSession(self, dev, mon, bool(req.get("audio", True)), size)
        self.error = None
        self.set_active(s)
        threading.Thread(target=s.run_load, args=(0, None), daemon=True).start()
        return {"ok": True, "mode": "mirror", "monitor": mon, "preparing": True}

    def _need_active(self):
        s = self.active
        if not s:
            raise ValueError("nada reproduciendo")
        return s

    def cmd_play(self, req):
        self._need_active().play()
        return {"ok": True}

    def cmd_pause(self, req):
        self._need_active().pause()
        return {"ok": True}

    def cmd_toggle(self, req):
        self._need_active().toggle()
        return {"ok": True}

    def do_stop(self):
        s = self._need_active()
        s.stop()
        self.end_session(s)

    def cmd_stop(self, req):
        self.do_stop()
        return {"ok": True}

    def cmd_seek(self, req):
        self._need_active().seek(float(req["pos"]))
        return {"ok": True}

    def cmd_volume(self, req):
        self._need_active().set_volume(int(req["value"]))
        return {"ok": True}

    def cmd_mute(self, req):
        self._need_active().mute()
        return {"ok": True}

    def cmd_fake_active(self, req):
        """Solo pruebas: sesion ficticia, sin Chromecast."""
        self.set_active(FakeSession(self))
        return {"ok": True, "fake": True}

    # -- socket --
    def serve_socket(self):
        d = self

        class H(socketserver.StreamRequestHandler):
            def handle(self):
                line = self.rfile.readline()
                if not line:
                    return
                try:
                    req = json.loads(line)
                    resp = d.handle(req)
                except json.JSONDecodeError:
                    resp = {"ok": False, "error": "JSON inválido"}
                self.wfile.write((json.dumps(resp, ensure_ascii=False) + "\n").encode())

        class S(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
            daemon_threads = True

        if os.path.exists(SOCK_PATH):
            os.unlink(SOCK_PATH)
        srv = S(SOCK_PATH, H)
        os.chmod(SOCK_PATH, 0o600)
        threading.Thread(target=srv.serve_forever, daemon=True).start()
        return srv

    def shutdown(self):
        self._stop.set()
        s = self.active
        if s:
            s.cleanup()
        for v in list(self.server.routes.values()):
            if v.kind == "transcode":
                kill_proc(v.proc)
        try:
            os.unlink(SOCK_PATH)
        except OSError:
            pass
        try:
            if self.browser:
                self.browser.stop_discovery()
        except Exception:  # noqa: BLE001
            pass


def describe_default_sub(info):
    spec = default_sub_spec(info)
    if spec[0] == "none":
        return None
    meta = spec[2]
    return {"kind": spec[0], "ref": spec[1], "label": lang_label(meta.get("lang"), meta.get("title", ""), meta.get("forced"))}


def default_sub_spec(info):
    """Por defecto: forzada en español (incrustada de texto o externa); si no, ninguna."""
    for s in info["subs"]:
        if s["forced"] and s["text"] and is_spanish(s["lang"]):
            return ("embedded", s["index"], s)
    for e in info.get("external_subs_info", []):
        if e["forced"] and is_spanish(e["lang"]):
            return ("file", e["path"], e)
    return ("none",)


def run_daemon():
    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
    _import_cast_libs()
    ensure_dirs()
    d = Daemon()
    d.monitors = list_monitors()
    try:
        d.mpris = Mpris(d)
    except Exception as e:  # noqa: BLE001
        log.warning("MPRIS desactivado: %s", e)
    d.start_discovery()
    srv = d.serve_socket()
    d.publish()
    threading.Thread(target=d.ticker, daemon=True).start()
    log.info("cast-helper listo: socket %s, puerto HTTP %d", SOCK_PATH, d.server.port)

    def bye(*_):
        log.info("cerrando")
        d.shutdown()
        srv.shutdown()
        if d.mpris:
            d.mpris.GLib.idle_add(loop.quit)
        else:
            ev.set()
        return False

    if d.mpris:
        GLib = d.mpris.GLib
        loop = GLib.MainLoop()
        for sg in (signal.SIGTERM, signal.SIGINT):
            GLib.unix_signal_add(GLib.PRIORITY_HIGH, sg, bye)
        loop.run()
    else:
        ev = threading.Event()
        for sg in (signal.SIGTERM, signal.SIGINT):
            signal.signal(sg, bye)
        ev.wait()
    return 0


# ── cliente ──────────────────────────────────────────────────────────────────
def send(req, timeout=120):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(SOCK_PATH)
    except OSError:
        return {"ok": False, "error": "daemon no activo"}
    try:
        s.sendall((json.dumps(req) + "\n").encode())
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
        return json.loads(buf) if buf else {"ok": False, "error": "sin respuesta del daemon"}
    except socket.timeout:
        return {"ok": False, "error": "el daemon no respondió a tiempo"}
    finally:
        s.close()


def serve_test(args):
    """Oculto: sirve un archivo por HTTP sin Chromecast, o crea una sesion ficticia."""
    if args.fake_active:
        r = send({"cmd": "fake_active"})
        print(json.dumps(r, ensure_ascii=False))
        return 0 if r.get("ok") else 1
    if not args.path:
        print("uso: serve-test <ruta> [--start S] | serve-test --fake-active", file=sys.stderr)
        return 2
    path = os.path.abspath(os.path.expanduser(args.path))
    info = probe_file(path)
    a = default_audio(info["audio"])
    aidx = a["index"] if a else None
    mode, reason, err = plan_playback(path, info, aidx)
    if err:
        print(err, file=sys.stderr)
        return 1
    srv = MediaServer(port_from_env())
    srv.start()
    name = "test.mp4"
    if mode == "direct":
        rt = Route("direct", path, "video/webm" if path.endswith(".webm") else "video/mp4")
    else:
        rt = Route("transcode", path, "video/mp4", info=info, audio=aidx)
        rt.offset = float(args.start or 0)
    srv.add(name, rt)
    print(f"http://127.0.0.1:{srv.port}/{name}", flush=True)
    print(f"mode={mode} ({reason})", file=sys.stderr, flush=True)
    try:
        time.sleep(args.seconds)
    except KeyboardInterrupt:
        pass
    finally:
        kill_proc(rt.proc)
    return 0


def main():
    ap = argparse.ArgumentParser(prog="cast-helper", description="Helper de Chromecast para el panel Quickshell")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("daemon", help="proceso largo (unidad systemd)")
    sub.add_parser("devices", help="lista los Chromecast")
    p = sub.add_parser("probe", help="analiza un archivo")
    p.add_argument("path")
    p = sub.add_parser("cast", help="reproduce un archivo o URL")
    p.add_argument("device")
    p.add_argument("source")
    p.add_argument("--audio", type=int)
    g = p.add_mutually_exclusive_group()
    g.add_argument("--sub", type=int)
    g.add_argument("--sub-file")
    g.add_argument("--no-subs", action="store_true")
    p.add_argument("--start", type=float)
    p.add_argument("--title")
    for c in ("play", "pause", "toggle", "stop", "mute"):
        sub.add_parser(c)
    p = sub.add_parser("mirror", help="duplicar la pantalla en el Chromecast")
    p.add_argument("action", choices=["start", "stop", "audio", "monitors"])
    p.add_argument("value", nargs="?", help="audio: on|off")
    p.add_argument("--device")
    p.add_argument("--monitor")
    p.add_argument("--no-audio", action="store_true")
    p = sub.add_parser("seek")
    p.add_argument("pos", type=float)
    p = sub.add_parser("volume")
    p.add_argument("value", type=int)
    p = sub.add_parser("serve-test", help=argparse.SUPPRESS)
    p.add_argument("path", nargs="?")
    p.add_argument("--start", type=float)
    p.add_argument("--seconds", type=float, default=60)
    p.add_argument("--fake-active", action="store_true")

    args = ap.parse_args()
    if args.cmd == "daemon":
        return run_daemon()
    if args.cmd == "serve-test":
        _import_cast_libs_optional()
        return serve_test(args)
    req = {"cmd": args.cmd}
    if args.cmd == "probe":
        req["path"] = os.path.abspath(os.path.expanduser(args.path))
    elif args.cmd == "cast":
        src = args.source
        if not re.match(r"^https?://", src):
            src = os.path.abspath(os.path.expanduser(src))
        req.update(device=args.device, source=src, audio=args.audio, sub=args.sub,
                   sub_file=args.sub_file, no_subs=args.no_subs, start=args.start, title=args.title)
    elif args.cmd == "mirror":
        req.update(action=args.action, device=args.device, monitor=args.monitor, audio=not args.no_audio)
        if args.action == "audio":
            req["on"] = (args.value or "on").lower() not in ("off", "0", "no")
    elif args.cmd == "seek":
        req["pos"] = args.pos
    elif args.cmd == "volume":
        req["value"] = args.value
    resp = send(req)
    print(json.dumps(resp, ensure_ascii=False))
    return 0 if resp.get("ok") else 1


def _import_cast_libs_optional():
    return None


if __name__ == "__main__":
    sys.exit(main())

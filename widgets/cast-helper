class Mpris:
    def __init__(self, daemon):
        from gi.repository import Gio, GLib  # type: ignore
        self.Gio, self.GLib = Gio, GLib
        self.d = daemon
        self.conn = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.owner_id = None
        self.last_sig = None
        node = Gio.DBusNodeInfo.new_for_xml(MPRIS_XML)
        for i, iface in enumerate(node.interfaces):
            self.conn.register_object(
                MPRIS_PATH, iface, self._on_method, self._on_get, self._on_set)

    # -- datos --
    def _sess(self):
        return self.d.active

    def _status(self):
        s = self._sess()
        if not s:
            return "Stopped"
        return {"PLAYING": "Playing", "BUFFERING": "Playing", "PAUSED": "Paused"}.get(s.state, "Stopped")

    def _metadata(self):
        V = self.GLib.Variant
        s = self._sess()
        md = {"mpris:trackid": V("o", "/org/casthelper/track/%d" % (s.n if s else 0))}
        if s:
            md["xesam:title"] = V("s", s.title or "")
            md["xesam:artist"] = V("as", ["Chromecast · " + s.dev["name"]])
            md["mpris:length"] = V("x", int(s.duration * 1_000_000))
            if s.art_path and os.path.isfile(s.art_path):
                md["mpris:artUrl"] = V("s", "file://" + urllib.parse.quote(s.art_path))
        return md

    def _prop(self, iface, name):
        V = self.GLib.Variant
        s = self._sess()
        if iface == IFACE_ROOT:
            return {
                "CanQuit": V("b", False), "CanRaise": V("b", False), "HasTrackList": V("b", False),
                "Identity": V("s", ("Chromecast · " + s.dev["name"]) if s else "Chromecast"),
                "SupportedUriSchemes": V("as", []), "SupportedMimeTypes": V("as", []),
            }.get(name)
        return {
            "PlaybackStatus": V("s", self._status()), "LoopStatus": V("s", "None"),
            "Rate": V("d", 1.0), "Shuffle": V("b", False), "Metadata": V("a{sv}", self._metadata()),
            "Volume": V("d", (s.volume / 100.0) if s else 0.0),
            "Position": V("x", int((s.position() if s else 0.0) * 1_000_000)),
            "MinimumRate": V("d", 1.0), "MaximumRate": V("d", 1.0),
            "CanGoNext": V("b", False), "CanGoPrevious": V("b", False),
            "CanPlay": V("b", True), "CanPause": V("b", True),
            "CanSeek": V("b", True), "CanControl": V("b", True),
        }.get(name)

    def _on_get(self, conn, sender, path, iface, name):
        return self._prop(iface, name)

    def _on_set(self, conn, sender, path, iface, name, value):
        if iface == IFACE_PLAYER and name == "Volume":
            self.d.run_async(lambda s: s.set_volume(value.get_double() * 100))
            return True
        return False

    def _on_method(self, conn, sender, path, iface, method, params, inv):
        if iface == IFACE_PLAYER:
            args = params.unpack()
            if method == "Play":
                self.d.run_async(lambda s: s.play())
            elif method == "Pause":
                self.d.run_async(lambda s: s.pause())
            elif method == "PlayPause":
                self.d.run_async(lambda s: s.toggle())
            elif method == "Stop":
                self.d.run_async(lambda s: self.d.do_stop())
            elif method == "Seek":
                off = args[0] / 1e6
                self.d.run_async(lambda s: s.seek(s.position() + off))
            elif method == "SetPosition":
                pos = args[1] / 1e6
                self.d.run_async(lambda s: s.seek(pos))
        inv.return_value(None)

    # -- publicacion --
    def sync(self):
        """Llamar desde cualquier hilo: programa la actualizacion en el main loop."""
        self.GLib.idle_add(self._sync_main)

    def _sync_main(self):
        Gio, GLib = self.Gio, self.GLib
        s = self._sess()
        if s and self.owner_id is None:
            self.owner_id = Gio.bus_own_name_on_connection(
                self.conn, MPRIS_NAME, Gio.BusNameOwnerFlags.NONE, None, None)
        elif not s and self.owner_id is not None:
            Gio.bus_unown_name(self.owner_id)
            self.owner_id = None
        sig = (self._status(), s.title if s else None, round(s.duration) if s else 0,
               s.volume if s else 0, s.n if s else 0, bool(s and s.art_path))
        if sig != self.last_sig:
            self.last_sig = sig
            changed = {
                "PlaybackStatus": self._prop(IFACE_PLAYER, "PlaybackStatus"),
                "Metadata": self._prop(IFACE_PLAYER, "Metadata"),
                "Volume": self._prop(IFACE_PLAYER, "Volume"),
            }
            self._emit(IFACE_PLAYER, changed)
            self._emit(IFACE_ROOT, {"Identity": self._prop(IFACE_ROOT, "Identity")})
        return False

    def _emit(self, iface, changed):
        GLib = self.GLib
        try:
            self.conn.emit_signal(
                None, MPRIS_PATH, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                GLib.Variant("(sa{sv}as)", (iface, changed, [])))
        except Exception:  # noqa: BLE001
            log.exception("PropertiesChanged")

    def seeked(self, pos):
        def go():
            try:
                self.conn.emit_signal(None, MPRIS_PATH, IFACE_PLAYER, "Seeked",
                                      self.GLib.Variant("(x)", (int(pos * 1_000_000),)))
            except Exception:  # noqa: BLE001
                log.exception("Seeked")
            return False
        self.GLib.idle_add(go)



        self.no_art = False
        self.monitors = []
        self._stop = threading.Event()
        self._load_cache()

    # -- dispositivos --
    def _load_cache(self):
        try:
            for d in json.load(open(CACHE_PATH, encoding="utf-8")):
                d["online"] = False
                self.devices[d["uuid"]] = d
        except Exception:  # noqa: BLE001
            pass
        self.refresh_devices_online()

    def _save_cache(self):
        try:
            devs = [{k: v for k, v in d.items() if k != "online"} for d in self.devices.values()]
            atomic_write(CACHE_PATH, json.dumps(devs, ensure_ascii=False, indent=1))
        except Exception:  # noqa: BLE001
            log.exception("cache de dispositivos")

    def refresh_devices_online(self, sync=False):
        def _check():
            from concurrent.futures import ThreadPoolExecutor

            devs = list(self.devices.values())
            if not devs:
                return
            active_uuid = self.active.dev.get("uuid") if self.active else None

            def _probe(dev):
                if active_uuid and dev.get("uuid") == active_uuid:
                    return True
                return check_device_online(dev)

            with ThreadPoolExecutor(max_workers=min(16, len(devs))) as ex:
                results = list(ex.map(_probe, devs))

            changed = False
            for dev, on in zip(devs, results):
                if dev.get("online") != on:
                    dev["online"] = on
                    changed = True
            if changed:
                self.publish()

        if sync:
            _check()
        else:
            threading.Thread(target=_check, daemon=True).start()

    def start_discovery(self):
        import pychromecast
        from pychromecast.discovery import AbstractCastListener, CastBrowser, create_zeroconf
        d = self

        class L(AbstractCastListener):
            def add_cast(self, uuid, service):
                d._on_device(uuid, online=True)

            def update_cast(self, uuid, service):
                d._on_device(uuid, online=True)

            def remove_cast(self, uuid, service, cast_info):
                d._on_device_lost(uuid)

        self.zc = create_zeroconf()
        self.browser = CastBrowser(L(), self.zc)
        self.browser.start_discovery()
        self._pychromecast = pychromecast

    def _on_device(self, uuid, online=True):
        info = self.browser.devices.get(uuid)
        if not info:
            return
        self.cast_info[str(uuid)] = info
        rec = {"uuid": str(uuid), "name": info.friendly_name or info.host,
               "model": info.model_name or "", "host": info.host, "port": info.port or 8009,
               "online": online}
        if self.devices.get(rec["uuid"]) != rec:
            self.devices[rec["uuid"]] = rec
            self._save_cache()
        self.publish()

    def _on_device_lost(self, uuid):
        uid = str(uuid)
        if uid in self.devices:
            self.devices[uid]["online"] = False
            self.publish()

    def device_list(self):
        return sorted(self.devices.values(), key=lambda x: x["name"])

    def find_device(self, key):
        key_l = key.lower()
        if key in self.devices:
            return self.devices[key]
        for d in self.devices.values():
            if d["name"].lower() == key_l:
                return d
        for d in self.devices.values():
            if key_l in d["name"].lower() or d["uuid"].startswith(key_l):
                return d
        return None

    def get_cast(self, dev):
        import uuid as uuidlib
        pc = self._pychromecast
        c = self.casts.get(dev["uuid"])
        if c is not None and not c.socket_client.stop.is_set() and c.socket_client.is_alive():
            return c
        info = self.cast_info.get(dev["uuid"])
        if info is not None:
            c = pc.get_chromecast_from_cast_info(info, self.zc, tries=3, retry_wait=2, timeout=10)
        else:
            c = pc.get_chromecast_from_host(
                (dev["host"], dev.get("port") or 8009, uuidlib.UUID(dev["uuid"]), dev.get("model"), dev["name"]),
                tries=3, retry_wait=2, timeout=10)
        c.wait(timeout=20)
        self.casts[dev["uuid"]] = c
        return c

    # -- estado --
    def publish(self):
        with self.lock:
            s = self.active
            st = {
                "updated": time.time(),
                "devices": [{k: d[k] for k in ("uuid", "name", "model", "host", "online") if k in d} for d in self.device_list()],
                "active": s.as_dict() if s else None,
                "monitors": self.monitors,
                "error": self.error,
            }
            try:
                atomic_write(STATE_PATH, json.dumps(st, ensure_ascii=False))
            except Exception:  # noqa: BLE001
                log.exception("state.json")
        if self.mpris:
            self.mpris.sync()

    def mpris_seeked(self, pos):
        if self.mpris:
            self.mpris.seeked(pos)

    def set_active(self, s):
        with self.lock:
            old = self.active
            self.active = s
        if old is not None and old is not s:
            old.cleanup()
        self.publish()

    def end_session(self, s, error=None):
        with self.lock:
            if self.active is not s:
                return
            self.active = None
            if error:
                self.error = error
        s.cleanup()
        self.publish()

    def fail(self, s, msg):
        with self.lock:
            self.error = msg
            if self.active is s:
                self.active = None
        s.cleanup()
        self.publish()

    def run_async(self, fn):
        """Ejecuta fn(sesion_activa) en un hilo (usado por MPRIS)."""
        def go():
            s = self.active
            if not s:
                return
            try:
                with self.cmd_lock:
                    fn(s)
            except Exception:  # noqa: BLE001
                log.exception("orden MPRIS")
        threading.Thread(target=go, daemon=True).start()

    def ticker(self):
        ticks = 0
        while not self._stop.wait(1.0):
            ticks += 1
            s = self.active
            if s and s.state in ("PLAYING", "BUFFERING"):
                self.publish()
            elif ticks % 10 == 0:
                self.refresh_devices_online()
                mons = list_monitors()
                if mons != self.monitors:
                    self.monitors = mons
                    self.publish()

    # -- comandos --
    def handle(self, req):
        cmd = req.get("cmd")
        fn = getattr(self, "cmd_" + str(cmd).replace("-", "_"), None)
        if fn is None:
            return {"ok": False, "error": f"comando desconocido: {cmd}"}
        try:
            with self.cmd_lock:
                return fn(req)
        except (ValueError, RuntimeError) as e:
            self.error = str(e) if cmd == "cast" else self.error
            if cmd == "cast":
                self.publish()
            return {"ok": False, "error": str(e)}
        except Exception as e:  # noqa: BLE001
            log.exception("comando %s", cmd)
            return {"ok": False, "error": f"{type(e).__name__}: {e}"}

    def cmd_devices(self, req):
        self.monitors = list_monitors() or self.monitors
        self.refresh_devices_online(sync=True)
        t0 = time.time()
        while not self.devices and time.time() - t0 < 4:
            time.sleep(0.2)
        return {"ok": True, "devices": self.device_list()}

    def cmd_probe(self, req):
        path = os.path.abspath(os.path.expanduser(req["path"]))
        info = probe_file(path)
        a = default_audio(info["audio"])
        mode, reason, err = plan_playback(path, info, a["index"] if a else None)
        out = {"ok": True, "duration": info["duration"],
               "video": {k: info["video"][k] for k in ("codec", "width", "height")},
               "audio": info["audio"], "subs": info["subs"],
               "external_subs": info["external_subs"], "mode": mode, "reason": reason,
               "default_audio": a["index"] if a else None,
               "default_sub": describe_default_sub(info)}
        if err:
            out["playable"] = False
            out["warning"] = err
        else:
            out["playable"] = True
        return out

    def _sub_spec(self, req, info):
        if req.get("no_subs"):
            return ("none",)
        if req.get("sub_file"):
            p = os.path.abspath(os.path.expanduser(req["sub_file"]))
            if not os.path.isfile(p):
                raise ValueError(f"no existe el archivo de subtítulos: {p}")
            meta = ext_sub_info(p)
            return ("file", p, meta)
        if req.get("sub") is not None:
            n = int(req["sub"])
            for s in info["subs"]:
                if s["index"] == n:
                    if not s["text"]:
                        raise ValueError(f"la pista de subtítulos {n} es de imagen ({s['codec']}); no soportada")
                    return ("embedded", n, s)
            raise ValueError(f"pista de subtítulos {n} inexistente")
        return default_sub_spec(info)

    def cmd_cast(self, req):
        dev = self.find_device(req["device"])
        if not dev:
            raise ValueError(f"dispositivo no encontrado: {req['device']}")
        if dev.get("online") is False and not check_device_online(dev):
            raise ValueError(f"la tele ({dev['name']}) está desconectada o apagada")
        src = (req["source"] or "").strip()
        start = float(req.get("start") or 0)
        if is_torrent_source(src):
            if not os.path.isfile(TORRENT_SERVER) or shutil.which("node") is None:
                raise ValueError("cast-torrent no está instalado (~/.local/lib/cast-torrent/server.js)")
            if not src.startswith("magnet:") and not re.match(r"^https?://", src):
                src = os.path.abspath(os.path.expanduser(src))
                if not os.path.isfile(src):
                    raise ValueError(f"no existe el archivo torrent: {src}")
            self.server.start()
            s = Session(self, dev, src, "torrent", req.get("title") or "Cargando torrent…")
            s.is_torrent = True
            s.is_proxy = True
            s.torrent_req = req
            self.error = None
            self.set_active(s)
            threading.Thread(target=s.run_load, args=(start, None), daemon=True).start()
            return {"ok": True, "mode": "torrent", "preparing": True}
        if is_local_stream_url(src):
            self.server.start()
            s = Session(self, dev, src, "local_url", req.get("title") or "Cargando stream…")
            s.is_proxy = True
            s.torrent_req = req
            self.error = None
            self.set_active(s)
            threading.Thread(target=s.run_load, args=(start, None), daemon=True).start()
            return {"ok": True, "mode": "stream", "preparing": True}
        if re.match(r"^https?://", src):
            self.server_ok = None
            s = Session(self, dev, src, "url", req.get("title") or src)
            self.error = None
            self.set_active(s)
            threading.Thread(target=s.run_load, args=(start, None), daemon=True).start()
            return {"ok": True, "mode": "url", "preparing": True}
        path = os.path.abspath(os.path.expanduser(src))
        info = probe_file(path)
        aidx = req.get("audio")
        if aidx is None:
            a = default_audio(info["audio"])
            aidx = a["index"] if a else None
        else:
            aidx = int(aidx)
        mode, reason, err = plan_playback(path, info, aidx)
        if err:
            raise ValueError(err)
        spec = self._sub_spec(req, info)
        self.server.start()  # puede lanzar RuntimeError "puerto ocupado"; el daemon sigue vivo
        s = Session(self, dev, path, mode, req.get("title") or clean_title(path))
        s.info = info
        s.duration = info["duration"]
        s.audio_index = aidx if mode == "transcode" else None
        s.audio_active = aidx if aidx is not None else (info["audio"][0]["index"] if info["audio"] else None)
        self.error = None
        self.set_active(s)
        threading.Thread(target=s.run_load, args=(start, spec), daemon=True).start()
        return {"ok": True, "mode": mode, "reason": reason, "preparing": True,
                "subs": (lang_label(spec[2].get("lang"), spec[2].get("title", ""), spec[2].get("forced"))
                         if spec[0] != "none" else None)}

    def cmd_mirror(self, req):
        act = req.get("action", "start")
        if act == "monitors":
            self.monitors = list_monitors() or self.monitors
            self.publish()
            return {"ok": True, "monitors": self.monitors}
        if act == "options":
            self.monitors = list_monitors() or self.monitors
            return mirror_options()
        if act == "set":
            s = self._need_active()
            if not isinstance(s, (CastStreamSession, FakeMirrorSession)):
                raise ValueError("solo el backend Cast Streaming admite cambios en caliente")
            for k, allowed in (("quality", ("auto", "720p", "1080p")), ("encoder", ("auto", "cpu", "nvidia"))):
                if req.get(k) is not None and req[k] not in allowed:
                    raise ValueError(f"{k}: {'|'.join(allowed)}")
            s.set_options(req.get("quality"), req.get("encoder"), req.get("audio"))
            return {"ok": True}
        if act == "stop":
            self.do_stop()
            return {"ok": True}
        if act == "audio":
            s = self._need_active()
            if not isinstance(s, (MirrorSession, CastStreamSession)):
                raise ValueError("no se está duplicando la pantalla")
            s.set_audio(bool(req.get("on", True)))
            self.publish()
            return {"ok": True, "audio": s.audio}
        # start
        pr = load_prefs()
        quality = req.get("quality") or pr["quality"]
        encoder = req.get("encoder") or pr["encoder"]
        want_audio = pr["audio"] if req.get("audio") is None else bool(req["audio"])
        src_req = req.get("source") or pr["source"] or "monitor"
        if quality not in ("auto", "720p", "1080p") or encoder not in ("auto", "cpu", "nvidia"):
            raise ValueError("quality: auto|720p|1080p; encoder: auto|cpu|nvidia")
        key = req.get("device")
        dev = self.find_device(key) if key else (self.device_list() or [None])[0]
        if not dev:
            raise ValueError("no hay ningún Chromecast")
        if dev.get("online") is False and not check_device_online(dev):
            raise ValueError(f"la tele ({dev['name']}) está desconectada o apagada")
        if not self.monitors:
            self.monitors = list_monitors()
        kind, _, val = src_req.partition(":")
        if kind == "monitor":
            if not self.monitors:
                raise ValueError("no se encontró ninguna pantalla capturable (gpu-screen-recorder)")
            names = [m["name"] for m in self.monitors]
            if not val:
                foc = next((m["name"] for m in real_monitors() if m.get("focused")), None)
                val = req.get("monitor") or (foc if foc in names else names[0])
            if val not in names:
                raise ValueError(f"pantalla desconocida: {val}")
            source = f"monitor:{val}"
        elif kind == "workspace":
            if not val.isdigit():
                raise ValueError("workspace:<id>")
            source = f"workspace:{int(val)}"
        elif kind in ("extend", "window"):
            source = kind
        else:
            raise ValueError("source: monitor[:<salida>]|workspace:<id>|window|extend")
        backend = req.get("backend") or MIRROR_BACKEND
        use_stream = stream_available() and backend in ("auto", "cast-streaming")
        if backend == "cast-streaming" and not stream_available():
            raise ValueError("falta cast_sender: ejecuta tools/build-openscreen.sh")
        if not use_stream and kind != "monitor":
            raise ValueError("esa fuente requiere el backend Cast Streaming")
        save_prefs(source=("monitor" if kind == "monitor" else source), quality=quality, encoder=encoder, audio=want_audio)
        if use_stream:
            s = CastStreamSession(self, dev, source, quality, encoder, want_audio)
        else:
            m = next(x for x in self.monitors if x["name"] == val)
            self.server.start()
            s = MirrorSession(self, dev, val, want_audio, "1920x1080" if m["width"] > 1920 else None, req.get("profile"))
        self.error = None
        self.set_active(s)
        threading.Thread(target=s.run_load, args=(0, None), daemon=True).start()
        return {"ok": True, "mode": "mirror", "source": source, "monitor": s.monitor, "preparing": True,
                "backend": "cast-streaming" if use_stream else "hls"}

    def fallback_hls(self, old, why=None, audio=None):
        """Cambia una sesión Cast Streaming a espejo HLS (con audio si se pide)."""
        if why:
            log.warning("fallback a HLS: %s", why)
        with self.lock:
            if self.active is not old:
                return
        self.server.start()
        s = MirrorSession(self, old.dev, old.monitor, old.want_audio if audio is None else bool(audio),
                          old.size, None)
        self.error = None
        old._kill_all()
        self.set_active(s)
        threading.Thread(target=s.run_load, args=(0, None), daemon=True).start()

    def _need_active(self):
        s = self.active
        if not s:
            raise ValueError("nada reproduciendo")
        return s

    def cmd_play(self, req):
        self._need_active().play()
        return {"ok": True}

    def cmd_pause(self, req):
        self._need_active().pause()
        return {"ok": True}

    def cmd_toggle(self, req):
        self._need_active().toggle()
        return {"ok": True}

    def do_stop(self):
        s = self._need_active()
        s.stop()
        self.end_session(s)

    def cmd_stop(self, req):
        self.do_stop()
        return {"ok": True}

    def cmd_seek(self, req):
        self._need_active().seek(float(req["pos"]))
        return {"ok": True}

    def cmd_subs(self, req):
        v = req.get("value")
        s = self._need_active()
        s.set_sub(None if str(v).lower() in ("off", "none", "-1", "") else int(v))
        self.publish()
        return {"ok": True, "sub_active": s.sub_active}

    def cmd_audio(self, req):
        s = self._need_active()
        s.set_audio_track(int(req["value"]))
        self.publish()
        return {"ok": True, "audio_active": s.audio_active}

    def cmd_volume(self, req):
        self._need_active().set_volume(int(req["value"]))
        return {"ok": True}

    def cmd_mute(self, req):
        self._need_active().mute()
        return {"ok": True}

    def cmd_fake_active(self, req):
        """Solo pruebas: sesion ficticia, sin Chromecast."""
        self.set_active(FakeMirrorSession(self, req.get("source") or "monitor:eDP-2") if req.get("mirror")
                        else FakeSession(self))
        return {"ok": True, "fake": True}

    # -- socket --
    def serve_socket(self):
        d = self

        class H(socketserver.StreamRequestHandler):
            def handle(self):
                line = self.rfile.readline()
                if not line:
                    return
                try:
                    req = json.loads(line)
                    resp = d.handle(req)
                except json.JSONDecodeError:
                    resp = {"ok": False, "error": "JSON inválido"}
                self.wfile.write((json.dumps(resp, ensure_ascii=False) + "\n").encode())

        class S(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
            daemon_threads = True

        if os.path.exists(SOCK_PATH):
            os.unlink(SOCK_PATH)
        srv = S(SOCK_PATH, H)
        os.chmod(SOCK_PATH, 0o600)
        threading.Thread(target=srv.serve_forever, daemon=True).start()
        return srv

    def shutdown(self):
        self._stop.set()
        s = self.active
        if s:
            s.cleanup()
        for v in list(self.server.routes.values()):
            if v.kind == "transcode":
                kill_proc(v.proc)
        try:
            os.unlink(SOCK_PATH)
        except OSError:
            pass
        try:
            if self.browser:
                self.browser.stop_discovery()
        except Exception:  # noqa: BLE001
            pass


def describe_default_sub(info):
    spec = default_sub_spec(info)
    if spec[0] == "none":
        return None
    meta = spec[2]
    return {"kind": spec[0], "ref": spec[1], "label": lang_label(meta.get("lang"), meta.get("title", ""), meta.get("forced"))}


def default_sub_spec(info):
    """Por defecto: forzada en español (incrustada de texto o externa); si no, ninguna."""
    for s in info["subs"]:
        if s["forced"] and s["text"] and is_spanish(s["lang"]):
            return ("embedded", s["index"], s)
    for e in info.get("external_subs_info", []):
        if e["forced"] and is_spanish(e["lang"]):
            return ("file", e["path"], e)
    return ("none",)


def run_daemon():
    ensure_desktop_env()
    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
    _import_cast_libs()
    ensure_dirs()
    cleanup_orphan_virtual()
    d = Daemon()
    d.monitors = list_monitors()
    try:
        d.mpris = Mpris(d)
    except Exception as e:  # noqa: BLE001
        log.warning("MPRIS desactivado: %s", e)
    d.start_discovery()
    srv = d.serve_socket()
    d.publish()
    threading.Thread(target=d.ticker, daemon=True).start()
    log.info("cast-helper listo: socket %s, puerto HTTP %d", SOCK_PATH, d.server.port)

    def bye(*_):
        log.info("cerrando")
        d.shutdown()
        srv.shutdown()
        if d.mpris:
            d.mpris.GLib.idle_add(loop.quit)
        else:
            ev.set()
        return False

    if d.mpris:
        GLib = d.mpris.GLib
        loop = GLib.MainLoop()
        for sg in (signal.SIGTERM, signal.SIGINT):
            GLib.unix_signal_add(GLib.PRIORITY_HIGH, sg, bye)
        loop.run()
    else:
        ev = threading.Event()
        for sg in (signal.SIGTERM, signal.SIGINT):
            signal.signal(sg, bye)
        ev.wait()
    return 0


# ── cliente ──────────────────────────────────────────────────────────────────
def send(req, timeout=120):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(SOCK_PATH)
    except OSError:
        return {"ok": False, "error": "daemon no activo"}
    try:
        s.sendall((json.dumps(req) + "\n").encode())
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
        return json.loads(buf) if buf else {"ok": False, "error": "sin respuesta del daemon"}
    except socket.timeout:
        return {"ok": False, "error": "el daemon no respondió a tiempo"}
    finally:
        s.close()


def serve_test(args):
    """Oculto: sirve un archivo por HTTP sin Chromecast, o crea una sesion ficticia."""
    if args.fake_active or args.fake_mirror:
        r = send({"cmd": "fake_active", "mirror": bool(args.fake_mirror), "source": args.fake_mirror or None})
        print(json.dumps(r, ensure_ascii=False))
        return 0 if r.get("ok") else 1
    if not args.path:
        print("uso: serve-test <ruta> [--start S] | serve-test --fake-active", file=sys.stderr)
        return 2
    path = os.path.abspath(os.path.expanduser(args.path))
    info = probe_file(path)
    a = default_audio(info["audio"])
    aidx = a["index"] if a else None
    mode, reason, err = plan_playback(path, info, aidx)
    if err:
        print(err, file=sys.stderr)
        return 1
    srv = MediaServer(port_from_env())
    srv.start()
    name = "test.mp4"
    if mode == "direct":
        rt = Route("direct", path, "video/webm" if path.endswith(".webm") else "video/mp4")
    else:
        rt = Route("transcode", path, "video/mp4", info=info, audio=aidx)
        rt.offset = float(args.start or 0)
    srv.add(name, rt)
    print(f"http://127.0.0.1:{srv.port}/{name}", flush=True)
    print(f"mode={mode} ({reason})", file=sys.stderr, flush=True)
    try:
        time.sleep(args.seconds)
    except KeyboardInterrupt:
        pass
    finally:
        kill_proc(rt.proc)
    return 0


def main():
    ensure_desktop_env()
    ap = argparse.ArgumentParser(prog="cast-helper", description="Helper de Chromecast para el panel Quickshell")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("daemon", help="proceso largo (unidad systemd)")
    sub.add_parser("devices", help="lista los Chromecast")
    p = sub.add_parser("probe", help="analiza un archivo")
    p.add_argument("path")
    p = sub.add_parser("cast", help="reproduce un archivo o URL")
    p.add_argument("device")
    p.add_argument("source")
    p.add_argument("--audio", type=int)
    g = p.add_mutually_exclusive_group()
    g.add_argument("--sub", type=int)
    g.add_argument("--sub-file")
    g.add_argument("--no-subs", action="store_true")
    p.add_argument("--start", type=float)
    p.add_argument("--title")
    for c in ("play", "pause", "toggle", "stop", "mute"):
        sub.add_parser(c)
    p = sub.add_parser("mirror", help="duplicar la pantalla en el Chromecast")
    p.add_argument("action", choices=["start", "stop", "audio", "monitors", "test-latency", "options", "set"])
    p.add_argument("value", nargs="?", help="audio: on|off")
    p.add_argument("--device")
    p.add_argument("--monitor")
    p.add_argument("--no-audio", action="store_true")
    p.add_argument("--audio", dest="audio_opt", choices=["on", "off"])
    p.add_argument("--source", help="monitor[:<salida>] | workspace:<id> | window | extend")
    p.add_argument("--quality", choices=["auto", "720p", "1080p"])
    p.add_argument("--encoder", choices=["auto", "cpu", "nvidia"])
    p.add_argument("--profile", choices=sorted(MIRROR_PROFILES))
    p.add_argument("--backend", choices=["auto", "cast-streaming", "hls"],
                   help="auto = Cast Streaming si está instalado (sin audio), si no HLS")
    p = sub.add_parser("subs", help="cambia el subtítulo activo: <n>|off")
    p.add_argument("value")
    p = sub.add_parser("audio", help="cambia la pista de audio: <n>")
    p.add_argument("value", type=int)
    p = sub.add_parser("seek")
    p.add_argument("pos", type=float)
    p = sub.add_parser("volume")
    p.add_argument("value", type=int)
    p = sub.add_parser("serve-test", help=argparse.SUPPRESS)
    p.add_argument("path", nargs="?")
    p.add_argument("--start", type=float)
    p.add_argument("--seconds", type=float, default=60)
    p.add_argument("--fake-active", action="store_true")
    p.add_argument("--fake-mirror", nargs="?", const="monitor:eDP-2", metavar="FUENTE")

    args = ap.parse_args()
    if args.cmd == "daemon":
        return run_daemon()
    if args.cmd == "serve-test":
        _import_cast_libs_optional()
        return serve_test(args)
    if args.cmd == "mirror" and args.action == "test-latency":
        return latency_clock()
    req = {"cmd": args.cmd}
    if args.cmd == "probe":
        req["path"] = os.path.abspath(os.path.expanduser(args.path))
    elif args.cmd == "cast":
        src = args.source
        if not (re.match(r"^https?://", src) or src.startswith("magnet:")):
            src = os.path.abspath(os.path.expanduser(src))
        req.update(device=args.device, source=src, audio=args.audio, sub=args.sub,
                   sub_file=args.sub_file, no_subs=args.no_subs, start=args.start, title=args.title)
    elif args.cmd == "mirror":
        aud = False if args.no_audio else (None if args.audio_opt is None else args.audio_opt == "on")
        req.update(action=args.action, device=args.device, monitor=args.monitor, audio=aud, profile=args.profile,
                   backend=args.backend, source=args.source, quality=args.quality, encoder=args.encoder)
        if args.action == "audio":
            req["on"] = (args.value or "on").lower() not in ("off", "0", "no")
    elif args.cmd == "seek":
        req["pos"] = args.pos
    elif args.cmd in ("volume", "subs", "audio"):
        req["value"] = args.value
    resp = send(req)
    print(json.dumps(resp, ensure_ascii=False))
    return 0 if resp.get("ok") else 1


def latency_clock():
    """Cronómetro grande a pantalla completa: fotografía esta pantalla y la tele a la vez; la diferencia
    entre ambos tiempos es la latencia real del espejo. Esc o clic para cerrar."""
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gtk, GLib, Gdk  # type: ignore

    t0 = time.monotonic()
    app = Gtk.Application(application_id="local.casthelper.latency")

    def on_activate(a):
        win = Gtk.ApplicationWindow(application=a)
        css = Gtk.CssProvider()
        css.load_from_data(b"window { background: #000; } label.clock { color: #fff; font-family: monospace; "
                           b"font-weight: bold; font-size: 300px; } label.hint { color: #888; font-size: 20px; }")
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER, halign=Gtk.Align.CENTER)
        lbl = Gtk.Label(label="00:00.000")
        lbl.add_css_class("clock")
        hint = Gtk.Label(label="Proyecta esta pantalla (Super+K) y haz UNA foto que incluya este monitor y la tele. "
                               "Latencia = tiempo de este monitor - tiempo de la tele. Esc para cerrar.")
        hint.add_css_class("hint")
        box.append(lbl)
        box.append(hint)
        win.set_child(box)

        def tick(_w, _clock):
            t = time.monotonic() - t0
            lbl.set_text(f"{int(t // 60):02d}:{int(t % 60):02d}.{int((t % 1) * 1000):03d}")
            return True

        win.add_tick_callback(tick)
        key = Gtk.EventControllerKey()
        key.connect("key-pressed", lambda *_: a.quit() or True)
        win.add_controller(key)
        click = Gtk.GestureClick()
        click.connect("pressed", lambda *_: a.quit())
        win.add_controller(click)
        win.fullscreen()
        win.present()

    app.connect("activate", on_activate)
    return app.run([])



# ── utilidades ───────────────────────────────────────────────────────────────
def ensure_dirs():
    os.makedirs(WORK_DIR, exist_ok=True)
    os.makedirs(os.path.dirname(CACHE_PATH), exist_ok=True)


def atomic_write(path, text):
    tmp = f"{path}.tmp{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def clean_title(path_or_name):
    name = os.path.splitext(os.path.basename(path_or_name))[0]
    m = re.search(r"\s*[\(\[]", name)
    if m and m.start() > 0:
        name = name[: m.start()]
    return name.strip(" ._-") or os.path.basename(path_or_name)


def lang_label(lang, title="", forced=False):
    lang = (lang or "").lower()
    base = LANG_NAMES.get(lang) or LANG_NAMES.get(lang[:2]) or (lang.upper() if lang else "")
    label = base or (title or "Subtítulos")
    if forced:
        label += " (forzados)"
    elif title and base and title.lower() not in label.lower():
        label += f" ({title})"
    return label


def is_spanish(lang):
    lang = (lang or "").lower()
    return lang in ("spa", "es", "esp", "lat") or lang.startswith("es-") or lang.startswith("spa")


def local_ip_for(host):
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect((host, 8009))
        return s.getsockname()[0]
    finally:
        s.close()


def fmt_dur(v):
    try:
        return float(v)
    except (TypeError, ValueError):
        return 0.0


# ── probe ────────────────────────────────────────────────────────────────────
def find_external_subs(path):
    d = os.path.dirname(os.path.abspath(path))
    stem = os.path.splitext(os.path.basename(path))[0]
    title = clean_title(path)
    prefixes = {stem.lower(), title.lower()}
    if title.split():
        prefixes.add(title.split()[0].lower())
    prefixes = {p for p in prefixes if p}
    out = []
    try:
        names = sorted(os.listdir(d))
    except OSError:
        return out
    for n in names:
        ext = os.path.splitext(n)[1].lower()
        if ext not in (".srt", ".vtt"):
            continue
        if any(n.lower().startswith(p) for p in prefixes):
            out.append(os.path.join(d, n))
    return out


def ext_sub_info(path):
    n = os.path.basename(path).lower()
    forced = bool(re.search(r"forz|forced", n))
    lang = ""
    for tok in re.split(r"[\.\-_ \[\]\(\)]+", n):
        if tok in LANG_NAMES:
            lang = tok
            break
    if not lang and forced:
        lang = "spa"
    return {"path": path, "lang": lang, "forced": forced}


def probe_file(path):
    if not os.path.isfile(path):
        raise ValueError(f"no existe el archivo: {path}")
    r = subprocess.run(
        ["ffprobe", "-v", "error", "-print_format", "json", "-show_format", "-show_streams", path],
        capture_output=True, text=True,
    )
    if r.returncode != 0:
        raise ValueError("ffprobe falló: " + (r.stderr.strip().splitlines() or ["?"])[-1])
    data = json.loads(r.stdout)
    video, audio, subs = None, [], []
    for s in data.get("streams", []):
        t = s.get("codec_type")
        tags = {k.lower(): v for k, v in (s.get("tags") or {}).items()}
        disp = s.get("disposition") or {}
        if t == "video" and not disp.get("attached_pic") and video is None:
            video = {
                "index": s["index"], "codec": s.get("codec_name"),
                "width": s.get("width"), "height": s.get("height"),
                "pix_fmt": s.get("pix_fmt"),
            }
        elif t == "audio":
            audio.append({
                "index": s["index"], "codec": s.get("codec_name"),
                "channels": s.get("channels"), "lang": tags.get("language", ""),
                "title": tags.get("title", ""),
            })
        elif t == "subtitle":
            title = tags.get("title", "")
            subs.append({
                "index": s["index"], "codec": s.get("codec_name"),
                "lang": tags.get("language", ""), "title": title,
                "forced": bool(disp.get("forced")) or bool(re.search(r"forz|forced", title, re.I)),
                "text": s.get("codec_name") in TEXT_SUBS,
            })
    if video is None:
        raise ValueError("el archivo no tiene pista de vídeo")
    fmt = data.get("format", {})
    ext_paths = find_external_subs(path)
    return {
        "duration": fmt_dur(fmt.get("duration")),
        "format": fmt.get("format_name", ""),
        "video": video, "audio": audio, "subs": subs,
        "external_subs": ext_paths,
        "external_subs_info": [ext_sub_info(p) for p in ext_paths],
    }


def default_audio(audio):
    for a in audio:
        if is_spanish(a["lang"]):
            return a
    return audio[0] if audio else None


def plan_playback(path, info, audio_index=None):
    """Devuelve (mode, reason, error). error != None => no reproducible."""
    v = info["video"]
    if v["codec"] not in DIRECT_VIDEO:
        return "transcode", f"vídeo {v['codec']}", \
            f"vídeo {v['codec']} no soportado por el Chromecast (solo h264/hevc/vp9) y no se transcodifica el vídeo"
    ext = os.path.splitext(path)[1].lower()
    fmt = info["format"]
    container_ok = ext in DIRECT_CONTAINER_EXT and ("mp4" in fmt or "webm" in fmt)
    if not info["audio"]:
        return ("direct" if container_ok else "transcode"), "sin audio", None
    chosen = None
    for a in info["audio"]:
        if a["index"] == audio_index:
            chosen = a
    if chosen is None:
        if audio_index is not None:
            return "transcode", "", f"pista de audio {audio_index} inexistente"
        chosen = default_audio(info["audio"])
    first = info["audio"][0]
    reasons = []
    if not container_ok:
        reasons.append(f"contenedor {ext or fmt} no reproducible directamente")
    if chosen["codec"] not in DIRECT_AUDIO:
        reasons.append(f"audio {chosen['codec']} no soportado")
    if chosen["index"] != first["index"]:
        reasons.append("audio no es la primera pista")
    if reasons:
        return "transcode", "; ".join(reasons), None
    return "direct", f"{ext.lstrip('.')} {v['codec']}+{chosen['codec']}: compatible", None


# ── subtitulos ───────────────────────────────────────────────────────────────
def decode_text(b):
    for enc in ("utf-8-sig", "cp1252", "latin-1"):
        try:
            return b.decode(enc)
        except UnicodeDecodeError:
            continue
    return b.decode("utf-8", "replace")


_TS = re.compile(r"(\d+):(\d\d):(\d\d)[\.,](\d{1,3})")
_CUE = re.compile(r"^(\S+)\s+-->\s+(\S+)(.*)$")


def _ts_to_s(m):
    return int(m.group(1)) * 3600 + int(m.group(2)) * 60 + int(m.group(3)) + int(m.group(4).ljust(3, "0")) / 1000


def _s_to_ts(s):
    s = max(0.0, s)
    ms = int(round(s * 1000))
    return f"{ms // 3600000:02d}:{ms // 60000 % 60:02d}:{ms // 1000 % 60:02d}.{ms % 1000:03d}"


def srt_to_vtt(text):
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    text = re.sub(r"(\d{2}:\d{2}:\d{2}),(\d{3})", r"\1.\2", text)
    return "WEBVTT\n\n" + text.lstrip("\n")


def shift_vtt(vtt, offset):
    """Resta `offset` s a todas las marcas de tiempo, descartando cues ya pasadas."""
    if offset <= 0:
        return vtt
    out = ["WEBVTT", ""]
    blocks = re.split(r"\n\s*\n", vtt.replace("\r\n", "\n").strip("\n"))
    for b in blocks:
        lines = b.split("\n")
        ci = next((i for i, l in enumerate(lines) if "-->" in l), None)
        if ci is None:
            continue
        m = _CUE.match(lines[ci].strip())
        if not m:
            continue
        a, z = _TS.fullmatch(m.group(1)), _TS.fullmatch(m.group(2))
        if not a or not z:
            # marcas mm:ss.mmm (sin horas)
            continue
        start, end = _ts_to_s(a) - offset, _ts_to_s(z) - offset
        if end <= 0:
            continue
        lines[ci] = f"{_s_to_ts(start)} --> {_s_to_ts(end)}{m.group(3)}"
        out.append("\n".join(lines))
        out.append("")
    return "\n".join(out) + "\n"


def normalize_vtt_times(vtt):
    """Asegura marcas HH:MM:SS.mmm (algunos VTT usan MM:SS.mmm)."""
    def fix(m):
        return m.group(0) if m.group(0).count(":") == 2 else "00:" + m.group(0)
    return re.sub(r"(?<![\d:])\d{1,2}:\d\d(?::\d\d)?\.\d{3}", fix, vtt)


def load_full_vtt(kind, ref, cache_key):
    """Devuelve el VTT completo (str) de una pista incrustada o archivo externo."""
    if kind == "file":
        raw = decode_text(open(ref, "rb").read())
        if ref.lower().endswith(".vtt") or raw.lstrip().startswith("WEBVTT"):
            vtt = raw.replace("\r\n", "\n")
            if not vtt.lstrip().startswith("WEBVTT"):
                vtt = "WEBVTT\n\n" + vtt
        else:
            vtt = srt_to_vtt(raw)
        return normalize_vtt_times(vtt)
    # incrustada: ffmpeg lee todo el contenedor una vez; cacheamos el resultado
    path, idx = ref
    st = os.stat(path)
    key = hashlib.sha1(f"{path}|{st.st_mtime_ns}|{idx}".encode()).hexdigest()[:16]
    cache = os.path.join(WORK_DIR, f"subcache-{key}.vtt")
    if os.path.isfile(cache):
        return open(cache, encoding="utf-8").read()
    tmp = cache + ".part"
    r = subprocess.run(
        ["ffmpeg", "-nostdin", "-loglevel", "error", "-y", "-i", path, "-map", f"0:{idx}",
         "-c:s", "webvtt", "-f", "webvtt", tmp],
        capture_output=True, text=True,
    )
    if r.returncode != 0:
        raise RuntimeError("no se pudo extraer el subtítulo: " + r.stderr.strip()[-200:])
    os.replace(tmp, cache)
    return open(cache, encoding="utf-8").read()


# ── servidor HTTP ────────────────────────────────────────────────────────────
class Route:
    """Un recurso servido: direct (archivo), transcode (ffmpeg en vivo) o sub (VTT)."""

    def __init__(self, kind, path, mime, info=None, audio=None):
        self.kind = kind
        self.path = path
        self.mime = mime
        self.info = info
        self.audio = audio
        self.offset = 0.0
        self.proc = None
        self.procs = []          # espejo: [ffmpeg, gpu-screen-recorder]
        self.monitor = None
        self.audio = True
        self.size = None
        self.lock = threading.Lock()


MIRROR_FPS = int(os.environ.get("CAST_MIRROR_FPS", "30"))
MIRROR_KBPS = int(os.environ.get("CAST_MIRROR_KBPS", "6000"))


def list_monitors():
    """Salidas capturables por gpu-screen-recorder: [{name,width,height}]."""
    try:
        out = subprocess.run(["gpu-screen-recorder", "--list-monitors"], capture_output=True, text=True, timeout=8).stdout
    except Exception:  # noqa: BLE001
        return []
    res = []
    for ln in out.splitlines():
        m = re.match(r"^([^|]+)\|(\d+)x(\d+)", ln.strip())
        if m:
            res.append({"name": m.group(1), "width": int(m.group(2)), "height": int(m.group(3))})
    return res


def build_mirror_cmds(monitor, audio, size):
    """gpu-screen-recorder (NVENC/VAAPI) -> mpegts por stdout -> ffmpeg remux a fMP4 en vivo."""
    gsr = ["gpu-screen-recorder", "-w", monitor, "-f", str(MIRROR_FPS), "-c", "mpegts", "-k", "h264",
           "-bm", "cbr", "-q", str(MIRROR_KBPS), "-keyint", "1", "-cursor", "yes"]
    if size:
        gsr += ["-s", size]
    if audio:
        gsr += ["-a", "default_output", "-ac", "aac", "-ab", "128"]
    gsr += ["-o", "/dev/stdout"]
    ff = ["ffmpeg", "-nostdin", "-loglevel", "error", "-fflags", "nobuffer", "-flags", "low_delay",
          "-probesize", "32768", "-analyzeduration", "0", "-f", "mpegts", "-i", "pipe:0", "-c", "copy"]
    if audio:
        ff += ["-bsf:a", "aac_adtstoasc"]
    ff += ["-f", "mp4", "-movflags", "frag_keyframe+empty_moov+default_base_moof", "-flush_packets", "1", "pipe:1"]
    return gsr, ff


def build_ffmpeg_cmd(path, info, audio_index, start):
    v = info["video"]
    cmd = ["ffmpeg", "-nostdin", "-loglevel", "error"]
    if start and start > 0:
        cmd += ["-ss", f"{start:.3f}"]
    cmd += ["-i", path, "-map", f"0:{v['index']}"]
    if audio_index is not None:
        cmd += ["-map", f"0:{audio_index}"]
    cmd += ["-c:v", "copy"]
    if v["codec"] == "hevc":
        cmd += ["-tag:v", "hvc1"]
    if audio_index is not None:
        a = next(x for x in info["audio"] if x["index"] == audio_index)
        if a["codec"] == "aac":
            cmd += ["-c:a", "copy"]
        else:
            cmd += ["-c:a", "aac", "-ac", "2", "-b:a", "256k"]
    cmd += ["-sn", "-dn", "-map_chapters", "-1", "-avoid_negative_ts", "make_zero", "-f", "mp4",
            "-movflags", "frag_keyframe+empty_moov+default_base_moof", "pipe:1"]
    return cmd


def kill_proc(p):
    if p and p.poll() is None:
        try:
            p.terminate()
            try:
                p.wait(2)
            except subprocess.TimeoutExpired:
                p.kill()
                p.wait(2)
        except Exception:
            pass


class MediaServer:
    def __init__(self, port):
        self.port = port
        self.routes = {}
        self.httpd = None
        self.thread = None

    def start(self):
        if self.httpd:
            return
        routes = self.routes

        class Handler(http.server.BaseHTTPRequestHandler):
            protocol_version = "HTTP/1.0"  # sin Content-Length => cierre al terminar

            def log_message(self, fmt, *args):
                log.debug("http %s " + fmt, self.address_string(), *args)

            def _route(self):
                p = urllib.parse.urlparse(self.path).path
                name = p.rsplit("/", 1)[-1]
                return routes.get(name)

            def _cors(self):
                self.send_header("Access-Control-Allow-Origin", "*")
                self.send_header("Access-Control-Allow-Headers", "Range, Content-Type")
                self.send_header("Access-Control-Expose-Headers", "Content-Range, Content-Length, Accept-Ranges")

            def do_OPTIONS(self):
                self.send_response(204)
                self._cors()
                self.send_header("Content-Length", "0")
                self.end_headers()

            def do_HEAD(self):
                self._serve(head=True)

            def do_GET(self):
                self._serve(head=False)

            def _serve(self, head):
                rt = self._route()
                if rt is None:
                    self.send_error(404)
                    return
                try:
                    if rt.kind == "direct":
                        self._serve_file(rt, head)
                    elif rt.kind == "sub":
                        self._serve_bytes(rt, head)
                    elif rt.kind == "mirror":
                        self._serve_mirror(rt, head)
                    else:
                        self._serve_transcode(rt, head)
                except (BrokenPipeError, ConnectionResetError):
                    pass

            def _serve_bytes(self, rt, head):
                data = open(rt.path, "rb").read()
                self.send_response(200)
                self.send_header("Content-Type", rt.mime)
                self.send_header("Content-Length", str(len(data)))
                self._cors()
                self.end_headers()
                if not head:
                    self.wfile.write(data)

            def _serve_file(self, rt, head):
                size = os.path.getsize(rt.path)
                start, end, code = 0, size - 1, 200
                rng = self.headers.get("Range")
                if rng:
                    m = re.match(r"bytes=(\d*)-(\d*)", rng.strip())
                    if m and (m.group(1) or m.group(2)):
                        if m.group(1):
                            start = int(m.group(1))
                            if m.group(2):
                                end = min(int(m.group(2)), size - 1)
                        else:
                            start = max(0, size - int(m.group(2)))
                        if start >= size:
                            self.send_response(416)
                            self.send_header("Content-Range", f"bytes */{size}")
                            self._cors()
                            self.end_headers()
                            return
                        code = 206
                length = end - start + 1
                self.send_response(code)
                self.send_header("Content-Type", rt.mime)
                self.send_header("Accept-Ranges", "bytes")
                self.send_header("Content-Length", str(length))
                if code == 206:
                    self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
                self._cors()
                self.end_headers()
                if head:
                    return
                with open(rt.path, "rb") as f:
                    f.seek(start)
                    left = length
                    while left > 0:
                        chunk = f.read(min(262144, left))
                        if not chunk:
                            break
                        self.wfile.write(chunk)
                        left -= len(chunk)

            def _serve_mirror(self, rt, head):
                self.send_response(200)
                self.send_header("Content-Type", "video/mp4")
                self.send_header("Cache-Control", "no-store")
                self._cors()
                self.end_headers()
                if head:
                    return
                with rt.lock:
                    for q in rt.procs:
                        kill_proc(q)  # una sola conexión viva por ruta
                    gcmd, fcmd = build_mirror_cmds(rt.monitor, rt.audio, rt.size)
                    log.info("espejo: %s | %s", " ".join(gcmd), " ".join(fcmd))
                    gsr = subprocess.Popen(gcmd, stdout=subprocess.PIPE, stderr=open(os.path.join(WORK_DIR, "mirror-gsr.log"), "wb"))
                    ff = subprocess.Popen(fcmd, stdin=gsr.stdout, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
                    gsr.stdout.close()
                    rt.procs = [ff, gsr]
                try:
                    while True:
                        chunk = ff.stdout.read1(65536)
                        if not chunk:
                            break
                        self.wfile.write(chunk)
                        self.wfile.flush()
                finally:
                    kill_proc(gsr)
                    kill_proc(ff)

            def _serve_transcode(self, rt, head):
                self.send_response(200)
                self.send_header("Content-Type", "video/mp4")
                self.send_header("Cache-Control", "no-store")
                self._cors()
                self.end_headers()
                if head:
                    return
                with rt.lock:
                    kill_proc(rt.proc)  # una sola conexión viva por ruta
                    cmd = build_ffmpeg_cmd(rt.path, rt.info, rt.audio, rt.offset)
                    log.info("ffmpeg: %s", " ".join(cmd))
                    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
                    rt.proc = proc
                try:
                    while True:
                        chunk = proc.stdout.read(65536)
                        if not chunk:
                            break
                        self.wfile.write(chunk)
                        self.wfile.flush()
                finally:
                    kill_proc(proc)
                    err = proc.stderr.read().decode(errors="replace").strip() if proc.stderr else ""
                    if err:
                        log.warning("ffmpeg stderr: %s", err[-300:])

        class Server(http.server.ThreadingHTTPServer):
            allow_reuse_address = True
            daemon_threads = True

        try:
            self.httpd = Server(("0.0.0.0", self.port), Handler)
        except OSError as e:
            self.httpd = None
            raise RuntimeError(f"puerto {self.port} ocupado (¿otro catt sirviendo?): {e.strerror}")
        self.thread = threading.Thread(target=self.httpd.serve_forever, daemon=True)
        self.thread.start()

    def add(self, name, route):
        self.routes[name] = route

    def remove(self, name):
        rt = self.routes.pop(name, None)
        if rt is not None and rt.kind == "transcode":
            kill_proc(rt.proc)
        if rt is not None and rt.kind == "mirror":
            for q in rt.procs:
                kill_proc(q)


def port_from_env():
    try:
        return int(os.environ.get("CAST_HELPER_PORT", DEFAULT_PORT))
    except ValueError:
        return DEFAULT_PORT


# ── sesion de reproduccion ───────────────────────────────────────────────────
class Session:
    _counter = 0

    def __init__(self, daemon, dev, source, mode, title):
        Session._counter += 1
        self.n = Session._counter
        self.daemon = daemon
        self.dev = dev
        self.source = source
        self.mode = mode
        self.title = title
        self.token = secrets.token_hex(6)
        self.state = "BUFFERING"
        self.duration = 0.0
        self.volume = 0
        self.muted = False
        self.subs_label = None
        self.preparing = True
        self.offset = 0.0
        self.status = None
        self.cast = None
        self.seen_active = False
        self.reloading = False
        self.loaded = False
        self.dead = False
        self.route = None
        self.sub_names = []
        self.art_path = None
        self.reload_n = 0
        self.info = None
        self.audio_index = None
        self.sub_vtt = None
        self.sub_lang = "es"
        self.ip = None
        self.fake = False

    # -- estado --
    def position(self):
        if self.status is None:
            return self.offset
        try:
            cur = self.status.adjusted_current_time if self.state == "PLAYING" else self.status.current_time
        except Exception:
            cur = 0.0
        pos = self.offset + (cur or 0.0)
        if self.duration:
            pos = min(pos, self.duration)
        return max(0.0, pos)

    def as_dict(self):
        return {
            "device_uuid": self.dev["uuid"], "device_name": self.dev["name"],
            "title": self.title, "source": self.source, "mode": self.mode,
            "state": self.state, "position": round(self.position(), 1),
            "duration": round(self.duration, 1), "volume": self.volume,
            "muted": self.muted, "subs": self.subs_label, "preparing": self.preparing,
            "art": self.art_path if self.art_path and os.path.isfile(self.art_path) else None,
        }

    # -- carga --
    def run_load(self, start, sub_spec):
        try:
            if self.mode == "url":
                self._connect()
                self._load_url()
            else:
                self._prepare_subs(sub_spec)
                self._extract_art()
                self._connect()
                self._load(start)
            self.preparing = False
            self.loaded = True
        except Exception as e:  # noqa: BLE001
            log.exception("fallo al preparar/cargar")
            self.daemon.fail(self, f"No se pudo reproducir: {e}")
            return
        self.daemon.publish()

    def _connect(self):
        self.cast = self.daemon.get_cast(self.dev)
        self.cast_listener = _CastListener(self)
        self.cast.media_controller.register_status_listener(self.cast_listener)
        self.cast.register_status_listener(self.cast_listener)
        st = self.cast.status
        if st:
            self.volume = round(st.volume_level * 100)
            self.muted = bool(st.volume_muted)
        self.ip = local_ip_for(self.dev["host"])

    def _prepare_subs(self, spec):
        """spec: ('none',) | ('embedded', idx, meta) | ('file', path, meta)"""
        self.sub_vtt = None
        self.subs_label = None
        if not spec or spec[0] == "none":
            return
        if spec[0] == "embedded":
            full = load_full_vtt("emb", (self.source, spec[1]), None)
        else:
            full = load_full_vtt("file", spec[1], None)
        self.sub_vtt = full
        meta = spec[2]
        self.subs_label = lang_label(meta.get("lang"), meta.get("title", ""), meta.get("forced", False))
        lg = meta.get("lang") or "es"
        self.sub_lang = "es" if is_spanish(lg) else (lg if lg else "und")

    def _extract_art(self):
        if not self.info or self.daemon.no_art:
            return
        try:
            at = max(1.0, self.duration * 0.1)
            out = os.path.join(WORK_DIR, f"art-{self.n}.jpg")
            r = subprocess.run(
                ["ffmpeg", "-nostdin", "-loglevel", "error", "-y", "-ss", f"{at:.1f}", "-i", self.source,
                 "-map", f"0:{self.info['video']['index']}", "-frames:v", "1", "-vf", "scale=480:-2", out],
                capture_output=True, timeout=30,
            )
            if r.returncode == 0 and os.path.isfile(out):
                self.art_path = out
        except Exception:  # noqa: BLE001
            pass

    def _write_sub_for(self, offset):
        if self.sub_vtt is None:
            return None
        name = f"{self.token}-s{self.reload_n}.vtt"
        path = os.path.join(WORK_DIR, name)
        atomic_write(path, shift_vtt(self.sub_vtt, offset))
        self.daemon.server.add(name, Route("sub", path, "text/vtt; charset=utf-8"))
        self.sub_names.append(name)
        return name

    def _load(self, start):
        d = self.daemon
        self.reload_n += 1
        self.offset = float(start) if self.mode == "transcode" else 0.0
        mc_start = 0.0 if self.mode == "transcode" else float(start)
        mname = f"{self.token}-m{self.reload_n}.mp4"
        if self.mode == "direct":
            mime = "video/webm" if self.source.lower().endswith(".webm") else "video/mp4"
            rt = Route("direct", self.source, mime)
        else:
            rt = Route("transcode", self.source, "video/mp4", info=self.info, audio=self.audio_index)
            rt.offset = self.offset
        if self.route is not None:
            for k, v in list(d.server.routes.items()):
                if v is self.route:
                    d.server.remove(k)
        d.server.add(mname, rt)
        self.route = rt
        sub_name = self._write_sub_for(self.offset)
        base = f"http://{self.ip}:{d.server.port}"
        kw = {}
        if sub_name:
            kw = dict(subtitles=f"{base}/{sub_name}", subtitles_lang=self.sub_lang,
                      subtitles_mime="text/vtt", subtitle_id=1)
        cast = self.cast
        if cast.app_id != APP_MEDIA_RECEIVER:
            cast.start_app(APP_MEDIA_RECEIVER)
        mc = cast.media_controller
        self.reloading = True
        try:
            mc.play_media(
                f"{base}/{mname}", rt.mime if self.mode == "direct" else "video/mp4",
                title=self.title, current_time=mc_start, autoplay=True,
                stream_type="BUFFERED" if self.mode == "direct" else "LIVE", **kw,
            )
            mc.block_until_active(timeout=15)
        finally:
            self.reloading = False

    def _load_url(self):
        from catt.api import CattDevice  # type: ignore
        dev = CattDevice(ip_addr=self.dev["host"])
        dev.play_url(self.source, resolve=True)
        self.cast.media_controller.update_status()

    # -- controles --
    def _need_cast(self):
        if self.cast is None or not self.loaded:
            raise RuntimeError("la reproducción todavía se está preparando")
        return self.cast

    def play(self):
        self._need_cast().media_controller.play()

    def pause(self):
        self._need_cast().media_controller.pause()

    def toggle(self):
        if self.state == "PLAYING":
            self.pause()
        else:
            self.play()

    def seek(self, pos):
        cast = self._need_cast()
        pos = max(0.0, float(pos))
        if self.duration:
            pos = min(pos, max(0.0, self.duration - 1))
        if self.mode == "transcode":
            self._load(pos)
        else:
            cast.media_controller.seek(pos)
        self.daemon.mpris_seeked(pos)

    def set_volume(self, v):
        v = max(0, min(100, int(v)))
        self._need_cast().set_volume(v / 100.0)
        self.volume = v

    def mute(self):
        cast = self._need_cast()
        cast.set_volume_muted(not self.muted)

    def stop(self):
        cast = self.cast
        if cast is not None:
            try:
                cast.media_controller.stop()
            except Exception:  # noqa: BLE001
                pass
            try:
                cast.quit_app()
            except Exception:  # noqa: BLE001
                pass

    def cleanup(self):
        """Limpia rutas/ficheros (no toca el Chromecast)."""
        self.dead = True
        srv = self.daemon.server
        for k, v in list(srv.routes.items()):
            if v is self.route or k in self.sub_names:
                srv.remove(k)
        for n in self.sub_names:
            try:
                os.unlink(os.path.join(WORK_DIR, n))
            except OSError:
                pass
        if self.art_path:
            try:
                os.unlink(self.art_path)
            except OSError:
                pass
        if self.cast is not None:
            try:
                self.cast.media_controller._status_listeners.remove(self.cast_listener)
            except Exception:  # noqa: BLE001
                pass
            try:
                self.cast.socket_client.receiver_controller._status_listeners.remove(self.cast_listener)
            except Exception:  # noqa: BLE001
                pass


class _CastListener:
    """Escucha estado de media y del receptor (volumen/app) de una sesion."""

    def __init__(self, sess):
        self.s = sess

    # media
    def new_media_status(self, st):
        s = self.s
        if s.dead or s.reloading:
            return
        ps = st.player_state
        if ps == "IDLE":
            if not s.seen_active:
                return
            reason = st.idle_reason
            err = "El Chromecast encontró un error al reproducir" if reason == "ERROR" else None
            s.daemon.end_session(s, error=err)
            return
        if ps == "UNKNOWN":
            return
        s.seen_active = True
        s.status = st
        s.state = ps
        if s.mode != "transcode" and st.duration:
            s.duration = float(st.duration)
        if s.mode == "url":
            md = st.media_metadata or {}
            if md.get("title"):
                s.title = md["title"]
            if st.duration:
                s.duration = float(st.duration)
        s.volume = round(st.volume_level * 100)
        s.muted = bool(st.volume_muted)
        s.daemon.publish()

    def load_media_failed(self, queue_item_id, error_code):
        s = self.s
        if not s.dead:
            s.daemon.fail(s, f"El Chromecast no pudo cargar el medio (código {error_code})")

    # receptor
    def new_cast_status(self, status):
        s = self.s
        if s.dead or not status:
            return
        s.volume = round(status.volume_level * 100)
        s.muted = bool(status.volume_muted)
        if s.loaded and not s.reloading and status.app_id != APP_MEDIA_RECEIVER:
            s.daemon.end_session(s, error=None)
            return
        s.daemon.publish()


class MirrorSession(Session):
    """Duplicar pantalla: captura de una salida (gpu-screen-recorder) emitida en vivo al Chromecast."""

    def __init__(self, daemon, dev, monitor, audio, size):
        super().__init__(daemon, dev, monitor, "mirror", f"Duplicando pantalla · {monitor}")
        self.monitor = monitor
        self.audio = audio
        self.size = size
        self.preparing = True

    def as_dict(self):
        d = super().as_dict()
        d.update(monitor=self.monitor, audio=self.audio, position=0, duration=0)
        return d

    def run_load(self, start, sub_spec):
        try:
            self._connect()
            self._load_mirror()
            self.preparing = False
            self.loaded = True
        except Exception as e:  # noqa: BLE001
            log.exception("fallo al iniciar el espejo")
            self.daemon.fail(self, f"No se pudo duplicar la pantalla: {e}")
            return
        self.daemon.publish()

    def _load_mirror(self):
        d = self.daemon
        self.reload_n += 1
        name = f"{self.token}-mirror{self.reload_n}.mp4"
        rt = Route("mirror", self.monitor, "video/mp4")
        rt.monitor, rt.audio, rt.size = self.monitor, self.audio, self.size
        if self.route is not None:
            for k, v in list(d.server.routes.items()):
                if v is self.route:
                    d.server.remove(k)
        d.server.add(name, rt)
        self.route = rt
        cast = self.cast
        if cast.app_id != APP_MEDIA_RECEIVER:
            cast.start_app(APP_MEDIA_RECEIVER)
        mc = cast.media_controller
        self.reloading = True
        try:
            mc.play_media(f"http://{self.ip}:{d.server.port}/{name}", "video/mp4", title=self.title,
                          autoplay=True, stream_type="LIVE")
            mc.block_until_active(timeout=20)
        finally:
            self.reloading = False

    def set_audio(self, on):
        if bool(on) == self.audio:
            return
        self.audio = bool(on)
        self._load_mirror()

    def seek(self, pos):
        raise RuntimeError("no se puede mover el tiempo al duplicar la pantalla")


class FakeSession(Session):
    """Sesion ficticia (pruebas): no toca ningun Chromecast."""

    def __init__(self, daemon):
        dev = {"uuid": "fake-0000", "name": "Prueba", "model": "Fake", "host": "127.0.0.1"}
        super().__init__(daemon, dev, "/fake/pelicula.mkv", "transcode", "Película de prueba")
        self.fake = True
        self.state = "PAUSED"
        self.duration = 600.0
        self.volume = 40
        self.preparing = False
        self.loaded = True
        self._pos = 12.0
        self._t = time.time()

    def position(self):
        if self.state == "PLAYING":
            now = time.time()
            self._pos = min(self.duration, self._pos + now - self._t)
            self._t = now
        else:
            self._t = time.time()
        return self._pos

    def _set(self, state):
        self.position()
        self.state = state
        self.daemon.publish()

    def play(self):
        self._set("PLAYING")

    def pause(self):
        self._set("PAUSED")

    def seek(self, pos):
        self._pos = max(0.0, min(self.duration, float(pos)))
        self._t = time.time()
        self.daemon.publish()
        self.daemon.mpris_seeked(self._pos)

    def set_volume(self, v):
        self.volume = max(0, min(100, int(v)))
        self.daemon.publish()

    def mute(self):
        self.muted = not self.muted
        self.daemon.publish()

    def stop(self):
        pass



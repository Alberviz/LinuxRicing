def ensure_desktop_env():
    """Restaura variables del compositor (Hyprland / Wayland) si el servicio arrancó antes o sin ellas."""
    rt = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")

    # 1. HYPRLAND_INSTANCE_SIGNATURE
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    sig_valid = False
    if sig:
        sock = os.path.join(rt, "hypr", sig, ".socket.sock")
        if os.path.exists(sock):
            sig_valid = True
    if not sig_valid:
        hypr_dirs = glob.glob(os.path.join(rt, "hypr", "*"))
        valid = [d for d in hypr_dirs if os.path.exists(os.path.join(d, ".socket.sock")) or os.path.exists(os.path.join(d, ".socket2.sock"))]
        if valid:
            newest = max(valid, key=os.path.getmtime)
            os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = os.path.basename(newest)

    # 2. WAYLAND_DISPLAY
    wl = os.environ.get("WAYLAND_DISPLAY")
    wl_valid = False
    if wl:
        sock = os.path.join(rt, wl)
        if os.path.exists(sock):
            wl_valid = True
    if not wl_valid:
        wl_socks = glob.glob(os.path.join(rt, "wayland-[0-9]*"))
        socks = [s for s in wl_socks if not s.endswith(".lock") and os.path.exists(s)]
        if socks:
            newest = max(socks, key=os.path.getmtime)
            os.environ["WAYLAND_DISPLAY"] = os.path.basename(newest)


def check_device_online(dev, timeout=0.3):
    """Comprueba si un Chromecast responde por TCP en su puerto (por defecto 8009)."""
    host = dev.get("host")
    port = dev.get("port") or 8009
    if not host:
        return False
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except Exception:
        return False



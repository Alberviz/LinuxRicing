    # base: lo anterior (keyframe cada 1 s, fragmentos por keyframe)
    "base": dict(keyint="1", nv="", frag="frag_keyframe", hls=False),
    # ll: GOP de 0,5 s, NVENC ull sin lookahead ni B-frames, fragmentos de ~100 ms
    "ll": dict(keyint="0.5", nv="tune=ull;zerolatency=1;rc-lookahead=0;bf=0;delay=0", frag="frag_every_frame", hls=False),
    # ll200: igual pero fragmentos de 200 ms
    "ll200": dict(keyint="0.5", nv="tune=ull;zerolatency=1;rc-lookahead=0;bf=0;delay=0", frag="dur200", hls=False),
    # hls: segmentos mpegts de 0,5 s en tmpfs
    "hls": dict(keyint="0.5", nv="tune=ull;zerolatency=1;rc-lookahead=0;bf=0;delay=0", frag="", hls=True, seg="0.5", size="3", start="-0.5"),
    # hls33: segmentos de 0,33 s, lista de 3, arranque cerca del borde en directo
    "hls33": dict(keyint="0.33", nv="tune=ull;zerolatency=1;rc-lookahead=0;bf=0;delay=0", frag="", hls=True, seg="0.33", size="3", start="-0.4"),
    # hls25: segmentos de 0,25 s (GOP de 0,25 s: más bitrate de keyframes)
    "hls25": dict(keyint="0.25", nv="tune=ull;zerolatency=1;rc-lookahead=0;bf=0;delay=0", frag="", hls=True, seg="0.25", size="6"),
}
DEFAULT_MIRROR_PROFILE = os.environ.get("CAST_MIRROR_PROFILE", "hls")


def build_mirror_cmds(monitor, audio, size, profile=None, token="x"):
    """gpu-screen-recorder (NVENC/VAAPI) -> mpegts por stdout -> ffmpeg remux a fMP4 en vivo (o HLS corto)."""
    pr = MIRROR_PROFILES.get(profile or DEFAULT_MIRROR_PROFILE, MIRROR_PROFILES["hls"])
    gsr = ["gpu-screen-recorder", "-w", monitor, "-f", str(MIRROR_FPS), "-c", "mpegts", "-k", "h264",
           "-bm", "cbr", "-q", str(MIRROR_KBPS), "-keyint", pr["keyint"], "-cursor", "yes", "-fm", "cfr"]
    if pr["nv"]:
        gsr += ["-ffmpeg-video-opts", pr["nv"]]
    if size:
        gsr += ["-s", size]
    if audio:
        gsr += ["-a", "default_output", "-ac", "aac", "-ab", "128"]
    gsr += ["-o", "/dev/stdout"]
    ff = ["ffmpeg", "-nostdin", "-loglevel", "error", "-fflags", "nobuffer+flush_packets", "-flags", "low_delay",
          "-probesize", "32768", "-analyzeduration", "0", "-f", "mpegts", "-i", "pipe:0", "-c", "copy",
          "-muxdelay", "0", "-muxpreload", "0"]
    if pr["hls"]:
        ff += ["-f", "hls", "-hls_time", pr.get("seg", "0.5"), "-hls_list_size", pr.get("size", "4"),
               "-hls_flags", "delete_segments+independent_segments+omit_endlist",
               "-hls_segment_filename", os.path.join(WORK_DIR, f"{token}-m%d.ts"),
               os.path.join(WORK_DIR, f"{token}-m.m3u8")]
        return gsr, ff
    if audio:
        ff += ["-bsf:a", "aac_adtstoasc"]
    mov = "empty_moov+default_base_moof+" + ("frag_keyframe" if pr["frag"] == "frag_keyframe" else
                                           "frag_every_frame" if pr["frag"] == "frag_every_frame" else "frag_keyframe")
    ff += ["-f", "mp4", "-movflags", mov]
    if pr["frag"] == "dur200":
        ff += ["-frag_duration", "200000"]
    ff += ["-flush_packets", "1", "pipe:1"]
    return gsr, ff



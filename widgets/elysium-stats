#!/usr/bin/env python3
"""elysium-stats — métricas para la pantalla de apoyo de Elysium.

Imprime una línea JSON cada ~1.5 s: cpu (%), cpuTemp (°C), gpu (%), gpuTemp,
vram/vramTotal (MiB), gpuW (W) y pads [{name, pct}] (baterías de mandos).
Solo corre mientras la pantalla de apoyo está visible (la lanza el shell).
"""
import glob, json, subprocess, sys, time


def cpu_times():
    with open("/proc/stat") as f:
        v = [int(x) for x in f.readline().split()[1:]]
    idle = v[3] + v[4]
    return sum(v), idle


def cpu_temp():
    best = None
    for hw in glob.glob("/sys/class/hwmon/hwmon*"):
        try:
            name = open(hw + "/name").read().strip()
        except OSError:
            continue
        if name in ("coretemp", "k10temp", "zenpower"):
            try:
                return int(open(hw + "/temp1_input").read()) / 1000
            except OSError:
                pass
        if name == "acpitz" and best is None:
            try:
                best = int(open(hw + "/temp1_input").read()) / 1000
            except OSError:
                pass
    return best


def gpu():
    try:
        out = subprocess.run(
            ["nvidia-smi", "--query-gpu=utilization.gpu,temperature.gpu,memory.used,memory.total,power.draw",
             "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=3).stdout
        u, t, m, mt, w = [x.strip() for x in out.splitlines()[0].split(",")]
        f = lambda s: float(s) if s.replace(".", "", 1).isdigit() else None
        return {"gpu": f(u), "gpuTemp": f(t), "vram": f(m), "vramTotal": f(mt), "gpuW": f(w)}
    except Exception:
        return {}


# Mandos tipo Xbox (xpadneo) no dan porcentaje, solo nivel (2 bits): se aproxima.
LEVEL_PCT = {"Full": 100, "High": 80, "Normal": 55, "Low": 25, "Critical": 8}
LEVEL_ES = {"Full": "llena", "High": "alta", "Normal": "media", "Low": "baja", "Critical": "crítica"}


def read(path):
    try:
        return open(path).read().strip()
    except OSError:
        return None


def pads():
    """Baterías de mandos/periféricos (scope=Device): {name, pct, level, charging}.
    pct es real si el driver da `capacity`; si solo da `capacity_level`, aproximado."""
    out = []
    for ps in glob.glob("/sys/class/power_supply/*"):
        if read(ps + "/scope") != "Device":
            continue
        cap, lvl = read(ps + "/capacity"), read(ps + "/capacity_level")
        if cap is None and lvl in (None, "Unknown"):
            continue
        name = read(ps + "/model_name") or ps.rsplit("/", 1)[1].replace("xpadneo_batt_", "Mando ")
        out.append({
            "name": name,
            "pct": int(cap) if cap and cap.isdigit() else LEVEL_PCT.get(lvl),
            "level": LEVEL_ES.get(lvl, "") if cap is None else "",
            "charging": read(ps + "/status") == "Charging",
        })
    return out


def main():
    prev = cpu_times()
    while True:
        time.sleep(1.5)
        cur = cpu_times()
        dt, di = cur[0] - prev[0], cur[1] - prev[1]
        prev = cur
        d = {"cpu": round(100 * (1 - di / dt)) if dt else 0, "cpuTemp": cpu_temp(), "pads": pads()}
        d.update(gpu())
        sys.stdout.write(json.dumps(d) + "\n")
        sys.stdout.flush()


if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, BrokenPipeError):
        pass

# ───────────── websocket mínimo (solo stdlib) ─────────────
class WS:
    def __init__(self, url: str, timeout: float = 30):
        u = urllib.parse.urlparse(url)
        self.s = socket.create_connection((u.hostname, u.port or 80), timeout=timeout)
        key = base64.b64encode(os.urandom(16)).decode()
        req = (f"GET {u.path} HTTP/1.1\r\nHost: {u.hostname}:{u.port}\r\nUpgrade: websocket\r\n"
               f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n")
        self.s.sendall(req.encode())
        buf = b""
        while b"\r\n\r\n" not in buf:
            ch = self.s.recv(4096)
            if not ch:
                raise ConnectionError("CDP cerró la conexión")
            buf += ch
        if b" 101 " not in buf.split(b"\r\n", 1)[0]:
            raise ConnectionError("CDP rechazó el websocket")
        self.rest = buf.split(b"\r\n\r\n", 1)[1]

    def _read(self, n: int) -> bytes:
        while len(self.rest) < n:
            ch = self.s.recv(65536)
            if not ch:
                raise ConnectionError("CDP cerró la conexión")
            self.rest += ch
        out, self.rest = self.rest[:n], self.rest[n:]
        return out

    def send(self, text: str) -> None:
        data = text.encode()
        hdr = bytearray([0x81])
        n = len(data)
        if n < 126:
            hdr.append(0x80 | n)
        elif n < 65536:
            hdr += bytes([0x80 | 126]) + struct.pack(">H", n)
        else:
            hdr += bytes([0x80 | 127]) + struct.pack(">Q", n)
        mask = os.urandom(4)
        self.s.sendall(bytes(hdr) + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(data)))

    def recv(self) -> str:
        msg = b""
        while True:
            b0, b1 = self._read(2)
            n = b1 & 0x7F
            if n == 126:
                n = struct.unpack(">H", self._read(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", self._read(8))[0]
            payload = self._read(n)
            op = b0 & 0x0F
            if op == 8:
                raise ConnectionError("CDP cerró el websocket")
            if op in (0, 1, 2):
                msg += payload
                if b0 & 0x80:
                    return msg.decode("utf-8", "replace")


# ───────────── Spotify por CDP ─────────────
def _page() -> dict | None:
    try:
        tabs = json.load(urllib.request.urlopen(CDP + "/json", timeout=2))
    except OSError:
        return None
    return next((t for t in tabs if t.get("type") == "page" and "xpui" in t.get("url", "")), None)


def _eval(page: dict, js: str, timeout: float = 40):
    ws = WS(page["webSocketDebuggerUrl"], timeout)
    ws.send(json.dumps({"id": 1, "method": "Runtime.evaluate",
                        "params": {"expression": js, "awaitPromise": True, "returnByValue": True}}))
    while True:
        m = json.loads(ws.recv())
        if m.get("id") == 1:
            r = m.get("result", {})
            if "exceptionDetails" in r:
                d = r["exceptionDetails"]
                raise RuntimeError((d.get("exception") or {}).get("description") or d.get("text") or "error JS")
            return r.get("result", {}).get("value")


def spotify_page(launch: bool = True) -> dict:
    """La página xpui con Spicetify listo; abre Spotify si hace falta."""
    page = _page()
    if not page and launch:
        subprocess.Popen(["spotify"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         stdin=subprocess.DEVNULL, start_new_session=True)
    t0 = time.time()
    while time.time() - t0 < 30:
        page = page or _page()
        if page:
            try:
                if _eval(page, "!!(window.Spicetify && Spicetify.Platform && Spicetify.Platform.ConnectAPI "
                               "&& Spicetify.GraphQL && Spicetify.GraphQL.Definitions)", 5):
                    return page
            except (OSError, RuntimeError, ConnectionError):
                page = None
        time.sleep(1)
    raise RuntimeError("Spotify no responde (¿está abierto con el puerto de depuración 9222 y Spicetify?)")


# Funciones JS comunes. `ARGS` se inyecta como JSON.
JS_LIB = r"""
const P = Spicetify.Platform, G = Spicetify.GraphQL;
const sleep = ms => new Promise(r => setTimeout(r, ms));
const norm = s => (s || "").toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/[^a-z0-9]+/g, "");
const KIND = {Playlist: "playlist", Album: "album", Track: "cancion", Artist: "artista"};
function devices() { return P.ConnectAPI.getState().devices.map(d => ({id: d.id, nombre: d.name, tipo: d.type, activo: d.isActive, local: d.isLocal})); }
function findTele(name) {
  const ds = P.ConnectAPI.getState().devices;
  if (name) { const n = norm(name); return ds.find(d => norm(d.name) === n) || ds.find(d => norm(d.name).includes(n)); }
  return ds.find(d => d.type === "cast_video" || d.type === "cast_audio" || d.type === "tv");
}
function playlistSort(uri) {
  if (ARGS.orden === "original") return null;
  if (ARGS.orden === "recientes") return {field: "ADDED_AT", order: "DESC"};
  try {
    for (let i = 0; i < localStorage.length; i++) {
      const k = localStorage.key(i);
      if (k.endsWith(":sortedState")) { const v = JSON.parse(localStorage.getItem(k) || "{}")[uri]; if (v && v.field) return v; }
    }
  } catch (e) {}
  return null;
}
function volAct() {
  const a = P.ConnectAPI.getState().activeDevice;
  return (a && !a.isLocal && typeof a.volume === "number") ? a.volume : Spicetify.Player.getVolume();
}
async function setVol(x) {
  const a = P.ConnectAPI.getState().activeDevice;
  if (a && !a.isLocal && P.PlaybackAPI && P.PlaybackAPI.setVolume) await P.PlaybackAPI.setVolume(x);
  else Spicetify.Player.setVolume(x);
  await sleep(700);
}
function localDev() { return P.ConnectAPI.getState().devices.find(d => d.isLocal || d.id === "local_device"); }
async function myPlaylists() {
  const out = [];
  try {
    const walk = items => { for (const it of items || []) { if (it.type === "playlist") out.push({nombre: it.name, uri: it.uri, tipo: "playlist", de: "tu biblioteca"}); if (it.items) walk(it.items); } };
    const root = await P.RootlistAPI.getContents({limit: 5000});
    walk(root.items);
  } catch (e) {}
  return out;
}
async function search(q, tipo) {
  const def = G.Definitions.searchTopResultsList || {name: "searchTopResultsList", operation: "query",
    sha256Hash: "12d940b3f7381506a82ff5382eb59b0ed65118656e6bcdfbe4cebc528f75d29d", value: null};
  const r = await G.Request(def, {query: q, limit: 20, offset: 0, numberOfTopResults: 20,
    includeArtistHasConcertsField: false, includeAudiobooks: false, includeAuthors: false, includePreReleases: false,
    includeAlbumPreReleases: false, includeEpisodeContentRatingsV2: false, isPrefix: null, sectionFilters: ["GENERIC"]});
  const s = r.data && r.data.searchV2;
  if (!s) throw new Error("la búsqueda de Spotify no devolvió nada");
  const res = [];
  for (const i of (s.topResultsV2 && s.topResultsV2.itemsV2) || []) {
    const d = (i.item && i.item.data) || {};
    const k = KIND[d.__typename];
    if (!k || !d.uri) continue;
    const de = k === "playlist" ? (d.ownerV2 && d.ownerV2.data && d.ownerV2.data.name) :
               k === "cancion" ? (d.artists && d.artists.items && d.artists.items[0] && d.artists.items[0].profile.name) :
               k === "album" ? (d.artists && d.artists.items && d.artists.items[0] && d.artists.items[0].profile.name) : "";
    res.push({nombre: d.name || (d.profile && d.profile.name), uri: d.uri, tipo: k, de: de || ""});
  }
  return tipo && tipo !== "auto" ? res.filter(x => x.tipo === tipo) : res;
}
async function resolve(q, tipo) {
  if (/^spotify:/.test(q)) return {nombre: q, uri: q, tipo: q.split(":")[1], de: ""};
  const m = q.match(/open\.spotify\.com\/(?:intl-[a-z]+\/)?(track|playlist|album|artist)\/([A-Za-z0-9]+)/);
  if (m) return {nombre: q, uri: `spotify:${m[1]}:${m[2]}`, tipo: m[1], de: ""};
  const n = norm(q);
  if (!n) return null;
  if (!tipo || tipo === "auto" || tipo === "playlist") {
    // Ojo: hay playlists sin nombre (o solo con emoji) que normalizan a "" — y "" está contenido en cualquier
    // texto, así que antes se colaban como resultado de cualquier petición. Fuera las de nombre < 2 letras, y
    // la regla «la petición contiene el nombre» solo para nombres largos.
    const mine = (await myPlaylists()).filter(p => norm(p.nombre).length >= 2);
    const hit = mine.find(p => norm(p.nombre) === n) ||
                (n.length >= 4 && mine.find(p => norm(p.nombre).includes(n))) ||
                mine.find(p => norm(p.nombre).length >= 5 && n.includes(norm(p.nombre)));
    if (hit) return hit;
    if (tipo === "playlist") {
      // Pidió «mi playlist X» y no hay coincidencia clara (p. ej. el STT oyó «Reality for Life» por
      // «RealG4life»): mejor preguntar por las parecidas que poner una cualquiera de la búsqueda.
      const snd = s => norm(s).replace(/4/g, "for").replace(/2/g, "two");
      const ws = q.split(/\s+/).filter(Boolean);
      const trozos = ws.map((_, i) => snd(ws.slice(i).join(" "))).filter(t => t.length >= 4);
      // Nombres muy cortos («Zzz», «MS») casan con cualquier cosa por un bigrama: fuera.
      const parecido = nombre => snd(nombre).length < 5 ? 0 : Math.max(0, ...trozos.map(t => dice(t, snd(nombre))));
      const parecidas = mine.map(p => ({...p, sim: parecido(p.nombre)})).filter(p => p.sim >= 0.3)
                            .sort((a, b) => b.sim - a.sim).slice(0, 3);
      if (parecidas.length && parecidas[0].sim >= 0.75) return parecidas[0];
      if (parecidas.length) return {dudas: parecidas.filter(p => p.sim >= parecidas[0].sim - 0.1).map(p => p.nombre)};
    }
  }
  const found = (await search(q, tipo)).filter(x => norm(x.nombre));
  if (!found.length) return null;
  const me = norm((P.UserAPI && (await P.UserAPI.getUser()).displayName) || "");
  return (me && found.find(x => x.tipo === "playlist" && norm(x.de) === me)) || found[0];
}
// Parecido entre dos textos normalizados (coeficiente de Dice sobre bigramas), 0..1.
function dice(a, b) {
  if (a === b) return 1;
  if (a.length < 2 || b.length < 2) return 0;
  const bg = s => { const m = new Map(); for (let i = 0; i < s.length - 1; i++) { const k = s.slice(i, i + 2); m.set(k, (m.get(k) || 0) + 1); } return m; };
  const A = bg(a), B = bg(b);
  let c = 0;
  for (const [k, v] of A) c += Math.min(v, B.get(k) || 0);
  return 2 * c / (a.length + b.length - 2);
}
async function transferTo(dev) {
  if (dev.isActive) return true;
  await P.ConnectAPI.transferPlayback(dev.id, {});
  for (let i = 0; i < 24; i++) {
    await sleep(500);
    const a = P.ConnectAPI.getState().activeDevice;
    if (a && a.id === dev.id) return true;
  }
  return false;
}
function now() {
  const ps = P.PlayerAPI.getState(), a = P.ConnectAPI.getState().activeDevice;
  const it = ps.item || {};
  return {sonando: !!ps.item && !ps.isPaused, cancion: it.name || null,
          artista: (it.artists && it.artists[0] && it.artists[0].name) || null,
          contexto: (ps.context && ps.context.uri) || null, dispositivo: a ? a.name : null,
          aleatorio: !!(ps.shuffle || ps.smartShuffle), repetir: ["no", "lista", "cancion"][ps.repeat || 0],
          volumen: Math.round(((a && !a.isLocal && typeof a.volume === "number" && a.volume > 0) ? a.volume : (Spicetify.Player.getVolume() || 0)) * 100),
          posicion_s: Math.round((Spicetify.Player.getProgress() || 0) / 1000),
          duracion_s: Math.round((Spicetify.Player.getDuration() || 0) / 1000),
          me_gusta: (() => { try { return !!Spicetify.Player.getHeart(); } catch (e) { return null; } })()};
}
async function getPlaylistContents(uri, limit = 1000) {
  try {
    const c = await P.PlaylistAPI.getContents(uri, {limit});
    return (c?.items || []).map(it => ({
      uri: it.uri,
      uid: it.uid || "",
      nombre: it.name,
      artista: (it.artists || []).map(a => a.name).join(", "),
      duracion_s: Math.round((it.duration?.milliseconds || 0) / 1000)
    }));
  } catch (e) {
    return [];
  }
}
"""


def run_js(body: str, args: dict, launch: bool = True):
    page = spotify_page(launch)
    js = "(async () => { const ARGS = " + json.dumps(args) + ";\n" + JS_LIB + "\n" + body + "\n})()"
    return _eval(page, js, 60)


def cmd_buscar(a) -> dict:
    res = run_js("return await search(ARGS.q, ARGS.tipo);", {"q": a.texto, "tipo": a.tipo})
    return {"ok": True, "resultados": (res or [])[:10]}


def cmd_poner(a) -> dict:
    body = r"""
const item = await resolve(ARGS.q, ARGS.tipo);
if (!item) return {ok: false, error: `no encuentro «${ARGS.q}» en Spotify`};
if (item.dudas) return {ok: false, error: `no tengo ninguna playlist que se llame «${ARGS.q}»`, candidatos: item.dudas};
let dev = null;
if (ARGS.donde === "tele") {
  dev = findTele(ARGS.tele);
  if (!dev) return {ok: false, error: "Spotify no ve la tele (¿encendida y en la misma red?)", dispositivos: devices()};
} else if (ARGS.donde === "pc") dev = localDev();
// Primero mover la sesión (si no, play() la vuelve a coger el PC mientras la tele aún conecta) y luego reproducir.
if (dev && !(await transferTo(dev))) return {ok: false, error: `no he podido pasar Spotify a ${dev.name}`};
// «Desde el inicio» = primera canción y sin aleatorio. Ojo: play() de un contexto nuevo vuelve a encender
// el aleatorio del dispositivo, así que el aleatorio se fija DESPUÉS de que empiece a sonar.
const alea = ARGS.inicio ? false : ARGS.aleatorio;
let opts = {};
// Las playlists suenan en el orden con el que Alberto las ve en el cliente (p. ej. «Añadido recientemente»): Spotify
// lo guarda por playlist en localStorage («<usuario>:sortedState») y la interfaz lo pasa como playlistQueryOptions.sort.
let ctx = {uri: item.uri};
if (item.tipo === "playlist") {
  const sort = playlistSort(item.uri);
  if (sort) ctx.playlistQueryOptions = {offset: 0, limit: 25, filter: "", sort: sort, filterPredicates: [],
                                        descriptorFilter: [], trackExtensions: [222], extendedPlaceholderTypes: []};
  if (ARGS.inicio) {
    try { const c = await P.PlaylistAPI.getContents(item.uri, sort ? {limit: 1, sort: sort} : {limit: 1});
          const f = c.items && c.items[0];
          if (f) opts = {skipTo: {uri: f.uri, uid: f.uid, index: 0}}; } catch (e) {}
  }
} else if (ARGS.inicio) opts = {skipTo: {index: 0}};
await P.PlayerAPI.play(ctx, {featureIdentifier: "playlist"}, opts);
for (let i = 0; i < 16; i++) { await sleep(500); const st = P.PlayerAPI.getState(); if (st.item && !st.isPaused && st.context && st.context.uri === item.uri) break; }
if (alea !== null) { try { await P.PlayerAPI.setShuffle(alea); } catch (e) {} await sleep(600); }
return {ok: true, puesto: item, ahora: now()};
"""
    alea = None if a.aleatorio is None else a.aleatorio
    return run_js(body, {"q": a.texto, "tipo": a.tipo, "donde": a.donde, "tele": a.tele, "aleatorio": alea,
                         "inicio": a.desde_inicio, "orden": a.orden})


def cmd_encontrar(a) -> dict:
    """Resuelve el texto como lo haría `poner`, pero sin reproducir (para confirmar antes)."""
    r = run_js("const it = await resolve(ARGS.q, ARGS.tipo); return it;", {"q": a.texto, "tipo": a.tipo})
    if not r:
        return {"ok": False, "error": f"no encuentro «{a.texto}» en Spotify"}
    if r.get("dudas"):
        return {"ok": False, "error": f"no tengo ninguna playlist que se llame «{a.texto}»", "candidatos": r["dudas"]}
    return {"ok": True, "encontrado": r}


def cmd_ultimo(a) -> dict:
    """Último lanzamiento de un artista (álbum, o cualquier cosa con --clase cualquiera), sin reproducirlo."""
    body = r"""
const arts = await search(ARGS.q, "artista");
if (!arts.length) return {ok: false, error: `no encuentro al artista «${ARGS.q}»`};
const art = arts.find(x => norm(x.nombre) === norm(ARGS.q)) || arts[0];
const r = await G.Request(G.Definitions.queryArtistOverview, {uri: art.uri, locale: "", includePrerelease: false});
const d = r.data && r.data.artistUnion && r.data.artistUnion.discography;
if (!d) return {ok: false, error: `Spotify no me da la discografía de ${art.nombre}`};
const rel = g => ((g && g.items) || []).map(i => i.releases && i.releases.items && i.releases.items[0]).filter(Boolean);
const fecha = x => { const t = x.date || {}; return (t.year || 0) * 10000 + (t.month || 0) * 100 + (t.day || 0); };
let pool = ARGS.clase === "album" ? rel(d.albums) : [d.latest, ...rel(d.albums), ...rel(d.singles)].filter(Boolean);
if (!pool.length && ARGS.clase === "album") pool = [d.latest, ...rel(d.singles)].filter(Boolean);
if (!pool.length) return {ok: false, error: `${art.nombre} no tiene lanzamientos en Spotify`};
pool.sort((x, y) => fecha(y) - fecha(x));
const x = pool[0], t = x.date || {};
return {ok: true, encontrado: {nombre: x.name, uri: x.uri, tipo: "album", de: art.nombre,
        clase: ({ALBUM: "álbum", SINGLE: "single", EP: "EP", COMPILATION: "recopilatorio"})[x.type] || "álbum",
        anio: t.year || null, mes: t.month || null, dia: (t.precision === "DAY" && t.day) || null,
        canciones: (x.tracks && x.tracks.totalCount) || null}};
"""
    return run_js(body, {"q": a.texto, "clase": a.clase})


def cmd_pasar(a) -> dict:
    body = r"""
const dev = ARGS.donde === "pc" ? localDev() : findTele(ARGS.tele);

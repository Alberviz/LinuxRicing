def norm_py(s: str) -> str:
    if not s:
        return ""
    s = unicodedata.normalize("NFD", s.lower())
    s = "".join(c for c in s if unicodedata.category(c) != "Mn")
    return "".join(c for c in s if c.isalnum())


def limpiar_titulo_youtube(title: str, artist: str = "") -> str:
    """Limpia sufijos típicos de YouTube (Video Oficial, HD, Letra, etc.) para mejorar la búsqueda en Spotify."""
    t = re.sub(r"(?i)\s*[\(\[]\s*(?:ft\.?|feat\.?)\s+[^\)\]]+[\)\]]", "", title)
    t = re.sub(r"(?i)\s*(?:ft\.?|feat\.?)\s+[^\-\(\]]+", "", t)
    t = re.sub(
        r"(?i)\s*[\(\[](?:official\s*(?:music\s*)?video|video\s*oficial|audio\s*oficial|official\s*audio|visualizer|letra|lyrics|videoclip|hd|4k|remastered|lyric\s*video|en\s*vivo|live(?:[^\)\]]*)?)[\)\]]",
        "",
        t,
    )
    t = re.sub(r"\s*[\(\[]\s*[\)\]]", "", t)
    t = re.sub(r"\s*[\(\[]\s*$", "", t)
    t = t.strip()

    if artist:
        artist = re.sub(r"(?i)\s*-\s*topic", "", artist).strip()

    if " - " in t:
        parts = t.split(" - ", 1)
        if not artist or artist.lower() in parts[0].lower():
            artist = parts[0].strip()
            t = parts[1].strip()
    return f"{artist} {t}".strip() if artist else t.strip()


def extraer_playlist_youtube(url_o_id: str) -> dict:
    """Extrae las canciones de una playlist de YouTube con yt-dlp."""
    ytdlp = shutil.which("yt-dlp") or str(Path.home() / ".local/bin/yt-dlp")
    if not shutil.which(ytdlp) and not Path(ytdlp).exists():
        return {"ok": False, "error": "yt-dlp no está instalado en el sistema"}
    try:
        r = subprocess.run([ytdlp, "--flat-playlist", "-J", "--no-warnings", url_o_id],
                           capture_output=True, text=True, timeout=60)
        if r.returncode != 0:
            return {"ok": False, "error": f"yt-dlp falló: {r.stderr[:200]}"}
        data = json.loads(r.stdout)
        entries = data.get("entries") or []
        temas = []
        for e in entries:
            tit = e.get("title") or ""
            art = e.get("uploader") or e.get("channel") or ""
            if tit:
                busqueda = limpiar_titulo_youtube(tit, art)
                temas.append({"titulo_yt": tit, "artista_yt": art, "busqueda": busqueda, "duracion": e.get("duration")})
        return {"ok": True, "titulo": data.get("title") or "Playlist YouTube", "temas": temas}
    except Exception as e:
        return {"ok": False, "error": str(e)}


def _sync_youtube_a_spotify(playlist_spotify: str, url_youtube: str, crear: bool = True) -> dict:
    yt = extraer_playlist_youtube(url_youtube)
    if not yt.get("ok"):
        return yt

    temas_yt = yt.get("temas") or []
    if not temas_yt:
        return {"ok": True, "playlist": playlist_spotify, "anadidas": 0, "mensaje": "la playlist de YouTube está vacía"}

    cfg_exclusiones = []
    cfg_path = Path.home() / "proyectos/LinuxRicing/assistant/config.toml"
    if cfg_path.exists():
        try:
            import tomllib
            c_toml = tomllib.loads(cfg_path.read_text(encoding="utf-8"))
            cfg_exclusiones = (c_toml.get("spotify") or {}).get("sync_youtube_excluir", {}).get(playlist_spotify) or []
        except Exception:
            pass
    excluir_norm = [norm_py(x) for x in cfg_exclusiones if x]

    def es_excluido(texto: str) -> bool:
        if not excluir_norm or not texto:
            return False
        t_n = norm_py(texto)
        return any(ex in t_n for ex in excluir_norm)

    def es_coincidencia_valida(c_nom: str, c_art: str, t_orig: dict) -> bool:
        nom_n = norm_py(c_nom)
        art_n = norm_py(c_art)
        yt_tit_n = norm_py(t_orig.get("titulo_yt", ""))
        yt_art_n = norm_py(t_orig.get("artista_yt", ""))
        yt_bus_n = norm_py(t_orig.get("busqueda", ""))
        if nom_n and (nom_n in yt_tit_n or nom_n in yt_bus_n or yt_tit_n in nom_n):
            return True
        if art_n and yt_art_n and (art_n in yt_art_n or yt_art_n in art_n):
            palabras_yt = [p for p in re.split(r"\W+", t_orig.get("titulo_yt", "").lower()) if len(p) >= 3]
            if any(norm_py(p) in nom_n for p in palabras_yt):
                return True
        return False

    body_prep = r"""
let pl = await resolve(ARGS.playlist, "playlist");
if (!pl && ARGS.crear) {
    const uri = await P.RootlistAPI.createPlaylist(ARGS.playlist, {});
    if (uri) pl = {nombre: ARGS.playlist, uri};
}
if (!pl) return {ok: false, error: `la playlist «${ARGS.playlist}» no existe y no se pasó --crear`};
const contents = await getPlaylistContents(pl.uri, 5000);
return {ok: true, uri: pl.uri, nombre: pl.nombre, existentes: contents};
"""
    prep = run_js(body_prep, {"playlist": playlist_spotify, "crear": crear})
    if not prep.get("ok"):
        return prep

    pl_uri = prep["uri"]
    existentes = prep.get("existentes") or []
    firmas_nombres = {norm_py(c["nombre"]) for c in existentes}
    firmas_completas = {norm_py(f"{c['artista']} {c['nombre']}") for c in existentes}
    uris_existentes = {c["uri"] for c in existentes}

    a_buscar = []
    ya_estaban = 0
    omitidas_exclusion = 0
    for t in temas_yt:
        b = t["busqueda"]
        if es_excluido(t["titulo_yt"]) or es_excluido(t["artista_yt"]) or es_excluido(b):
            omitidas_exclusion += 1
            continue
        if (norm_py(t["titulo_yt"]) in firmas_nombres or
            norm_py(b) in firmas_nombres or
            norm_py(f"{t['artista_yt']} {t['titulo_yt']}") in firmas_completas):
            ya_estaban += 1
            continue
        a_buscar.append(t)

    if not a_buscar:
        return {"ok": True, "playlist": playlist_spotify, "uri": pl_uri, "anadidas": 0,
                "ya_estaban": ya_estaban, "omitidas_exclusion": omitidas_exclusion, "total_yt": len(temas_yt),
                "mensaje": "todas las canciones ya estaban en la playlist o fueron excluidas"}

    body_res = r"""
const res = [];
for (const q of ARGS.queries) {
    const hits = await search(q, "cancion");
    if (hits.length) res.push({query: q, cancion: hits[0]});
    else res.push({query: q, cancion: null});
    await sleep(60);
}
return res;
"""
    uris_nuevas = []
    anadidas_info = []
    no_encontradas = []

    for i in range(0, len(a_buscar), 25):
        chunk = a_buscar[i:i + 25]
        res_chunk = run_js(body_res, {"queries": [t["busqueda"] for t in chunk]}) or []
        for item, t_orig in zip(res_chunk, chunk):
            c = item.get("cancion")
            if c and c.get("uri"):
                c_nom = norm_py(c["nombre"])
                c_art = norm_py(c.get("de") or c.get("artista") or "")
                if es_excluido(c["nombre"]) or es_excluido(c.get("de") or ""):
                    omitidas_exclusion += 1
                    continue
                if not es_coincidencia_valida(c["nombre"], c.get("de") or "", t_orig):
                    no_encontradas.append(f"{t_orig['busqueda']} (rechazado por baja coincidencia)")
                    continue
                if c["uri"] not in uris_existentes and c_nom not in firmas_nombres:
                    uris_existentes.add(c["uri"])
                    firmas_nombres.add(c_nom)
                    uris_nuevas.append(c["uri"])
                    anadidas_info.append(c)
                else:
                    ya_estaban += 1
            else:
                no_encontradas.append(t_orig.get("busqueda"))

    if uris_nuevas:
        for i in range(0, len(uris_nuevas), 50):
            bloque = uris_nuevas[i:i + 50]
            run_js(r"await P.PlaylistAPI.add(ARGS.uri, ARGS.tracks, {});", {"uri": pl_uri, "tracks": bloque})
            time.sleep(0.3)

    return {
        "ok": True,
        "playlist": playlist_spotify,
        "uri": pl_uri,
        "anadidas": len(uris_nuevas),
        "ya_estaban": ya_estaban,
        "omitidas_exclusion": omitidas_exclusion,
        "no_encontradas": no_encontradas[:10],
        "total_no_encontradas": len(no_encontradas),
        "canciones_anadidas": anadidas_info[:15],
    }


def _sync_todo_config(si_abierto: bool = False) -> dict:
    if si_abierto and not _page():
        return {"ok": True, "omitido": True, "motivo": "Spotify no está abierto"}
    cfg_sync = {}
    cfg_path = Path.home() / "proyectos/LinuxRicing/assistant/config.toml"
    if cfg_path.exists():
        try:
            import tomllib
            c = tomllib.loads(cfg_path.read_text(encoding="utf-8"))
            cfg_sync = (c.get("spotify") or {}).get("sync_youtube") or {}
        except Exception:
            pass
    if not cfg_sync:
        return {"ok": True, "sincronizadas": 0, "mensaje": "no hay playlists configuradas en [spotify.sync_youtube]"}

    resumen = []
    for pl_spotify, yt_url in cfg_sync.items():
        r = _sync_youtube_a_spotify(pl_spotify, yt_url, crear=True)
        resumen.append({"playlist": pl_spotify, "resultado": r})

    return {"ok": True, "total": len(resumen), "playlists": resumen}



                           help="no crear la playlist si no existe")

    p_pl_all = sub_pl.add_parser("sync-todo", help="sincronizar todas las listas de [spotify.sync_youtube]")
    p_pl_all.add_argument("--si-abierto", action="store_true", help="no arrancar Spotify si está cerrado")

    # Subcomando cola
    p_cola = sub.add_parser("cola", help="colas de reproducción temporales (sin guardar en biblioteca)")
    sub_cola = p_cola.add_subparsers(dest="subcmd", required=True)

    p_cola_nueva = sub_cola.add_parser("nueva", help="limpiar cola, poner primera canción y encolar el resto")
    p_cola_nueva.add_argument("canciones", nargs="+", help="canciones a reproducir y encolar en orden")
    p_cola_nueva.add_argument("--donde", choices=["tele", "pc", "actual"], default="actual")
    p_cola_nueva.add_argument("--tele", default=TELE_DEFAULT)

    p_cola_anadir = sub_cola.add_parser("anadir", help="añadir canciones al final de la cola actual")
    p_cola_anadir.add_argument("canciones", nargs="+", help="canciones a encolar")

    p_cola_desp = sub_cola.add_parser("despues", help="poner canciones a continuación de la que suena")
    p_cola_desp.add_argument("canciones", nargs="+", help="canciones a poner a continuación")

    sub_cola.add_parser("limpiar", help="vaciar la cola temporal de reproducción")
    sub_cola.add_parser("ver", help="ver la cola actual")

    a = ap.parse_args()
    try:
        dispatch = {
            "buscar": cmd_buscar, "poner": cmd_poner, "encontrar": cmd_encontrar,
            "ultimo": cmd_ultimo, "control": cmd_control, "pasar": cmd_pasar,
            "estado": cmd_estado, "dispositivos": cmd_dispositivos,
            "playlist": cmd_playlist, "cola": cmd_cola
        }
        r = dispatch[a.cmd](a)
    except Exception as e:  # noqa: BLE001
        r = {"ok": False, "error": str(e)[:300]}
    print(json.dumps(r, ensure_ascii=False))
    return 0 if r.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main())

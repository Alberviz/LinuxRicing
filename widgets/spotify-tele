if (!toRemove.length) return {ok: false, error: "no se encontraron las canciones especificadas dentro de la playlist"};
await P.PlaylistAPI.remove(pl.uri, toRemove.map(x => ({uri: x.uri, uid: x.uid || ""})));
await sleep(300);
return {ok: true, playlist: pl.nombre, uri: pl.uri, quitadas: toRemove.length, canciones: toRemove};

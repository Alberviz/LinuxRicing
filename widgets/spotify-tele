def cmd_control(a) -> dict:
    body = r"""
const S = Spicetify.Player, v = ARGS.valor;
const num = () => { const n = parseFloat(v); if (isNaN(n)) throw new Error(`«${ARGS.accion}» necesita un número`); return n; };
const onoff = () => !/^(no|off|false|0|quita|desactiva)/i.test(String(v ?? "si"));
switch (ARGS.accion) {
  case "pausar": await P.PlayerAPI.pause(); break;
  case "reanudar": await P.PlayerAPI.resume(); break;
  case "alternar": S.togglePlay(); break;
  case "siguiente": await P.PlayerAPI.skipToNext(); break;
  case "anterior": await P.PlayerAPI.skipToPrevious(); break;
  case "reiniciar": await P.PlayerAPI.seekTo(0); break;
  case "aleatorio": await P.PlayerAPI.setShuffle(onoff()); break;
  case "repetir": {
    const m = String(v ?? "lista").toLowerCase();
    await P.PlayerAPI.setRepeat(/^(no|off|quita|desactiva|0)/.test(m) ? 0 : /(cancion|canción|tema|track|una|2)/.test(m) ? 2 : 1); break;
  }
  // Volumen del dispositivo ACTIVO (PC o tele). Spicetify.Player.setVolume solo tocaba el del cliente local,
  // así que con la música en el Chromecast «súbele» no hacía nada.
  case "volumen": await setVol(Math.max(0, Math.min(100, num())) / 100); break;
  case "subir": await setVol(Math.min(1, volAct() + (v ? num() : 10) / 100)); break;
  case "bajar": await setVol(Math.max(0, volAct() - (v ? num() : 10) / 100)); break;
  case "ir_a": await P.PlayerAPI.seekTo(Math.max(0, num()) * 1000); break;
  case "adelantar": await P.PlayerAPI.seekTo(S.getProgress() + (v ? num() : 15) * 1000); break;
  case "atrasar": await P.PlayerAPI.seekTo(Math.max(0, S.getProgress() - (v ? num() : 15) * 1000)); break;
  case "me_gusta": S.setHeart(true); break;
  case "no_me_gusta": S.setHeart(false); break;
  case "cola": case "despues": {
    if (!v) throw new Error("¿qué canción añado?");
    const item = await resolve(String(v), "cancion");
    if (!item) return {ok: false, error: `no encuentro «${v}» en Spotify`};
    if (ARGS.accion === "despues") await P.PlayerAPI.playAsNextInQueue ? P.PlayerAPI.playAsNextInQueue([{uri: item.uri}]) : P.PlayerAPI.addToQueue([{uri: item.uri}]);
    else await P.PlayerAPI.addToQueue([{uri: item.uri}]);
    await sleep(300);
    return {ok: true, encolado: item, ahora: now()};
  }
  case "temporizador": {
    const min = num();
    await P.PlayerAPI.setSleepTimer(min > 0 ? {type: "duration", durationMs: min * 60000} : null);
    break;
  }
  default: return {ok: false, error: `acción desconocida: ${ARGS.accion}`};
}
await sleep(900);
return {ok: true, ahora: now()};
"""
    return run_js(body, {"accion": a.accion, "valor": a.valor})



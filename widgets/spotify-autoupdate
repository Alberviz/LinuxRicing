#!/usr/bin/env bash
# ==============================================================================
# spotify-autoupdate: Comprueba y actualiza Spotify y Spicetify en arranque AC
# ==============================================================================
set -euo pipefail

export HOME="${HOME:-/home/$(id -un)}"
export PATH="$HOME/.spicetify:$HOME/.local/bin:/usr/local/bin:/usr/bin:$PATH"

FORCE=false
CHECK_ONLY=false
FORCE_REAPPLY=false
LOG_TAG="spotify-autoupdate"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [$LOG_TAG] $*"
}

notify() {
    local urgency="${1:-normal}"
    local title="$2"
    local msg="$3"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u "$urgency" -i spotify "$title" "$msg" 2>/dev/null || true
    fi
}

is_on_ac() {
    # Si no existe batería (BAT*), es un equipo de sobremesa -> siempre en AC
    if ! compgen -G "/sys/class/power_supply/BAT*" > /dev/null; then
        return 0
    fi
    # Comprobar si algún cargador (Mains / AC / USB) está online (1)
    for supply in /sys/class/power_supply/*; do
        if [ -f "$supply/type" ] && [ -f "$supply/online" ]; then
            type=$(cat "$supply/type")
            online=$(cat "$supply/online")
            if [ "$type" != "Battery" ] && [ "$online" -eq 1 ]; then
                return 0
            fi
        fi
    done
    return 1
}

wait_for_network() {
    log "Esperando conexión a Internet..."
    local attempts=15
    while [ $attempts -gt 0 ]; do
        if ping -c 1 -W 2 1.1.1.1 >/dev/null 2>&1 || curl -s --head --connect-timeout 2 https://aur.archlinux.org >/dev/null 2>&1; then
            log "Conexión a Internet confirmada."
            return 0
        fi
        sleep 2
        ((attempts--))
    done
    log "Aviso: No se detectó conexión tras el tiempo de espera."
    return 1
}

wait_for_pacman_lock() {
    local attempts=20
    while [ -f /var/lib/pacman/db.lck ] && [ $attempts -gt 0 ]; do
        log "Esperando liberación de /var/lib/pacman/db.lck..."
        sleep 2
        ((attempts--))
    done
    if [ -f /var/lib/pacman/db.lck ]; then
        log "Error: pacman está bloqueado por otro proceso."
        return 1
    fi
    return 0
}

apply_spicetify() {
    log "Aplicando configuración de Spicetify..."
    # 1. Intentar backup apply directamente (reinicia Spotify automáticamente si estaba abierto)
    if spicetify backup apply 2>&1; then
        log "Spicetify backup apply completado con éxito."
        return 0
    fi

    # 2. Si falla (p.ej. versión cambiada o archivos modificados), intentar restore backup apply
    log "backup apply falló; intentando restore backup apply..."
    if spicetify restore backup apply 2>&1; then
        log "Spicetify restore backup apply completado con éxito."
        return 0
    fi

    # 3. Fallback: limpiar backup desactualizado y forzar nuevo backup apply
    log "restore backup apply falló; limpiando backup previo..."
    spicetify clear 2>/dev/null || true
    if spicetify backup apply 2>&1; then
        log "Spicetify backup apply tras clear completado con éxito."
        return 0
    fi

    log "Error crítico aplicando Spicetify."
    return 1
}

show_help() {
    cat << EOF
Uso: $(basename "$0") [OPCIONES]

Comprueba y actualiza Spotify y Spicetify en el inicio del sistema.

Opciones:
  -f, --force       Forzar ejecución incluso con batería (ignora comprobación AC).
  --check-only      Solo comprueba si hay actualizaciones pendientes, sin instalar.
  --reapply         Fuerza la reaplicación de Spicetify aunque no haya actualizaciones.
  -h, --help        Muestra esta ayuda.
EOF
}

# Parsear argumentos
while [[ $# -gt 0 ]]; do
    case "$1" in
        -f|--force)
            FORCE=true
            shift
            ;;
        --check-only)
            CHECK_ONLY=true
            shift
            ;;
        --reapply)
            FORCE_REAPPLY=true
            shift
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        *)
            echo "Opción no reconocida: $1" >&2
            show_help
            exit 1
            ;;
    esac
done

# 1. Comprobación de Corriente Alterna (AC)
if [ "$FORCE" = false ] && ! is_on_ac; then
    log "El ordenador está usando batería. Cancelando comprobación para ahorrar energía."
    exit 0
fi

# 2. Esperar red y bloqueo de pacman
wait_for_network || exit 0
wait_for_pacman_lock || exit 1

# 3. Comprobar si Spotify necesita actualizarse
log "Comprobando actualizaciones de Spotify en AUR..."
SPOTIFY_UPDATE=""
if yay -Qu spotify 2>/dev/null | grep -E '^spotify\s' >/dev/null; then
    SPOTIFY_UPDATE=$(yay -Qu spotify 2>/dev/null | grep -E '^spotify\s')
fi

if [ "$CHECK_ONLY" = true ]; then
    if [ -n "$SPOTIFY_UPDATE" ]; then
        echo "Spotify requiere actualización: $SPOTIFY_UPDATE"
    else
        echo "Spotify está al día."
    fi
    OLD_SPICETIFY_VER=$(spicetify --version 2>/dev/null || echo "desconocido")
    echo "Spicetify versión instalada: $OLD_SPICETIFY_VER"
    exit 0
fi

# 4. Flujo condicional
if [ -n "$SPOTIFY_UPDATE" ]; then
    log "Actualización detectada para Spotify: $SPOTIFY_UPDATE"
    notify "normal" "Spotify Updater" "Actualizando Spotify ($SPOTIFY_UPDATE)..."

    # Actualizar paquete AUR de Spotify
    log "Ejecutando yay para actualizar spotify..."
    if ! yay -S --noconfirm --diffmenu=false --editmenu=false --cleanmenu=false \
            --answerdiff=None --answeredit=None --answerclean=None spotify; then
        log "Error al actualizar spotify mediante yay."
        notify "critical" "Spotify Updater" "Error al actualizar el paquete Spotify."
        exit 1
    fi

    # Otorgar permisos de escritura para Spicetify
    if [ -d /opt/spotify ]; then
        log "Restableciendo permisos de /opt/spotify para Spicetify..."
        sudo chmod a+wr /opt/spotify
        sudo chmod -R a+wr /opt/spotify/Apps
    fi

    # Actualizar Spicetify CLI si hay nueva versión
    log "Comprobando actualización de Spicetify CLI..."
    spicetify update || true

    # Reaplicar Spicetify sobre el nuevo Spotify
    if apply_spicetify; then
        notify "normal" "Spotify Updater" "Spotify y Spicetify se han actualizado y aplicado correctamente."
    else
        notify "critical" "Spotify Updater" "Error al aplicar Spicetify tras actualizar Spotify."
        exit 1
    fi

else
    log "Spotify está al día. Comprobando actualización de Spicetify..."
    OLD_SPICETIFY_VER=$(spicetify --version 2>/dev/null || echo "")

    # Ejecutar spicetify update
    UPDATE_OUTPUT=$(spicetify update 2>&1 || true)
    log "$UPDATE_OUTPUT"

    NEW_SPICETIFY_VER=$(spicetify --version 2>/dev/null || echo "")

    if [ "$NEW_SPICETIFY_VER" != "$OLD_SPICETIFY_VER" ] || echo "$UPDATE_OUTPUT" | grep -qi "updated"; then
        log "Spicetify se actualizó de $OLD_SPICETIFY_VER a $NEW_SPICETIFY_VER. Reaplicando..."
        notify "normal" "Spicetify Updater" "Spicetify se ha actualizado a $NEW_SPICETIFY_VER. Reaplicando tema..."
        if apply_spicetify; then
            notify "normal" "Spicetify Updater" "Spicetify actualizado y aplicado correctamente."
        else
            notify "critical" "Spicetify Updater" "Error al reaplicar Spicetify."
            exit 1
        fi
    elif [ "$FORCE_REAPPLY" = true ]; then
        log "Reaplicación forzada solicitada (--reapply)..."
        if apply_spicetify; then
            notify "normal" "Spicetify Updater" "Spicetify reaplicado correctamente."
        else
            notify "critical" "Spicetify Updater" "Error al reaplicar Spicetify."
            exit 1
        fi
    else
        log "Tanto Spotify como Spicetify están al día. Ninguna acción requerida."
        notify "low" "Spotify Updater" "Spotify y Spicetify están al día."
    fi
fi

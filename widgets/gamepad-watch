#!/usr/bin/env python3
"""gamepad-watch — vigila mandos sin dependencias (lee /dev/input/event* crudo).

Salida por stdout, una línea por evento:
  connected <nombre>      un mando nuevo aparece
  disconnected <nombre>   desaparece
  btn <a|b|x|y|start|select|home|up|down|left|right|lb|rb>
  hold home               Home mantenido >= 0.7 s (hablar con Laura); un toque corto da `btn home`

Requiere estar en el grupo `input`. No hace grab: el juego sigue recibiendo el mando.
"""
import fcntl, os, re, select, struct, sys, time

EV_KEY, EV_ABS = 1, 3
EVENT = struct.Struct("llHHi")
# Etiquetas por posición estilo Nintendo (abajo=B, derecha=A, arriba=X, izquierda=Y).
# Los mandos estilo Xbox intercambian: abajo=A, derecha=B, arriba=Y, izquierda=X.
NINTENDO = re.compile(r"(?i)nintendo|switch|pro controller|joy-con|gulikit|8bitdo")
XBOX_SWAP = {304: "a", 305: "b", 307: "y", 308: "x"}
KEYS = {304: "b", 305: "a", 307: "x", 308: "y", 310: "lb", 311: "rb", 314: "select", 315: "start",
        316: "home", 544: "up", 545: "down", 546: "left", 547: "right"}


def absinfo(fd, axis):
    buf = bytearray(24)
    req = (2 << 30) | (24 << 16) | (ord("E") << 8) | (0x40 + axis)
    try:
        fcntl.ioctl(fd, req, buf)
        _, lo, hi, *_ = struct.unpack("iiiiii", buf)
        return lo, hi
    except OSError:
        return -32768, 32767


def scan():
    """{event_path: name} de los dispositivos con handler jsN (mandos)."""
    out = {}
    try:
        blocks = open("/proc/bus/input/devices").read().split("\n\n")
    except OSError:
        return out
    for b in blocks:
        h = re.search(r"H: Handlers=(.*)", b)
        n = re.search(r'N: Name="(.*)"', b)
        if not h or not n or not re.search(r"\bjs\d+", h.group(1)):
            continue
        if re.search(r"(?i)imu|motion|touchpad", n.group(1)):
            continue
        ev = re.search(r"\b(event\d+)", h.group(1))
        if ev:
            out["/dev/input/" + ev.group(1)] = n.group(1)
    return out


def emit(s):
    sys.stdout.write(s + "\n")
    sys.stdout.flush()


def main():
    devs = {}  # path -> {fd, name, axes, dir}
    home_down = None  # instante en que se pulsó Home (None = suelto / ya disparado)
    first = True
    last_scan = 0
    while True:
        now = time.monotonic()
        if now - last_scan > 1.5:
            last_scan = now
            found = scan()
            for p in list(devs):
                if p not in found:
                    os.close(devs[p]["fd"])
                    emit("disconnected " + devs.pop(p)["name"])
            for p, name in found.items():
                if p in devs:
                    continue
                try:
                    fd = os.open(p, os.O_RDONLY | os.O_NONBLOCK)
                except OSError:
                    continue
                axes = {a: absinfo(fd, a) for a in (0, 1, 16, 17)}
                keys = dict(KEYS)
                if not NINTENDO.search(name):
                    keys.update(XBOX_SWAP)
                devs[p] = {"fd": fd, "name": name, "axes": axes, "dir": {}, "keys": keys}
                # Los que ya estaban al arrancar no disparan el aviso.
                emit(("present " if first else "connected ") + name)
            first = False
        fds = {d["fd"]: d for d in devs.values()}
        if home_down is not None and time.monotonic() - home_down >= 0.7:
            emit("hold home")
            home_down = None
        if fds:
            r = select.select(list(fds), [], [], 0.05 if home_down is not None else 1.0)[0]
        else:
            time.sleep(1.0)
            r = []
        for fd in r:
            d = fds[fd]
            try:
                data = os.read(fd, EVENT.size * 64)
            except OSError:
                continue
            for i in range(0, len(data) - EVENT.size + 1, EVENT.size):
                _, _, typ, code, val = EVENT.unpack_from(data, i)
                if typ == EV_KEY and code == 316:
                    if val == 1:
                        home_down = time.monotonic()
                    elif val == 0 and home_down is not None:
                        emit("btn home")
                        home_down = None
                elif typ == EV_KEY and val == 1 and code in d["keys"]:
                    emit("btn " + d["keys"][code])
                elif typ == EV_ABS and code in d["axes"]:
                    lo, hi = d["axes"][code]
                    mid, span = (lo + hi) / 2, max(1, (hi - lo) / 2)
                    v = (val - mid) / span
                    neg, pos = ("left", "right") if code in (0, 16) else ("up", "down")
                    cur = neg if v < -0.6 else pos if v > 0.6 else None
                    if cur and d["dir"].get(code) != cur:
                        emit("btn " + cur)
                    d["dir"][code] = cur


if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, BrokenPipeError):
        pass

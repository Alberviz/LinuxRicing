#!/usr/bin/env bash
# ==============================================================================
# caelestia-tablet-display — Monitor virtual y streaming para Honor MagicPad 2
# ==============================================================================

set -euo pipefail

MONITOR_NAME="Tablet"
RESOLUTION="3000x1920@144"
SCALE="1.6"
POSITION="auto-right"
SUNSHINE_SERVICE="app-dev.lizardbyte.app.Sunshine.service"

is_monitor_active() {
    hyprctl monitors -j 2>/dev/null | jq -e ".[] | select(.name == \"$MONITOR_NAME\")" >/dev/null 2>&1
}

is_sunshine_active() {
    systemctl --user is-active --quiet "$SUNSHINE_SERVICE" 2>/dev/null
}

start_monitor() {
    if ! is_monitor_active; then
        hyprctl output create headless "$MONITOR_NAME" >/dev/null 2>&1 || true
        # Aplicar resolución, tasa de refresco, escala y posición
        hyprctl eval "hl.monitor({ output = \"$MONITOR_NAME\", mode = \"$RESOLUTION\", position = \"$POSITION\", scale = $SCALE })" >/dev/null 2>&1 || true
    fi

    if ! is_sunshine_active; then
        systemctl --user start "$SUNSHINE_SERVICE" 2>/dev/null || true
    fi

    notify-send -a "Caelestia" -i tablet_android "Tablet Monitor" "Segundo monitor activado ($RESOLUTION, escala $SCALE)" 2>/dev/null || true
}

stop_monitor() {
    if is_monitor_active; then
        hyprctl output remove "$MONITOR_NAME" >/dev/null 2>&1 || true
    fi

    if is_sunshine_active; then
        systemctl --user stop "$SUNSHINE_SERVICE" 2>/dev/null || true
    fi

    notify-send -a "Caelestia" -i tablet_android "Tablet Monitor" "Segundo monitor desactivado" 2>/dev/null || true
}

ensure_monitor() {
    if ! is_monitor_active; then
        hyprctl output create headless "$MONITOR_NAME" >/dev/null 2>&1 || true
        hyprctl eval "hl.monitor({ output = \"$MONITOR_NAME\", mode = \"$RESOLUTION\", position = \"$POSITION\", scale = $SCALE })" >/dev/null 2>&1 || true
    fi
}

toggle_monitor() {
    if is_monitor_active; then
        stop_monitor
    else
        start_monitor
    fi
}

status_monitor() {
    if is_monitor_active; then
        echo "active"
        exit 0
    else
        echo "inactive"
        exit 1
    fi
}

pair_pin() {
    local pin="${1:-}"
    if [[ -z "$pin" ]]; then
        echo "Uso: caelestia-tablet-display pair <PIN-de-4-dígitos>" >&2
        exit 1
    fi

    local pairing_json
    pairing_json=$(curl -k -s -u alberto:alberto https://localhost:47990/api/pin || true)
    local pairing_id
    pairing_id=$(echo "$pairing_json" | jq -r '.pairings[0].id // empty')

    if [[ -z "$pairing_id" ]]; then
        echo "No hay ninguna solicitud de emparejamiento pendiente en Sunshine." >&2
        echo "Toca sobre el equipo en Moonlight en la tablet para que genere un PIN." >&2
        exit 1
    fi

    local payload
    payload=$(jq -n --arg id "$pairing_id" --arg pin "$pin" --arg name "Honor MagicPad 2" \
        '{pairing_id: $id, pin: $pin, name: $name}')

    local res
    res=$(curl -k -s -u alberto:alberto -X POST \
        -H "Content-Type: application/json" \
        -d "$payload" \
        https://localhost:47990/api/pin)

    local status
    status=$(echo "$res" | jq -r '.status // false')

    if [[ "$status" == "true" ]]; then
        echo "¡Emparejado con éxito con Honor MagicPad 2!"
        notify-send -a "Caelestia" -i tablet_android "Tablet Emparejada" "Honor MagicPad 2 conectada correctamente" 2>/dev/null || true
    else
        echo "Error al emparejar. Comprueba que el PIN de 4 dígitos sea el correcto." >&2
        echo "Respuesta del servidor: $res" >&2
        exit 1
    fi
}

case "${1:-toggle}" in
    on|start)
        start_monitor
        ;;
    off|stop)
        stop_monitor
        ;;
    ensure)
        ensure_monitor
        ;;
    toggle)
        toggle_monitor
        ;;
    status)
        status_monitor
        ;;
    pair)
        shift
        pair_pin "$@"
        ;;
    *)
        echo "Uso: $0 {on|off|toggle|status|ensure|pair <PIN>}" >&2
        exit 1
        ;;
esac

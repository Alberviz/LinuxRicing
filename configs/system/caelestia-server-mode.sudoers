# Regla de privilegio del "modo servidor" de Caelestia.
# install.sh la copia a /etc/sudoers.d/caelestia-server-mode (modo 0440) tras
# validarla con `visudo -c`. Autoriza sin contrasena SOLO el helper de cuatro
# verbos fijos (console / desktop / issue-on / issue-off); ninguna otra cosa.
alberviz ALL=(root) NOPASSWD: /usr/local/bin/caelestia-server-mode-root

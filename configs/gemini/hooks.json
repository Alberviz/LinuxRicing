{
  "caelestia-agent-notify": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "\"$HOME/.local/bin/agent-notify\" hook prompt",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "\"$HOME/.local/bin/agent-notify\" hook stop",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "\"$HOME/.local/bin/agent-subagent\" hook",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "\"$HOME/.local/bin/agent-subagent\" hook",
        "timeout": 5
      }
    ]
  }
}
